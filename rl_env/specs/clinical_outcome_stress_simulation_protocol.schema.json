{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jang1563/agentic-drug-discovery-system/rl_env/specs/clinical_outcome_stress_simulation_protocol.schema.json",
  "title": "Clinical Outcome Stress Simulation Protocol",
  "description": "Public prospective protocol for deterministic outcome-dependent evaluability and residual cross-nominal-cluster dependence stress analysis.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "integrity_sha256", "protocol"],
  "properties": {
    "schema_version": {
      "const": "adds.clinical-outcome-stress-simulation-protocol.v1"
    },
    "integrity_sha256": {"$ref": "#/$defs/sha256"},
    "protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol_id",
        "version",
        "registered_on",
        "confidence_level",
        "monte_carlo_confidence_level",
        "replicates",
        "random_seed",
        "coverage_tolerance",
        "minimum_interval_yield",
        "analysis_modes",
        "estimand_targets",
        "gates",
        "scenarios",
        "simulation_method_id",
        "rng_method_id",
        "uncertainty_method_id",
        "metadata"
      ],
      "properties": {
        "protocol_id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "registered_on": {"type": "string", "format": "date"},
        "confidence_level": {
          "type": "number",
          "exclusiveMinimum": 0.5,
          "exclusiveMaximum": 1.0
        },
        "monte_carlo_confidence_level": {
          "type": "number",
          "exclusiveMinimum": 0.5,
          "exclusiveMaximum": 1.0
        },
        "replicates": {
          "type": "integer",
          "minimum": 100,
          "maximum": 100000
        },
        "random_seed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "coverage_tolerance": {
          "type": "number",
          "minimum": 0.0,
          "exclusiveMaximum": 1.0
        },
        "minimum_interval_yield": {
          "type": "number",
          "exclusiveMinimum": 0.0,
          "maximum": 1.0
        },
        "analysis_modes": {"$ref": "#/$defs/analysisModes"},
        "estimand_targets": {"$ref": "#/$defs/estimandTargets"},
        "gates": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {"$ref": "#/$defs/gate"}
        },
        "scenarios": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "items": {"$ref": "#/$defs/scenario"}
        },
        "simulation_method_id": {
          "const": "adds.prospective-clinical-outcome-stress.informative-evaluability-dependence.v1"
        },
        "rng_method_id": {
          "const": "adds.mt19937-block-polya-urn-informative-evaluability.v1"
        },
        "uncertainty_method_id": {
          "const": "adds.cluster-robust-clinical-outcome-uncertainty.cr1.v1"
        },
        "metadata": {"type": "object"}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "stage": {
      "enum": [
        "disease_context",
        "target_nomination",
        "modality_selection",
        "candidate_generation",
        "lead_optimization",
        "preclinical_validation",
        "clinical_strategy",
        "regulatory_postmarket"
      ]
    },
    "analysisModes": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "prefixItems": [
        {"const": "nominal_clusters"},
        {"const": "dependence_closed_clusters"}
      ],
      "items": false
    },
    "estimandTargets": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "prefixItems": [
        {"const": "population"},
        {"const": "evaluable"}
      ],
      "items": false
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gate_id",
        "minimum_evaluable_clusters",
        "maximum_evaluable_cluster_fraction"
      ],
      "properties": {
        "gate_id": {"type": "string", "minLength": 1},
        "minimum_evaluable_clusters": {"type": "integer", "minimum": 2},
        "maximum_evaluable_cluster_fraction": {
          "type": "number",
          "exclusiveMinimum": 0.0,
          "exclusiveMaximum": 1.0
        }
      }
    },
    "probabilityPattern": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {"type": "number", "minimum": 0.0, "maximum": 1.0}
    },
    "dependenceBlock": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100000,
      "uniqueItems": true,
      "items": {"type": "integer", "minimum": 0, "maximum": 99999}
    },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scenario_id",
        "stage",
        "endpoint_family",
        "nominal_cluster_sizes",
        "dependence_blocks",
        "favorable_prevalence",
        "dependence_block_intraclass_correlation",
        "favorable_evaluable_probability",
        "unfavorable_evaluable_probability",
        "classification_threshold",
        "policy_a_probability_pattern",
        "policy_b_probability_pattern"
      ],
      "properties": {
        "scenario_id": {"type": "string", "minLength": 1},
        "stage": {"$ref": "#/$defs/stage"},
        "endpoint_family": {"type": "string", "minLength": 1},
        "nominal_cluster_sizes": {
          "type": "array",
          "minItems": 2,
          "maxItems": 100000,
          "items": {"type": "integer", "minimum": 1, "maximum": 100000}
        },
        "dependence_blocks": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100000,
          "items": {"$ref": "#/$defs/dependenceBlock"}
        },
        "favorable_prevalence": {
          "type": "number",
          "exclusiveMinimum": 0.0,
          "exclusiveMaximum": 1.0
        },
        "dependence_block_intraclass_correlation": {
          "type": "number",
          "minimum": 0.0,
          "exclusiveMaximum": 1.0
        },
        "favorable_evaluable_probability": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "unfavorable_evaluable_probability": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "classification_threshold": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "policy_a_probability_pattern": {"$ref": "#/$defs/probabilityPattern"},
        "policy_b_probability_pattern": {"$ref": "#/$defs/probabilityPattern"}
      }
    }
  }
}

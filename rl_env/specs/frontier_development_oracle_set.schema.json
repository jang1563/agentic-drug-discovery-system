{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schemas/frontier_development_oracle_set.schema.json",
  "title": "ADDS-Frontier Development Oracle Set",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "protocol_id",
    "set_id",
    "set_role",
    "benchmark_evidence_claimed",
    "task_set_integrity_sha256",
    "oracles",
    "integrity_sha256"
  ],
  "properties": {
    "schema_version": {"const": "adds.frontier-oracle-set.v1"},
    "protocol_id": {"const": "adds-frontier-v1"},
    "set_id": {"const": "adds-frontier-development-tranche-v1"},
    "set_role": {"const": "public_development_oracle"},
    "benchmark_evidence_claimed": {"const": false},
    "task_set_integrity_sha256": {"$ref": "#/$defs/sha256"},
    "oracles": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {"$ref": "#/$defs/oracle"}
    },
    "integrity_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["disposition", "next_action", "risk_flags"],
      "properties": {
        "disposition": {"enum": ["advance", "hold", "terminate"]},
        "next_action": {"enum": ["retrieve", "verify", "experiment", "human_review", "none"]},
        "risk_flags": {
          "type": "array",
          "uniqueItems": true,
          "items": {"enum": ["safety", "contradiction", "provenance", "out_of_distribution", "temporal_leakage"]}
        }
      }
    },
    "stageExpectation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stage_id", "action", "witness_evidence_ids", "blocker_codes"],
      "properties": {
        "stage_id": {"type": "string", "pattern": "^s[0-9]{2}$"},
        "action": {"$ref": "#/$defs/action"},
        "witness_evidence_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/text"}
        },
        "blocker_codes": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z0-9_]+$"}
        }
      }
    },
    "mutationExpectation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mutation_id", "mutation_class", "operation", "expected_changed_components"],
      "properties": {
        "mutation_id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
        "mutation_class": {"enum": ["critical_flip", "nuisance_invariance", "evidence_ladder"]},
        "operation": {"$ref": "#/$defs/text"},
        "expected_changed_components": {
          "type": "array",
          "uniqueItems": true,
          "items": {"enum": ["disposition", "next_action", "risk_flags", "witness", "blockers"]}
        }
      }
    },
    "oracle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task_id", "task_sha256", "stage_expectations", "mutation_expectations", "nonclaim"],
      "properties": {
        "task_id": {"type": "string", "pattern": "^frontier-dev-[a-z0-9-]+-[0-9]{3}$"},
        "task_sha256": {"$ref": "#/$defs/sha256"},
        "stage_expectations": {
          "type": "array",
          "minItems": 6,
          "maxItems": 12,
          "items": {"$ref": "#/$defs/stageExpectation"}
        },
        "mutation_expectations": {
          "type": "array",
          "minItems": 5,
          "items": {"$ref": "#/$defs/mutationExpectation"}
        },
        "nonclaim": {
          "const": "This public development oracle is a contract fixture, not a hidden benchmark label."
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jang1563/agentic-drug-discovery-system/rl_env/specs/clinical_outcome_pattern_mixture_summary.schema.json",
  "title": "Clinical Outcome Pattern-Mixture Summary",
  "description": "Compact human- and machine-readable projection of pattern-mixture recovery and identification diagnostics.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "protocol_id",
    "protocol_fingerprint",
    "report_fingerprint",
    "stress_protocol_id",
    "stress_protocol_fingerprint",
    "stress_report_fingerprint",
    "method_id",
    "replicates",
    "log_imor_grid",
    "targets",
    "all_scenarios_research_targets_met",
    "scenarios",
    "claim_boundary"
  ],
  "properties": {
    "schema_version": {
      "const": "adds.clinical-outcome-pattern-mixture-summary.v1"
    },
    "protocol_id": {"type": "string", "minLength": 1},
    "protocol_fingerprint": {"$ref": "#/$defs/sha256"},
    "report_fingerprint": {"$ref": "#/$defs/sha256"},
    "stress_protocol_id": {"type": "string", "minLength": 1},
    "stress_protocol_fingerprint": {"$ref": "#/$defs/sha256"},
    "stress_report_fingerprint": {"$ref": "#/$defs/sha256"},
    "method_id": {
      "const": "adds.pattern-mixture.binary-log-imor-prediction-stratified.v1"
    },
    "replicates": {"type": "integer", "minimum": 1},
    "log_imor_grid": {
      "type": "array",
      "minItems": 3,
      "maxItems": 33,
      "uniqueItems": true,
      "items": {"type": "number", "minimum": -8.0, "maximum": 8.0}
    },
    "targets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minimum_analyzable_rate",
        "maximum_mean_identification_width",
        "maximum_absolute_bias"
      ],
      "properties": {
        "minimum_analyzable_rate": {
          "type": "number",
          "exclusiveMinimum": 0.0,
          "maximum": 1.0
        },
        "maximum_mean_identification_width": {
          "type": "number",
          "exclusiveMinimum": 0.0,
          "maximum": 2.0
        },
        "maximum_absolute_bias": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 2.0
        }
      }
    },
    "all_scenarios_research_targets_met": {"type": "boolean"},
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/scenario"}
    },
    "claim_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "aggregate_simulation_only",
        "real_clinical_outcomes_included",
        "automatic_missingness_correction_included",
        "sampling_uncertainty_intervals_included",
        "operational_estimate_uses_latent_truth"
      ],
      "properties": {
        "aggregate_simulation_only": {"const": true},
        "real_clinical_outcomes_included": {"const": false},
        "automatic_missingness_correction_included": {"const": false},
        "sampling_uncertainty_intervals_included": {"const": false},
        "operational_estimate_uses_latent_truth": {"const": false}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "nullableMetric": {
      "anyOf": [
        {"type": "number", "minimum": -2.0, "maximum": 2.0},
        {"type": "null"}
      ]
    },
    "summaryRate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event_count", "total_count", "rate", "lower", "upper"],
      "properties": {
        "event_count": {"type": "integer", "minimum": 0},
        "total_count": {"type": "integer", "minimum": 0},
        "rate": {
          "anyOf": [
            {"type": "number", "minimum": 0.0, "maximum": 1.0},
            {"type": "null"}
          ]
        },
        "lower": {
          "anyOf": [
            {"type": "number", "minimum": 0.0, "maximum": 1.0},
            {"type": "null"}
          ]
        },
        "upper": {
          "anyOf": [
            {"type": "number", "minimum": 0.0, "maximum": 1.0},
            {"type": "null"}
          ]
        }
      }
    },
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metric",
        "naive_population_bias",
        "naive_evaluable_bias",
        "truth_aligned_population_bias",
        "sensitivity_envelope_inclusion",
        "mean_sensitivity_envelope_lower",
        "mean_sensitivity_envelope_upper",
        "mean_sensitivity_envelope_width",
        "population_truth_distance_to_mean_envelope",
        "evaluable_calibration_met",
        "truth_aligned_recovery_met",
        "population_truth_recovered_by_mean_envelope",
        "identification_target_met"
      ],
      "properties": {
        "metric": {"type": "string", "minLength": 1},
        "naive_population_bias": {"$ref": "#/$defs/nullableMetric"},
        "naive_evaluable_bias": {"$ref": "#/$defs/nullableMetric"},
        "truth_aligned_population_bias": {"$ref": "#/$defs/nullableMetric"},
        "sensitivity_envelope_inclusion": {"$ref": "#/$defs/summaryRate"},
        "mean_sensitivity_envelope_lower": {"$ref": "#/$defs/nullableMetric"},
        "mean_sensitivity_envelope_upper": {"$ref": "#/$defs/nullableMetric"},
        "mean_sensitivity_envelope_width": {"$ref": "#/$defs/nullableMetric"},
        "population_truth_distance_to_mean_envelope": {
          "$ref": "#/$defs/nullableMetric"
        },
        "evaluable_calibration_met": {"type": "boolean"},
        "truth_aligned_recovery_met": {"type": "boolean"},
        "population_truth_recovered_by_mean_envelope": {"type": "boolean"},
        "identification_target_met": {"type": "boolean"}
      }
    },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scenario_id",
        "stage",
        "endpoint_family",
        "population_favorable_prevalence",
        "evaluable_favorable_prevalence",
        "true_log_imor",
        "true_informative_missingness_odds_ratio",
        "grid_brackets_true_log_imor",
        "analyzable_rate",
        "analyzable_target_met",
        "all_evaluable_calibration_targets_met",
        "all_truth_aligned_recovery_targets_met",
        "all_identification_targets_met",
        "research_target_met",
        "metrics"
      ],
      "properties": {
        "scenario_id": {"type": "string", "minLength": 1},
        "stage": {"type": "string", "minLength": 1},
        "endpoint_family": {"type": "string", "minLength": 1},
        "population_favorable_prevalence": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "evaluable_favorable_prevalence": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "true_log_imor": {"type": "number", "minimum": -8.0, "maximum": 8.0},
        "true_informative_missingness_odds_ratio": {
          "type": "number",
          "exclusiveMinimum": 0.0
        },
        "grid_brackets_true_log_imor": {"type": "boolean"},
        "analyzable_rate": {"$ref": "#/$defs/summaryRate"},
        "analyzable_target_met": {"type": "boolean"},
        "all_evaluable_calibration_targets_met": {"type": "boolean"},
        "all_truth_aligned_recovery_targets_met": {"type": "boolean"},
        "all_identification_targets_met": {"type": "boolean"},
        "research_target_met": {"type": "boolean"},
        "metrics": {
          "type": "array",
          "minItems": 8,
          "maxItems": 8,
          "items": {"$ref": "#/$defs/metric"}
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jihunni/Agentic-Drug-Discovery-System/blob/main/rl_env/specs/frontier_private_tokenizer_placebo_packet_set.schema.json",
  "title": "ADDS-Frontier private blinded tokenizer placebo packet set",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "set_id", "protocol_id", "board_id", "compiled_on", "private_coupled_placebo_packet_set_integrity_sha256", "arm_role_mapping_included", "author_expectations_included", "minimum_independent_curators_per_packet", "review_instructions", "packets", "nonclaims", "integrity_sha256"],
  "properties": {
    "schema_version": {"const": "adds.frontier-private-tokenizer-placebo-packet-set.v1"},
    "set_id": {"const": "adds-frontier-tokenizer-placebo-v1"},
    "protocol_id": {"const": "adds-frontier-v1"},
    "board_id": {"const": "adds-frontier-private-pilot-v1"},
    "compiled_on": {"type": "string", "format": "date"},
    "private_coupled_placebo_packet_set_integrity_sha256": {"$ref": "#/$defs/sha256"},
    "arm_role_mapping_included": {"const": false},
    "author_expectations_included": {"const": false},
    "minimum_independent_curators_per_packet": {"const": 3},
    "review_instructions": {"type": "array", "minItems": 5, "maxItems": 5, "uniqueItems": true, "items": {"$ref": "#/$defs/nonempty"}},
    "packets": {"type": "array", "minItems": 10, "maxItems": 10, "items": {"$ref": "#/$defs/packet"}},
    "nonclaims": {"type": "array", "minItems": 9, "uniqueItems": true, "items": {"$ref": "#/$defs/nonempty"}},
    "integrity_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "nonempty": {"type": "string", "minLength": 1},
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["artifact_path", "artifact_sha256", "source_role", "model_visible"],
      "properties": {
        "artifact_path": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*\\.\\.).+$"},
        "artifact_sha256": {"$ref": "#/$defs/sha256"},
        "source_role": {"enum": ["authoring_context", "source_index", "verification_record"]},
        "model_visible": {"const": false}
      }
    },
    "evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["evidence_id", "available_on", "lineage_id", "evidence_role", "evidence_summary"],
      "properties": {
        "evidence_id": {"$ref": "#/$defs/nonempty"},
        "available_on": {"type": "string", "format": "date"},
        "lineage_id": {"$ref": "#/$defs/nonempty"},
        "evidence_role": {"enum": ["source", "context", "contradiction", "derivative", "decision_record"]},
        "evidence_summary": {"$ref": "#/$defs/nonempty"}
      }
    },
    "edge": {
      "type": "object", "additionalProperties": false,
      "required": ["parent_evidence_id", "child_evidence_id", "relationship"],
      "properties": {
        "parent_evidence_id": {"$ref": "#/$defs/nonempty"},
        "child_evidence_id": {"$ref": "#/$defs/nonempty"},
        "relationship": {"enum": ["derives_from", "corroborates", "supersedes", "conflicts_with"]}
      }
    },
    "stage": {
      "type": "object", "additionalProperties": false,
      "required": ["stage_id", "stage_kind", "as_of_date", "accessible_evidence_ids", "required_gates", "max_tool_calls"],
      "properties": {
        "stage_id": {"type": "string", "pattern": "^s[0-9]{2}$"},
        "stage_kind": {"enum": ["retrieve", "identity", "chronology", "lineage", "alignment", "synthesis", "action", "replay"]},
        "as_of_date": {"type": "string", "format": "date"},
        "accessible_evidence_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/nonempty"}},
        "required_gates": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/nonempty"}},
        "max_tool_calls": {"type": "integer", "minimum": 1}
      }
    },
    "arm": {
      "type": "object", "additionalProperties": false,
      "required": ["family_id", "disease_domain", "temporal_regime", "disease_identity", "program_identity", "prompt", "anchor_cutoff_date", "stage_budget", "tool_call_budget", "authoring_source_artifacts", "evidence_nodes", "lineage_edges", "stages"],
      "properties": {
        "family_id": {"enum": ["evidence_lineage_trap", "temporal_reversal", "translational_handoff", "non_exchangeable_replication", "budgeted_evidence_resolution"]},
        "disease_domain": {"enum": ["hematology", "immune_inflammatory"]},
        "temporal_regime": {"enum": ["historical_pre_2024", "historical_2024_2025"]},
        "disease_identity": {"$ref": "#/$defs/nonempty"},
        "program_identity": {"$ref": "#/$defs/nonempty"},
        "prompt": {"$ref": "#/$defs/nonempty"},
        "anchor_cutoff_date": {"type": "string", "format": "date"},
        "stage_budget": {"type": "integer", "minimum": 6, "maximum": 12},
        "tool_call_budget": {"type": "integer", "minimum": 1},
        "authoring_source_artifacts": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/source"}},
        "evidence_nodes": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/evidence"}},
        "lineage_edges": {"type": "array", "items": {"$ref": "#/$defs/edge"}},
        "stages": {"type": "array", "minItems": 6, "maxItems": 12, "items": {"$ref": "#/$defs/stage"}}
      }
    },
    "packet": {
      "type": "object", "additionalProperties": false,
      "required": ["packet_id", "review_dimensions", "arm_a", "arm_b", "arm_c", "arm_d", "arm_e", "arm_a_commitment", "arm_b_commitment", "arm_c_commitment", "arm_d_commitment", "arm_e_commitment", "matched_tokenizer_profile_commitment"],
      "properties": {
        "packet_id": {"type": "string", "pattern": "^tokenizer-placebo-[0-9a-f]{20}$"},
        "review_dimensions": {"type": "array", "minItems": 5, "maxItems": 5, "uniqueItems": true, "items": {"enum": ["disposition", "next_action", "risk_flags", "witness", "blockers"]}},
        "arm_a": {"$ref": "#/$defs/arm"},
        "arm_b": {"$ref": "#/$defs/arm"},
        "arm_c": {"$ref": "#/$defs/arm"},
        "arm_d": {"$ref": "#/$defs/arm"},
        "arm_e": {"$ref": "#/$defs/arm"},
        "arm_a_commitment": {"$ref": "#/$defs/sha256"},
        "arm_b_commitment": {"$ref": "#/$defs/sha256"},
        "arm_c_commitment": {"$ref": "#/$defs/sha256"},
        "arm_d_commitment": {"$ref": "#/$defs/sha256"},
        "arm_e_commitment": {"$ref": "#/$defs/sha256"},
        "matched_tokenizer_profile_commitment": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}

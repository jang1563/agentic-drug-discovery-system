{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jihunni/Agentic-Drug-Discovery-System/blob/main/rl_env/specs/frontier_calibration_authoring_progress.schema.json",
  "title": "ADDS-Frontier payload-free calibration authoring progress",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "protocol_id",
    "board_id",
    "status",
    "updated_on",
    "board_protocol_integrity_sha256",
    "slot_manifest_integrity_sha256",
    "task_set_commitment",
    "oracle_set_commitment",
    "private_payload_published",
    "task_selection_blinded_to_models",
    "baseline_model_runs_started",
    "benchmark_evidence_claimed",
    "authored_task_count",
    "board_admitted_count",
    "records",
    "nonclaims",
    "integrity_sha256"
  ],
  "properties": {
    "schema_version": {"const": "adds.frontier-calibration-progress.v1"},
    "protocol_id": {"const": "adds-frontier-v1"},
    "board_id": {"const": "adds-frontier-private-pilot-v1"},
    "status": {"const": "calibration_authored_pending_independent_review"},
    "updated_on": {"type": "string", "format": "date"},
    "board_protocol_integrity_sha256": {"$ref": "#/$defs/sha256"},
    "slot_manifest_integrity_sha256": {"$ref": "#/$defs/sha256"},
    "task_set_commitment": {"$ref": "#/$defs/sha256"},
    "oracle_set_commitment": {"$ref": "#/$defs/sha256"},
    "private_payload_published": {"const": false},
    "task_selection_blinded_to_models": {"const": true},
    "baseline_model_runs_started": {"const": false},
    "benchmark_evidence_claimed": {"const": false},
    "authored_task_count": {"const": 10},
    "board_admitted_count": {"const": 0},
    "records": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": {"$ref": "#/$defs/record"}
    },
    "nonclaims": {
      "type": "array",
      "minItems": 4,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "integrity_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "gateResults": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_packet_integrity",
        "oracle_commitment_sealed",
        "independent_scientific_review",
        "evidence_lineage_review",
        "temporal_leakage_review",
        "counterfactual_mutation_review",
        "expert_solvability",
        "structured_oracle_replay",
        "conflict_of_interest_clear",
        "contamination_canary_clear"
      ],
      "properties": {
        "task_packet_integrity": {"const": "pass"},
        "oracle_commitment_sealed": {"const": "pass"},
        "independent_scientific_review": {"const": "pending"},
        "evidence_lineage_review": {"const": "pending"},
        "temporal_leakage_review": {"const": "pending"},
        "counterfactual_mutation_review": {"const": "pending"},
        "expert_solvability": {"const": "pending"},
        "structured_oracle_replay": {"const": "pending"},
        "conflict_of_interest_clear": {"const": "pending"},
        "contamination_canary_clear": {"const": "pending"}
      }
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slot_id",
        "family_id",
        "disease_domain",
        "temporal_regime",
        "status",
        "task_commitment",
        "oracle_commitment",
        "program_commitment",
        "disease_identity_commitment",
        "stage_count",
        "mutation_count",
        "authoring_source_count",
        "curator_roster_commitment",
        "independent_curator_count",
        "admission_gate_results",
        "board_admitted"
      ],
      "properties": {
        "slot_id": {"type": "string", "pattern": "^slot-[a-z]+-[0-9]{2}$"},
        "family_id": {
          "enum": [
            "evidence_lineage_trap",
            "temporal_reversal",
            "translational_handoff",
            "non_exchangeable_replication",
            "budgeted_evidence_resolution"
          ]
        },
        "disease_domain": {"enum": ["hematology", "immune_inflammatory"]},
        "temporal_regime": {"enum": ["historical_pre_2024", "historical_2024_2025"]},
        "status": {"const": "authored_pending_review"},
        "task_commitment": {"$ref": "#/$defs/sha256"},
        "oracle_commitment": {"$ref": "#/$defs/sha256"},
        "program_commitment": {"$ref": "#/$defs/sha256"},
        "disease_identity_commitment": {"$ref": "#/$defs/sha256"},
        "stage_count": {"type": "integer", "minimum": 6, "maximum": 12},
        "mutation_count": {"type": "integer", "minimum": 5},
        "authoring_source_count": {"type": "integer", "minimum": 2},
        "curator_roster_commitment": {"type": "null"},
        "independent_curator_count": {"const": 0},
        "admission_gate_results": {"$ref": "#/$defs/gateResults"},
        "board_admitted": {"const": false}
      }
    }
  }
}

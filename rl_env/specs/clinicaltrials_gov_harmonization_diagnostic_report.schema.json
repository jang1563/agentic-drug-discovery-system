{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/adds/clinicaltrials_gov_harmonization_diagnostic_report.schema.json",
  "title": "ADDS ClinicalTrials.gov Harmonization Diagnostic Report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "integrity_sha256", "report"],
  "properties": {
    "schema_version": {
      "const": "adds.clinicaltrials-gov-harmonization-diagnostic-report.v1"
    },
    "integrity_sha256": { "$ref": "#/$defs/sha256" },
    "report": { "$ref": "#/$defs/report" }
  },
  "$defs": {
    "text": {
      "type": "string",
      "minLength": 1,
      "pattern": ".*\\S.*"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "nonNegativeInteger": {
      "type": "integer",
      "minimum": 0
    },
    "diagnosticCode": {
      "enum": [
        "title",
        "time_frame",
        "outcome_type",
        "reporting_status",
        "parameter_type",
        "dispersion_type",
        "unit_of_measure",
        "population_description_sha256",
        "unmatched",
        "unique_exact_candidate",
        "ambiguous_exact_candidates",
        "incomplete_source_fields",
        "all_mechanical_fields_equal",
        "mixed_mechanical_fields",
        "semantic_endpoint_review_required",
        "source_field_completion_required",
        "within_trial_reconciliation_review_required",
        "title_identity_review_required",
        "time_frame_review_required",
        "outcome_type_review_required",
        "reporting_status_review_required",
        "estimand_structure_review_required",
        "population_review_required",
        "safety_window_review_required"
      ]
    },
    "routeCode": {
      "enum": [
        "semantic_endpoint_review_required",
        "source_field_completion_required",
        "within_trial_reconciliation_review_required",
        "title_identity_review_required",
        "time_frame_review_required",
        "outcome_type_review_required",
        "reporting_status_review_required",
        "estimand_structure_review_required",
        "population_review_required",
        "safety_window_review_required"
      ]
    },
    "diagnosticCount": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "count"],
      "properties": {
        "code": { "$ref": "#/$defs/diagnosticCode" },
        "count": { "$ref": "#/$defs/nonNegativeInteger" }
      }
    },
    "trialDiagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nct_id",
        "inventory_sha256",
        "source_content_hash_sha256",
        "registry_version",
        "source_has_results",
        "protocol_outcome_module_present",
        "posted_outcome_module_present",
        "adverse_event_module_present",
        "protocol_outcome_count",
        "posted_outcome_count",
        "lexical_link_candidate_count",
        "safety_group_count",
        "serious_event_count",
        "other_event_count",
        "safety_event_stat_count",
        "endpoint_field_missing_counts",
        "reconciliation_status_counts"
      ],
      "properties": {
        "nct_id": {
          "type": "string",
          "pattern": "^NCT[0-9]{8}$"
        },
        "inventory_sha256": { "$ref": "#/$defs/sha256" },
        "source_content_hash_sha256": { "$ref": "#/$defs/sha256" },
        "registry_version": { "type": "string", "format": "date" },
        "source_has_results": { "type": "boolean" },
        "protocol_outcome_module_present": { "type": "boolean" },
        "posted_outcome_module_present": { "type": "boolean" },
        "adverse_event_module_present": { "type": "boolean" },
        "protocol_outcome_count": { "$ref": "#/$defs/nonNegativeInteger" },
        "posted_outcome_count": { "$ref": "#/$defs/nonNegativeInteger" },
        "lexical_link_candidate_count": { "$ref": "#/$defs/nonNegativeInteger" },
        "safety_group_count": { "$ref": "#/$defs/nonNegativeInteger" },
        "serious_event_count": { "$ref": "#/$defs/nonNegativeInteger" },
        "other_event_count": { "$ref": "#/$defs/nonNegativeInteger" },
        "safety_event_stat_count": { "$ref": "#/$defs/nonNegativeInteger" },
        "endpoint_field_missing_counts": {
          "type": "array",
          "minItems": 8,
          "maxItems": 8,
          "items": { "$ref": "#/$defs/diagnosticCount" }
        },
        "reconciliation_status_counts": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": { "$ref": "#/$defs/diagnosticCount" }
        }
      }
    },
    "pairFieldDiagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "field_name",
        "pair_count",
        "observed_both_count",
        "missing_pair_count",
        "exact_count",
        "disagreement_count"
      ],
      "properties": {
        "field_name": {
          "enum": [
            "title",
            "time_frame",
            "outcome_type",
            "reporting_status",
            "parameter_type",
            "dispersion_type",
            "unit_of_measure",
            "population_description_sha256",
            "safety_time_frame"
          ]
        },
        "pair_count": { "$ref": "#/$defs/nonNegativeInteger" },
        "observed_both_count": { "$ref": "#/$defs/nonNegativeInteger" },
        "missing_pair_count": { "$ref": "#/$defs/nonNegativeInteger" },
        "exact_count": { "$ref": "#/$defs/nonNegativeInteger" },
        "disagreement_count": { "$ref": "#/$defs/nonNegativeInteger" }
      }
    },
    "structuralDiagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "field_name",
        "pair_count",
        "exact_count",
        "disagreement_count"
      ],
      "properties": {
        "field_name": {
          "enum": [
            "group_count",
            "denominator_count",
            "class_count",
            "category_count",
            "measurement_count",
            "analysis_count",
            "analysis_group_id_sets"
          ]
        },
        "pair_count": { "$ref": "#/$defs/nonNegativeInteger" },
        "exact_count": { "$ref": "#/$defs/nonNegativeInteger" },
        "disagreement_count": { "$ref": "#/$defs/nonNegativeInteger" }
      }
    },
    "difficultySignature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["signature_sha256", "route_codes", "pair_count"],
      "properties": {
        "signature_sha256": { "$ref": "#/$defs/sha256" },
        "route_codes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/routeCode" }
        },
        "pair_count": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "report": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "report_id",
        "policy_id",
        "spec_sha256",
        "candidate_packet_id",
        "candidate_packet_sha256",
        "trial_diagnostics",
        "pair_field_diagnostics",
        "structural_diagnostics",
        "mechanical_status_counts",
        "review_route_counts",
        "difficulty_signatures",
        "trial_count",
        "endpoint_candidate_count",
        "pair_candidate_count",
        "unique_difficulty_signature_count",
        "pairs_with_multiple_additional_blockers_count",
        "pairs_with_no_additional_mechanical_blocker_count",
        "payload_free_aggregate_only",
        "every_pair_requires_semantic_review",
        "automatic_pair_approval_performed",
        "automatic_pair_exclusion_performed",
        "endpoint_family_assigned",
        "estimand_equivalence_inferred",
        "clinical_comparability_inferred",
        "comparative_safety_inferred",
        "benefit_risk_synthesis_performed",
        "treatment_choice_inferred",
        "limitations"
      ],
      "properties": {
        "report_id": { "$ref": "#/$defs/text" },
        "policy_id": {
          "const": "adds.payload-free-harmonization-difficulty-diagnostics.v1"
        },
        "spec_sha256": { "$ref": "#/$defs/sha256" },
        "candidate_packet_id": { "$ref": "#/$defs/text" },
        "candidate_packet_sha256": { "$ref": "#/$defs/sha256" },
        "trial_diagnostics": {
          "type": "array",
          "minItems": 2,
          "maxItems": 256,
          "items": { "$ref": "#/$defs/trialDiagnostic" }
        },
        "pair_field_diagnostics": {
          "type": "array",
          "minItems": 9,
          "maxItems": 9,
          "items": { "$ref": "#/$defs/pairFieldDiagnostic" }
        },
        "structural_diagnostics": {
          "type": "array",
          "minItems": 7,
          "maxItems": 7,
          "items": { "$ref": "#/$defs/structuralDiagnostic" }
        },
        "mechanical_status_counts": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": { "$ref": "#/$defs/diagnosticCount" }
        },
        "review_route_counts": {
          "type": "array",
          "minItems": 10,
          "maxItems": 10,
          "items": { "$ref": "#/$defs/diagnosticCount" }
        },
        "difficulty_signatures": {
          "type": "array",
          "items": { "$ref": "#/$defs/difficultySignature" }
        },
        "trial_count": {
          "type": "integer",
          "minimum": 2,
          "maximum": 256
        },
        "endpoint_candidate_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        },
        "pair_candidate_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        },
        "unique_difficulty_signature_count": { "$ref": "#/$defs/nonNegativeInteger" },
        "pairs_with_multiple_additional_blockers_count": { "$ref": "#/$defs/nonNegativeInteger" },
        "pairs_with_no_additional_mechanical_blocker_count": { "$ref": "#/$defs/nonNegativeInteger" },
        "payload_free_aggregate_only": { "const": true },
        "every_pair_requires_semantic_review": { "const": true },
        "automatic_pair_approval_performed": { "const": false },
        "automatic_pair_exclusion_performed": { "const": false },
        "endpoint_family_assigned": { "const": false },
        "estimand_equivalence_inferred": { "const": false },
        "clinical_comparability_inferred": { "const": false },
        "comparative_safety_inferred": { "const": false },
        "benefit_risk_synthesis_performed": { "const": false },
        "treatment_choice_inferred": { "const": false },
        "limitations": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": { "$ref": "#/$defs/text" }
        }
      }
    }
  }
}

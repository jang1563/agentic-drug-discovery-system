{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jihunni/Agentic-Drug-Discovery-System/blob/main/rl_env/specs/frontier_private_semantic_review_workflow_ledger.schema.json",
  "title": "ADDS-Frontier private semantic review workflow ledger",
  "type": "object", "additionalProperties": false,
  "required": [
    "schema_version", "workflow_id", "protocol_id", "board_id", "compiled_on",
    "packet_set_integrity_sha256", "key_set_integrity_sha256",
    "semantic_readiness_integrity_sha256", "required_response_count_per_packet",
    "consensus_rule", "pair_consistency_rule", "pre_access_invariance_rule",
    "routing_precedence", "records", "reviewer_assignment_count",
    "reviewer_response_count", "consensus_candidate_count", "adjudication_count",
    "independent_review_complete", "integrity_sha256"
  ],
  "properties": {
    "schema_version": {"const": "adds.frontier-private-semantic-review-workflow-ledger.v1"},
    "workflow_id": {"const": "adds-frontier-semantic-review-workflow-v1"},
    "protocol_id": {"const": "adds-frontier-v1"},
    "board_id": {"const": "adds-frontier-private-pilot-v1"},
    "compiled_on": {"type": "string", "format": "date"},
    "packet_set_integrity_sha256": {"$ref": "#/$defs/sha256"},
    "key_set_integrity_sha256": {"$ref": "#/$defs/sha256"},
    "semantic_readiness_integrity_sha256": {"$ref": "#/$defs/sha256"},
    "required_response_count_per_packet": {"const": 3},
    "consensus_rule": {"const": "three_independent_exact_responses"},
    "pair_consistency_rule": {"const": "pair_assessment_equals_observed_stage_deltas"},
    "pre_access_invariance_rule": {"const": "bounded_evidence_arms_invariant_before_access_delta"},
    "routing_precedence": {"$ref": "#/$defs/routes"},
    "records": {"type": "array", "minItems": 20, "maxItems": 20, "items": {"$ref": "#/$defs/record"}},
    "reviewer_assignment_count": {"const": 0},
    "reviewer_response_count": {"const": 0},
    "consensus_candidate_count": {"const": 0},
    "adjudication_count": {"const": 0},
    "independent_review_complete": {"const": false},
    "integrity_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "routes": {"type": "array", "prefixItems": [
      {"const": "adjudication_required_abstention"},
      {"const": "adjudication_required_action_disagreement"},
      {"const": "adjudication_required_support_disagreement"},
      {"const": "adjudication_required_change_disagreement"},
      {"const": "consensus_candidate"}
    ], "items": false},
    "record": {
      "type": "object", "additionalProperties": false,
      "required": ["packet_id", "packet_commitment", "key_commitment", "required_response_count", "status", "reviewer_assignment_commitments", "response_commitments", "triage_commitment", "adjudication_commitment"],
      "properties": {
        "packet_id": {"type": "string", "pattern": "^semantic-[0-9a-f]{20}$"},
        "packet_commitment": {"$ref": "#/$defs/sha256"},
        "key_commitment": {"$ref": "#/$defs/sha256"},
        "required_response_count": {"const": 3},
        "status": {"const": "unassigned"},
        "reviewer_assignment_commitments": {"type": "array", "maxItems": 0},
        "response_commitments": {"type": "array", "maxItems": 0},
        "triage_commitment": {"type": "null"},
        "adjudication_commitment": {"type": "null"}
      }
    }
  }
}

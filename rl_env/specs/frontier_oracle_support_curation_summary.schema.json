{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jihunni/Agentic-Drug-Discovery-System/blob/main/rl_env/specs/frontier_oracle_support_curation_summary.schema.json",
  "title": "ADDS-Frontier payload-free oracle support curation summary",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "curation_id", "protocol_id", "board_id", "status", "compiled_on", "public_preflight_integrity_sha256", "public_fragility_summary_integrity_sha256", "private_packet_set_commitment", "support_ablation_rule", "review_priority_rule", "task_packet_count", "canonical_stage_count", "planned_ablation_candidate_count", "applicable_ablation_candidate_count", "nonapplicable_ablation_candidate_count", "ablation_localization_pass_count", "witness_saturated_stage_count", "repeated_lineage_group_count", "lineage_redundancy_candidate_count", "support_selectivity_candidate_count", "protected_singleton_candidate_count", "witness_occurrence_role_counts", "applicable_candidate_role_counts", "machine_ablation_localization_ready", "curation_packets_ready_for_human_review", "human_curation_required", "oracle_revision_applied", "oracle_support_ready_for_independent_challenge", "human_review_assignment_count", "human_decision_count", "challenge_assignment_authorized", "scientific_minimality_established", "expert_solve_gate_changed", "admission_gate_changed", "board_admitted_count", "baseline_model_runs_started", "benchmark_evidence_claimed", "private_payload_published", "nonclaims", "integrity_sha256"],
  "properties": {
    "schema_version": {"const": "adds.frontier-oracle-support-curation-summary.v1"},
    "curation_id": {"const": "adds-frontier-oracle-support-curation-v1"},
    "protocol_id": {"const": "adds-frontier-v1"},
    "board_id": {"const": "adds-frontier-private-pilot-v1"},
    "status": {"const": "machine_packets_ready_human_curation_unassigned"},
    "compiled_on": {"type": "string", "format": "date"},
    "public_preflight_integrity_sha256": {"$ref": "#/$defs/sha256"},
    "public_fragility_summary_integrity_sha256": {"$ref": "#/$defs/sha256"},
    "private_packet_set_commitment": {"$ref": "#/$defs/sha256"},
    "support_ablation_rule": {"const": "leave_one_witness_out_only_when_at_least_one_witness_remains"},
    "review_priority_rule": {"const": "repeated_lineage_members_before_other_witness_saturation_candidates"},
    "task_packet_count": {"const": 10},
    "canonical_stage_count": {"const": 60},
    "planned_ablation_candidate_count": {"type": "integer", "minimum": 60},
    "applicable_ablation_candidate_count": {"type": "integer", "minimum": 0},
    "nonapplicable_ablation_candidate_count": {"type": "integer", "minimum": 0, "maximum": 60},
    "ablation_localization_pass_count": {"type": "integer", "minimum": 0},
    "witness_saturated_stage_count": {"type": "integer", "minimum": 0, "maximum": 60},
    "repeated_lineage_group_count": {"type": "integer", "minimum": 0},
    "lineage_redundancy_candidate_count": {"type": "integer", "minimum": 0},
    "support_selectivity_candidate_count": {"type": "integer", "minimum": 0},
    "protected_singleton_candidate_count": {"type": "integer", "minimum": 0, "maximum": 60},
    "witness_occurrence_role_counts": {"$ref": "#/$defs/role_counts"},
    "applicable_candidate_role_counts": {"$ref": "#/$defs/role_counts"},
    "machine_ablation_localization_ready": {"type": "boolean"},
    "curation_packets_ready_for_human_review": {"type": "boolean"},
    "human_curation_required": {"const": true},
    "oracle_revision_applied": {"const": false},
    "oracle_support_ready_for_independent_challenge": {"const": false},
    "human_review_assignment_count": {"const": 0},
    "human_decision_count": {"const": 0},
    "challenge_assignment_authorized": {"const": false},
    "scientific_minimality_established": {"const": false},
    "expert_solve_gate_changed": {"const": false},
    "admission_gate_changed": {"const": false},
    "board_admitted_count": {"const": 0},
    "baseline_model_runs_started": {"const": false},
    "benchmark_evidence_claimed": {"const": false},
    "private_payload_published": {"const": false},
    "nonclaims": {"type": "array", "minItems": 6, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "integrity_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "role_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "context", "contradiction", "derivative", "decision_record"],
      "properties": {
        "source": {"type": "integer", "minimum": 0},
        "context": {"type": "integer", "minimum": 0},
        "contradiction": {"type": "integer", "minimum": 0},
        "derivative": {"type": "integer", "minimum": 0},
        "decision_record": {"type": "integer", "minimum": 0}
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jang1563/agentic-drug-discovery-system/rl_env/specs/clinical_prediction_submission.schema.json",
  "title": "Clinical package-bound probability submission envelope",
  "description": "Frozen policy submission binding favorable composite benefit-risk probabilities to exact outcome-free clinical packages before the outcome deadline.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "integrity_sha256", "submission"],
  "properties": {
    "schema_version": {"const": "adds.clinical-prediction-submission.v1"},
    "integrity_sha256": {"$ref": "#/$defs/sha256"},
    "submission": {"$ref": "#/$defs/submission"}
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "date": {"type": "string", "format": "date"},
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy_id", "policy_version", "policy_fingerprint"],
      "properties": {
        "policy_id": {"$ref": "#/$defs/text"},
        "policy_version": {"$ref": "#/$defs/text"},
        "policy_fingerprint": {"$ref": "#/$defs/sha256"}
      }
    },
    "prediction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["package_id", "package_integrity_sha256", "evidence_unit_id", "favorable_probability"],
      "properties": {
        "package_id": {"$ref": "#/$defs/text"},
        "package_integrity_sha256": {"$ref": "#/$defs/sha256"},
        "evidence_unit_id": {"$ref": "#/$defs/sha256"},
        "favorable_probability": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "submission": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "submission_id",
        "protocol_id",
        "protocol_fingerprint",
        "cohort_report_fingerprint",
        "policy",
        "submitted_on",
        "predictions",
        "metadata"
      ],
      "properties": {
        "submission_id": {"$ref": "#/$defs/text"},
        "protocol_id": {"$ref": "#/$defs/text"},
        "protocol_fingerprint": {"$ref": "#/$defs/sha256"},
        "cohort_report_fingerprint": {"$ref": "#/$defs/sha256"},
        "policy": {"$ref": "#/$defs/policy"},
        "submitted_on": {"$ref": "#/$defs/date"},
        "predictions": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/prediction"}
        },
        "metadata": {"type": "object"}
      }
    }
  }
}

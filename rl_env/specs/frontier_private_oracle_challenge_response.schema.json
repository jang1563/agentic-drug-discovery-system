{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jihunni/Agentic-Drug-Discovery-System/blob/main/rl_env/specs/frontier_private_oracle_challenge_response.schema.json",
  "title": "ADDS-Frontier private independent challenger response",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "packet_id", "packet_set_integrity_sha256", "challenge_task_commitment", "challenger_identity_commitment", "challenger_affiliation_commitment", "conflict_of_interest_declared", "independence_attested", "author_oracle_accessed", "semantic_review_material_accessed", "authoring_source_artifacts_accessed", "completed_on", "stage_answers", "overall_abstained", "integrity_sha256"],
  "properties": {
    "schema_version": {"const": "adds.frontier-private-oracle-challenge-response.v1"},
    "packet_id": {"type": "string", "pattern": "^oracle-challenge-[0-9a-f]{20}$"},
    "packet_set_integrity_sha256": {"$ref": "#/$defs/sha256"},
    "challenge_task_commitment": {"$ref": "#/$defs/sha256"},
    "challenger_identity_commitment": {"$ref": "#/$defs/sha256"},
    "challenger_affiliation_commitment": {"$ref": "#/$defs/sha256"},
    "conflict_of_interest_declared": {"const": false},
    "independence_attested": {"const": true},
    "author_oracle_accessed": {"const": false},
    "semantic_review_material_accessed": {"const": false},
    "authoring_source_artifacts_accessed": {"const": false},
    "completed_on": {"type": "string", "format": "date"},
    "stage_answers": {"type": "array", "minItems": 6, "maxItems": 6, "items": {"$ref": "#/$defs/answer"}},
    "overall_abstained": {"type": "boolean"},
    "integrity_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "nonempty": {"type": "string", "minLength": 1},
    "answer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stage_id", "disposition", "next_action", "risk_flags", "witness_evidence_ids", "blocker_codes", "abstained"],
      "properties": {
        "stage_id": {"type": "string", "pattern": "^s[0-9]{2}$"},
        "disposition": {"enum": ["advance", "hold", "terminate"]},
        "next_action": {"enum": ["retrieve", "verify", "experiment", "human_review", "none"]},
        "risk_flags": {"type": "array", "uniqueItems": true, "items": {"enum": ["safety", "contradiction", "provenance", "out_of_distribution", "temporal_leakage"]}},
        "witness_evidence_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/nonempty"}},
        "blocker_codes": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/nonempty"}},
        "abstained": {"type": "boolean"}
      }
    }
  }
}

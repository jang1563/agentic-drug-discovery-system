{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jihunni/Agentic-Drug-Discovery-System/blob/main/rl_env/specs/frontier_private_calibration_oracle_set.schema.json",
  "title": "ADDS-Frontier private sealed calibration oracle set",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "protocol_id",
    "board_id",
    "set_id",
    "set_role",
    "authoring_status",
    "benchmark_evidence_claimed",
    "task_set_integrity_sha256",
    "oracles",
    "integrity_sha256"
  ],
  "properties": {
    "schema_version": {"const": "adds.frontier-private-calibration-oracle-set.v1"},
    "protocol_id": {"const": "adds-frontier-v1"},
    "board_id": {"const": "adds-frontier-private-pilot-v1"},
    "set_id": {"const": "adds-frontier-private-calibration-v1"},
    "set_role": {"const": "private_sealed_calibration_oracle"},
    "authoring_status": {"const": "authored_pending_review"},
    "benchmark_evidence_claimed": {"const": false},
    "task_set_integrity_sha256": {"$ref": "#/$defs/sha256"},
    "oracles": {"type": "array", "minItems": 10, "maxItems": 10, "items": {"$ref": "#/$defs/oracle"}},
    "integrity_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "nonempty": {"type": "string", "minLength": 1},
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["disposition", "next_action", "risk_flags"],
      "properties": {
        "disposition": {"enum": ["advance", "hold", "terminate"]},
        "next_action": {"enum": ["retrieve", "verify", "experiment", "human_review", "none"]},
        "risk_flags": {
          "type": "array",
          "uniqueItems": true,
          "items": {"enum": ["safety", "contradiction", "provenance", "out_of_distribution", "temporal_leakage"]}
        }
      }
    },
    "stageExpectation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stage_id", "action", "witness_evidence_ids", "blocker_codes"],
      "properties": {
        "stage_id": {"type": "string", "pattern": "^s[0-9]{2}$"},
        "action": {"$ref": "#/$defs/action"},
        "witness_evidence_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/nonempty"}},
        "blocker_codes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/nonempty"}}
      }
    },
    "mutation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mutation_id", "probe_kind", "mutation_class", "operation", "expected_changed_components"],
      "properties": {
        "mutation_id": {"$ref": "#/$defs/nonempty"},
        "probe_kind": {"enum": ["source_id_rename", "critical_evidence_removal", "temporal_access_rebind", "bounded_evidence_reveal", "identity_rebind"]},
        "mutation_class": {"enum": ["critical_flip", "nuisance_invariance", "evidence_ladder"]},
        "operation": {"$ref": "#/$defs/nonempty"},
        "expected_changed_components": {
          "type": "array",
          "uniqueItems": true,
          "items": {"enum": ["disposition", "next_action", "risk_flags", "witness", "blockers"]}
        }
      }
    },
    "oracle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slot_id", "task_id", "task_sha256", "oracle_commitment_nonce", "stage_expectations", "mutation_expectations", "nonclaim"],
      "properties": {
        "slot_id": {"type": "string", "pattern": "^slot-[a-z]+-[0-9]{2}$"},
        "task_id": {"$ref": "#/$defs/nonempty"},
        "task_sha256": {"$ref": "#/$defs/sha256"},
        "oracle_commitment_nonce": {"$ref": "#/$defs/sha256"},
        "stage_expectations": {"type": "array", "minItems": 6, "maxItems": 12, "items": {"$ref": "#/$defs/stageExpectation"}},
        "mutation_expectations": {"type": "array", "minItems": 5, "items": {"$ref": "#/$defs/mutation"}},
        "nonclaim": {"const": "This sealed draft oracle has not passed independent review, expert solve, or replay admission."}
      }
    }
  }
}

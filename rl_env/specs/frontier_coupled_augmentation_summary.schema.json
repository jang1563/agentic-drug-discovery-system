{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jihunni/Agentic-Drug-Discovery-System/blob/main/rl_env/specs/frontier_coupled_augmentation_summary.schema.json",
  "title": "ADDS-Frontier payload-free coupled augmentation summary",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "design_id", "protocol_id", "board_id", "status", "compiled_on", "public_preflight_integrity_sha256", "public_semantic_summary_integrity_sha256", "public_transition_audit_summary_integrity_sha256", "private_packet_set_commitment", "pairing_rule", "matched_design_unit_count", "evidence_reveal_candidate_count", "nuisance_invariance_control_count", "exact_structural_delta_candidate_count", "machine_invariance_control_pass_count", "action_witness_coupling_candidate_count", "semantic_label_required_count", "semantic_label_recorded_count", "coupled_transition_admitted_count", "coupled_augmentation_design_ready", "canonical_transition_coupling_coverage_ready", "evidence_action_coupling_review_required", "human_semantic_review_required", "scientific_coupling_established", "oracle_revision_applied", "oracle_support_ready_for_independent_challenge", "challenge_assignment_authorized", "expert_solve_gate_changed", "admission_gate_changed", "board_admitted_count", "baseline_model_runs_started", "benchmark_evidence_claimed", "author_expected_component_payload_published", "private_payload_published", "nonclaims", "integrity_sha256"],
  "properties": {
    "schema_version": {"const": "adds.frontier-coupled-augmentation-summary.v1"},
    "design_id": {"const": "adds-frontier-coupled-augmentation-v1"},
    "protocol_id": {"const": "adds-frontier-v1"},
    "board_id": {"const": "adds-frontier-private-pilot-v1"},
    "status": {"const": "matched_augmentation_design_compiled_semantic_labels_pending"},
    "compiled_on": {"type": "string", "format": "date"},
    "public_preflight_integrity_sha256": {"$ref": "#/$defs/sha256"},
    "public_semantic_summary_integrity_sha256": {"$ref": "#/$defs/sha256"},
    "public_transition_audit_summary_integrity_sha256": {"$ref": "#/$defs/sha256"},
    "private_packet_set_commitment": {"$ref": "#/$defs/sha256"},
    "pairing_rule": {"const": "pair_each_bounded_evidence_reveal_candidate_with_its_same_slot_source_id_rename_invariance_control"},
    "matched_design_unit_count": {"const": 10},
    "evidence_reveal_candidate_count": {"const": 10},
    "nuisance_invariance_control_count": {"const": 10},
    "exact_structural_delta_candidate_count": {"const": 10},
    "machine_invariance_control_pass_count": {"const": 10},
    "action_witness_coupling_candidate_count": {"const": 10},
    "semantic_label_required_count": {"const": 10},
    "semantic_label_recorded_count": {"const": 0},
    "coupled_transition_admitted_count": {"const": 0},
    "coupled_augmentation_design_ready": {"const": true},
    "canonical_transition_coupling_coverage_ready": {"type": "boolean"},
    "evidence_action_coupling_review_required": {"type": "boolean"},
    "human_semantic_review_required": {"const": true},
    "scientific_coupling_established": {"const": false},
    "oracle_revision_applied": {"const": false},
    "oracle_support_ready_for_independent_challenge": {"const": false},
    "challenge_assignment_authorized": {"const": false},
    "expert_solve_gate_changed": {"const": false},
    "admission_gate_changed": {"const": false},
    "board_admitted_count": {"const": 0},
    "baseline_model_runs_started": {"const": false},
    "benchmark_evidence_claimed": {"const": false},
    "author_expected_component_payload_published": {"const": false},
    "private_payload_published": {"const": false},
    "nonclaims": {"type": "array", "minItems": 7, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "integrity_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jang1563/agentic-drug-discovery-system/rl_env/specs/clinical_outcome_pattern_mixture_uncertainty_summary.schema.json",
  "title": "Clinical Outcome Pattern-Mixture Uncertainty Summary",
  "description": "Compact human- and machine-readable projection of jackknife calibration and dependence-closure evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "protocol_id",
    "protocol_fingerprint",
    "report_fingerprint",
    "stress_protocol_id",
    "stress_protocol_fingerprint",
    "stress_report_fingerprint",
    "pattern_mixture_protocol_id",
    "pattern_mixture_protocol_fingerprint",
    "pattern_mixture_report_fingerprint",
    "method_id",
    "replicates",
    "log_imor_grid",
    "targets",
    "all_scenarios_research_targets_met",
    "scenarios",
    "claim_boundary"
  ],
  "properties": {
    "schema_version": {
      "const": "adds.clinical-outcome-pattern-mixture-uncertainty-summary.v1"
    },
    "protocol_id": {"type": "string", "minLength": 1},
    "protocol_fingerprint": {"$ref": "#/$defs/sha256"},
    "report_fingerprint": {"$ref": "#/$defs/sha256"},
    "stress_protocol_id": {"type": "string", "minLength": 1},
    "stress_protocol_fingerprint": {"$ref": "#/$defs/sha256"},
    "stress_report_fingerprint": {"$ref": "#/$defs/sha256"},
    "pattern_mixture_protocol_id": {"type": "string", "minLength": 1},
    "pattern_mixture_protocol_fingerprint": {"$ref": "#/$defs/sha256"},
    "pattern_mixture_report_fingerprint": {"$ref": "#/$defs/sha256"},
    "method_id": {
      "const": "adds.pattern-mixture.dependence-block-delete-one-jackknife.v1"
    },
    "replicates": {"type": "integer", "minimum": 1},
    "log_imor_grid": {
      "type": "array",
      "minItems": 3,
      "maxItems": 33,
      "uniqueItems": true,
      "items": {"type": "number", "minimum": -8.0, "maximum": 8.0}
    },
    "targets": {"$ref": "#/$defs/targets"},
    "all_scenarios_research_targets_met": {"type": "boolean"},
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/scenario"}
    },
    "claim_boundary": {"$ref": "#/$defs/claimBoundary"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "nullableNumber": {"anyOf": [{"type": "number"}, {"type": "null"}]},
    "rate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event_count", "total_count", "rate", "lower", "upper"],
      "properties": {
        "event_count": {"type": "integer", "minimum": 0},
        "total_count": {"type": "integer", "minimum": 0},
        "rate": {"$ref": "#/$defs/nullableNumber"},
        "lower": {"$ref": "#/$defs/nullableNumber"},
        "upper": {"$ref": "#/$defs/nullableNumber"}
      }
    },
    "targets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "confidence_level",
        "coverage_target",
        "minimum_interval_yield",
        "minimum_clusters",
        "maximum_cluster_unit_fraction",
        "maximum_absolute_bias",
        "standard_error_calibration_lower",
        "standard_error_calibration_upper",
        "closure_anchor_metric",
        "minimum_hidden_linkage_coverage_gain",
        "minimum_hidden_linkage_standard_error_ratio"
      ],
      "properties": {
        "confidence_level": {"type": "number"},
        "coverage_target": {"type": "number"},
        "minimum_interval_yield": {"type": "number"},
        "minimum_clusters": {"type": "integer", "minimum": 3},
        "maximum_cluster_unit_fraction": {"type": "number"},
        "maximum_absolute_bias": {"type": "number"},
        "standard_error_calibration_lower": {"type": "number"},
        "standard_error_calibration_upper": {"type": "number"},
        "closure_anchor_metric": {"type": "string", "minLength": 1},
        "minimum_hidden_linkage_coverage_gain": {"type": "number"},
        "minimum_hidden_linkage_standard_error_ratio": {"type": "number"}
      }
    },
    "seRange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimum", "maximum"],
      "properties": {
        "minimum": {"$ref": "#/$defs/nullableNumber"},
        "maximum": {"$ref": "#/$defs/nullableNumber"}
      }
    },
    "truthMetric": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metric",
        "interval_yield",
        "model_functional_coverage",
        "population_truth_coverage",
        "standard_error_to_empirical_sd_ratio",
        "research_target_met"
      ],
      "properties": {
        "metric": {"type": "string", "minLength": 1},
        "interval_yield": {"$ref": "#/$defs/rate"},
        "model_functional_coverage": {"$ref": "#/$defs/rate"},
        "population_truth_coverage": {"$ref": "#/$defs/rate"},
        "standard_error_to_empirical_sd_ratio": {"$ref": "#/$defs/nullableNumber"},
        "research_target_met": {"type": "boolean"}
      }
    },
    "mode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "analysis_mode",
        "analysis_cluster_count",
        "maximum_cluster_unit_fraction",
        "minimum_grid_model_functional_coverage_lower",
        "minimum_grid_interval_yield_lower",
        "standard_error_calibration_ratio_range",
        "all_metric_research_targets_met",
        "truth_aligned_metrics"
      ],
      "properties": {
        "analysis_mode": {"enum": ["nominal_clusters", "dependence_closed_clusters"]},
        "analysis_cluster_count": {"type": "integer", "minimum": 1},
        "maximum_cluster_unit_fraction": {"type": "number", "minimum": 0.0, "maximum": 1.0},
        "minimum_grid_model_functional_coverage_lower": {"$ref": "#/$defs/nullableNumber"},
        "minimum_grid_interval_yield_lower": {"$ref": "#/$defs/nullableNumber"},
        "standard_error_calibration_ratio_range": {"$ref": "#/$defs/seRange"},
        "all_metric_research_targets_met": {"type": "boolean"},
        "truth_aligned_metrics": {
          "type": "array",
          "minItems": 8,
          "maxItems": 8,
          "items": {"$ref": "#/$defs/truthMetric"}
        }
      }
    },
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metric",
        "dependence_closed_minus_nominal_coverage",
        "dependence_closed_to_nominal_standard_error_ratio",
        "closure_response_target_required",
        "exact_equivalence_expected",
        "exact_equivalence_met",
        "closure_response_target_met"
      ],
      "properties": {
        "metric": {"type": "string", "minLength": 1},
        "dependence_closed_minus_nominal_coverage": {"$ref": "#/$defs/nullableNumber"},
        "dependence_closed_to_nominal_standard_error_ratio": {"$ref": "#/$defs/nullableNumber"},
        "closure_response_target_required": {"type": "boolean"},
        "exact_equivalence_expected": {"type": "boolean"},
        "exact_equivalence_met": {"type": "boolean"},
        "closure_response_target_met": {"type": "boolean"}
      }
    },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scenario_id",
        "stage",
        "endpoint_family",
        "true_log_imor",
        "hidden_linkage_declared",
        "modes",
        "closure_comparisons",
        "dependence_closed_all_research_targets_met",
        "all_closure_response_targets_met",
        "research_target_met"
      ],
      "properties": {
        "scenario_id": {"type": "string", "minLength": 1},
        "stage": {"type": "string", "minLength": 1},
        "endpoint_family": {"type": "string", "minLength": 1},
        "true_log_imor": {"type": "number"},
        "hidden_linkage_declared": {"type": "boolean"},
        "modes": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {"$ref": "#/$defs/mode"}
        },
        "closure_comparisons": {
          "type": "array",
          "minItems": 8,
          "maxItems": 8,
          "items": {"$ref": "#/$defs/comparison"}
        },
        "dependence_closed_all_research_targets_met": {"type": "boolean"},
        "all_closure_response_targets_met": {"type": "boolean"},
        "research_target_met": {"type": "boolean"}
      }
    },
    "claimBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "aggregate_simulation_only",
        "replicate_level_records_included",
        "cluster_level_records_included",
        "unit_level_records_included",
        "real_clinical_outcomes_included",
        "sampling_uncertainty_intervals_included",
        "automatic_dependence_closure_included",
        "latent_truth_used_for_operational_grid",
        "identification_and_sampling_uncertainty_separated"
      ],
      "properties": {
        "aggregate_simulation_only": {"const": true},
        "replicate_level_records_included": {"const": false},
        "cluster_level_records_included": {"const": false},
        "unit_level_records_included": {"const": false},
        "real_clinical_outcomes_included": {"const": false},
        "sampling_uncertainty_intervals_included": {"const": true},
        "automatic_dependence_closure_included": {"const": false},
        "latent_truth_used_for_operational_grid": {"const": false},
        "identification_and_sampling_uncertainty_separated": {"const": true}
      }
    }
  }
}

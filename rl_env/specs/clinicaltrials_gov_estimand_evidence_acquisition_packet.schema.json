{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/adds/clinicaltrials_gov_estimand_evidence_acquisition_packet.schema.json",
  "title": "ClinicalTrials.gov estimand evidence-acquisition packet",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "integrity_sha256", "packet"],
  "properties": {
    "schema_version": {
      "const": "adds.clinicaltrials-gov-estimand-evidence-acquisition-packet.v1"
    },
    "integrity_sha256": { "$ref": "#/$defs/sha256" },
    "packet": { "$ref": "#/$defs/packet" }
  },
  "$defs": {
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "nctId": { "type": "string", "pattern": "^NCT[0-9]{8}$" },
    "nonNegativeInteger": { "type": "integer", "minimum": 0 },
    "positiveInteger": { "type": "integer", "minimum": 1 },
    "estimandDimension": {
      "enum": [
        "treatment_condition",
        "population",
        "variable",
        "intercurrent_event_strategy",
        "population_level_summary"
      ]
    },
    "estimandDimensions": {
      "type": "array",
      "prefixItems": [
        { "const": "treatment_condition" },
        { "const": "population" },
        { "const": "variable" },
        { "const": "intercurrent_event_strategy" },
        { "const": "population_level_summary" }
      ],
      "items": false,
      "minItems": 5,
      "maxItems": 5
    },
    "sourceDocument": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "document_id", "nct_id", "filename", "document_roles", "source_label",
        "source_locator", "source_document_date", "source_upload_date",
        "source_content_sha256", "size_bytes", "page_count",
        "text_bearing_page_count", "registry_inventory_verified",
        "exact_bytes_verified", "pdf_parse_verified"
      ],
      "properties": {
        "document_id": { "$ref": "#/$defs/nonEmptyString" },
        "nct_id": { "$ref": "#/$defs/nctId" },
        "filename": { "type": "string", "pattern": "^[^/]+\\.pdf$" },
        "document_roles": {
          "type": "array", "minItems": 1, "maxItems": 2, "uniqueItems": true,
          "items": { "enum": ["protocol", "sap"] }
        },
        "source_label": { "$ref": "#/$defs/nonEmptyString" },
        "source_locator": {
          "type": "string",
          "pattern": "^https://cdn\\.clinicaltrials\\.gov/large-docs/"
        },
        "source_document_date": { "type": "string", "format": "date" },
        "source_upload_date": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}$"
        },
        "source_content_sha256": { "$ref": "#/$defs/sha256" },
        "size_bytes": { "$ref": "#/$defs/positiveInteger" },
        "page_count": { "$ref": "#/$defs/positiveInteger" },
        "text_bearing_page_count": { "$ref": "#/$defs/nonNegativeInteger" },
        "registry_inventory_verified": { "const": true },
        "exact_bytes_verified": { "const": true },
        "pdf_parse_verified": { "const": true }
      }
    },
    "pageCue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "retrieval_rank", "document_id", "source_content_sha256", "page_number",
        "normalized_page_text_sha256", "matched_anchor_ids"
      ],
      "properties": {
        "retrieval_rank": { "$ref": "#/$defs/positiveInteger" },
        "document_id": { "$ref": "#/$defs/nonEmptyString" },
        "source_content_sha256": { "$ref": "#/$defs/sha256" },
        "page_number": { "$ref": "#/$defs/positiveInteger" },
        "normalized_page_text_sha256": { "$ref": "#/$defs/sha256" },
        "matched_anchor_ids": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": { "$ref": "#/$defs/nonEmptyString" }
        }
      }
    },
    "evidenceCue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_id", "endpoint_candidate_id", "nct_id", "source_record_sha256",
        "estimand_dimension", "cue_state", "candidate_pages",
        "source_excerpt_included", "semantic_sufficiency_assessed",
        "human_review_required"
      ],
      "properties": {
        "evidence_id": { "$ref": "#/$defs/nonEmptyString" },
        "endpoint_candidate_id": { "$ref": "#/$defs/nonEmptyString" },
        "nct_id": { "$ref": "#/$defs/nctId" },
        "source_record_sha256": { "$ref": "#/$defs/sha256" },
        "estimand_dimension": { "$ref": "#/$defs/estimandDimension" },
        "cue_state": { "enum": ["candidate_pages_found", "no_candidate_pages_found"] },
        "candidate_pages": {
          "type": "array", "maxItems": 20, "uniqueItems": true,
          "items": { "$ref": "#/$defs/pageCue" }
        },
        "source_excerpt_included": { "const": false },
        "semantic_sufficiency_assessed": { "const": false },
        "human_review_required": { "const": true }
      }
    },
    "pairAcquisition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pair_id", "left_endpoint_candidate_id", "right_endpoint_candidate_id",
        "preflight_review_route", "acquisition_state", "evidence_ids",
        "blocker_codes", "human_review_required", "reviewer_approval_performed",
        "estimand_equivalence_approved"
      ],
      "properties": {
        "pair_id": { "$ref": "#/$defs/nonEmptyString" },
        "left_endpoint_candidate_id": { "$ref": "#/$defs/nonEmptyString" },
        "right_endpoint_candidate_id": { "$ref": "#/$defs/nonEmptyString" },
        "preflight_review_route": { "$ref": "#/$defs/nonEmptyString" },
        "acquisition_state": { "enum": ["evidence_cues_acquired", "preflight_blocked"] },
        "evidence_ids": {
          "type": "array", "maxItems": 10, "uniqueItems": true,
          "items": { "$ref": "#/$defs/nonEmptyString" }
        },
        "blocker_codes": {
          "type": "array", "uniqueItems": true,
          "items": { "$ref": "#/$defs/nonEmptyString" }
        },
        "human_review_required": { "const": true },
        "reviewer_approval_performed": { "const": false },
        "estimand_equivalence_approved": { "const": false }
      }
    },
    "dimensionCount": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "estimand_dimension", "evidence_record_count",
        "candidate_pages_found_count", "no_candidate_pages_found_count"
      ],
      "properties": {
        "estimand_dimension": { "$ref": "#/$defs/estimandDimension" },
        "evidence_record_count": { "$ref": "#/$defs/nonNegativeInteger" },
        "candidate_pages_found_count": { "$ref": "#/$defs/nonNegativeInteger" },
        "no_candidate_pages_found_count": { "$ref": "#/$defs/nonNegativeInteger" }
      }
    },
    "packet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "packet_id", "policy_id", "anchor_policy_id", "spec_sha256",
        "candidate_packet_id", "candidate_packet_sha256", "preflight_packet_id",
        "preflight_packet_sha256", "required_estimand_dimensions", "source_documents",
        "evidence_cues", "pair_acquisitions", "dimension_counts",
        "source_document_count", "source_document_page_count",
        "source_document_text_bearing_page_count", "pair_count",
        "review_ready_pair_count", "preflight_blocked_pair_count",
        "unique_review_ready_endpoint_count", "evidence_record_count",
        "candidate_page_cue_count", "exact_registry_inventory_verified",
        "exact_document_bytes_verified", "source_payload_included",
        "source_excerpt_included", "semantic_sufficiency_assessed",
        "reviewer_approval_performed", "endpoint_equivalence_approved",
        "estimand_equivalence_approved", "benefit_risk_synthesis_performed",
        "treatment_choice_inferred", "limitations"
      ],
      "properties": {
        "packet_id": { "$ref": "#/$defs/nonEmptyString" },
        "policy_id": { "const": "adds.source-bound-estimand-evidence-acquisition.v1" },
        "anchor_policy_id": { "const": "adds.estimand-page-cue-anchors.v1" },
        "spec_sha256": { "$ref": "#/$defs/sha256" },
        "candidate_packet_id": { "$ref": "#/$defs/nonEmptyString" },
        "candidate_packet_sha256": { "$ref": "#/$defs/sha256" },
        "preflight_packet_id": { "$ref": "#/$defs/nonEmptyString" },
        "preflight_packet_sha256": { "$ref": "#/$defs/sha256" },
        "required_estimand_dimensions": { "$ref": "#/$defs/estimandDimensions" },
        "source_documents": { "type": "array", "items": { "$ref": "#/$defs/sourceDocument" } },
        "evidence_cues": { "type": "array", "items": { "$ref": "#/$defs/evidenceCue" } },
        "pair_acquisitions": { "type": "array", "items": { "$ref": "#/$defs/pairAcquisition" } },
        "dimension_counts": {
          "type": "array", "minItems": 5, "maxItems": 5,
          "items": { "$ref": "#/$defs/dimensionCount" }
        },
        "source_document_count": { "$ref": "#/$defs/nonNegativeInteger" },
        "source_document_page_count": { "$ref": "#/$defs/nonNegativeInteger" },
        "source_document_text_bearing_page_count": { "$ref": "#/$defs/nonNegativeInteger" },
        "pair_count": { "$ref": "#/$defs/nonNegativeInteger" },
        "review_ready_pair_count": { "$ref": "#/$defs/nonNegativeInteger" },
        "preflight_blocked_pair_count": { "$ref": "#/$defs/nonNegativeInteger" },
        "unique_review_ready_endpoint_count": { "$ref": "#/$defs/nonNegativeInteger" },
        "evidence_record_count": { "$ref": "#/$defs/nonNegativeInteger" },
        "candidate_page_cue_count": { "$ref": "#/$defs/nonNegativeInteger" },
        "exact_registry_inventory_verified": { "const": true },
        "exact_document_bytes_verified": { "const": true },
        "source_payload_included": { "const": false },
        "source_excerpt_included": { "const": false },
        "semantic_sufficiency_assessed": { "const": false },
        "reviewer_approval_performed": { "const": false },
        "endpoint_equivalence_approved": { "const": false },
        "estimand_equivalence_approved": { "const": false },
        "benefit_risk_synthesis_performed": { "const": false },
        "treatment_choice_inferred": { "const": false },
        "limitations": {
          "type": "array", "minItems": 6, "maxItems": 6,
          "items": { "$ref": "#/$defs/nonEmptyString" }
        }
      }
    }
  }
}

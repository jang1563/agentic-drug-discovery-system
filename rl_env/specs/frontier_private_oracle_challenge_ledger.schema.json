{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jihunni/Agentic-Drug-Discovery-System/blob/main/rl_env/specs/frontier_private_oracle_challenge_ledger.schema.json",
  "title": "ADDS-Frontier private independent-oracle challenge ledger",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "set_id", "protocol_id", "board_id", "compiled_on", "packet_set_integrity_sha256", "key_set_integrity_sha256", "private_preflight_integrity_sha256", "required_response_count_per_packet", "author_oracle_reveal_rule", "comparison_rule", "routing_precedence", "records", "challenger_assignment_count", "challenger_response_count", "oracle_convergence_candidate_count", "adjudication_count", "independent_oracle_challenge_complete", "integrity_sha256"],
  "properties": {
    "schema_version": {"const": "adds.frontier-private-oracle-challenge-ledger.v1"},
    "set_id": {"const": "adds-frontier-independent-oracle-challenge-v1"},
    "protocol_id": {"const": "adds-frontier-v1"},
    "board_id": {"const": "adds-frontier-private-pilot-v1"},
    "compiled_on": {"type": "string", "format": "date"},
    "packet_set_integrity_sha256": {"$ref": "#/$defs/sha256"},
    "key_set_integrity_sha256": {"$ref": "#/$defs/sha256"},
    "private_preflight_integrity_sha256": {"$ref": "#/$defs/sha256"},
    "required_response_count_per_packet": {"const": 2},
    "author_oracle_reveal_rule": {"const": "open_author_oracle_only_after_two_valid_independent_responses"},
    "comparison_rule": {"const": "exact_two_challenger_agreement_then_thirty_component_author_oracle_comparison"},
    "routing_precedence": {"$ref": "#/$defs/routes"},
    "records": {"type": "array", "minItems": 10, "maxItems": 10, "items": {"$ref": "#/$defs/record"}},
    "challenger_assignment_count": {"const": 0},
    "challenger_response_count": {"const": 0},
    "oracle_convergence_candidate_count": {"const": 0},
    "adjudication_count": {"const": 0},
    "independent_oracle_challenge_complete": {"const": false},
    "integrity_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "routes": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "prefixItems": [
        {"const": "adjudication_required_challenger_abstention"},
        {"const": "adjudication_required_challenger_disagreement"},
        {"const": "adjudication_required_author_oracle_disagreement"},
        {"const": "oracle_convergence_candidate"}
      ],
      "items": false
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["packet_id", "packet_commitment", "key_commitment", "required_response_count", "status", "challenger_assignment_commitments", "response_commitments", "comparison_commitment", "adjudication_commitment"],
      "properties": {
        "packet_id": {"type": "string", "pattern": "^oracle-challenge-[0-9a-f]{20}$"},
        "packet_commitment": {"$ref": "#/$defs/sha256"},
        "key_commitment": {"$ref": "#/$defs/sha256"},
        "required_response_count": {"const": 2},
        "status": {"const": "unassigned"},
        "challenger_assignment_commitments": {"type": "array", "maxItems": 0},
        "response_commitments": {"type": "array", "maxItems": 0},
        "comparison_commitment": {"type": "null"},
        "adjudication_commitment": {"type": "null"}
      }
    }
  }
}

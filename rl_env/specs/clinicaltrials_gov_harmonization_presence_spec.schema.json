{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/adds/clinicaltrials_gov_harmonization_presence_spec.schema.json",
  "title": "ADDS ClinicalTrials.gov Harmonization Presence Spec",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "report_id",
    "candidate_packet_sha256",
    "structure_report_sha256",
    "sidecar_bindings",
    "policy_id"
  ],
  "properties": {
    "schema_version": {
      "const": "adds.clinicaltrials-gov-harmonization-presence-spec.v1"
    },
    "report_id": { "$ref": "#/$defs/text" },
    "candidate_packet_sha256": { "$ref": "#/$defs/sha256" },
    "structure_report_sha256": { "$ref": "#/$defs/sha256" },
    "sidecar_bindings": {
      "type": "array",
      "minItems": 2,
      "maxItems": 256,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/binding" }
    },
    "policy_id": {
      "const": "adds.payload-free-source-presence-resolution.v1"
    }
  },
  "$defs": {
    "text": {
      "type": "string",
      "minLength": 1,
      "pattern": ".*\\S.*"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "nctId": {
      "type": "string",
      "pattern": "^NCT[0-9]{8}$"
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nct_id", "inventory_sha256", "sidecar_sha256"],
      "properties": {
        "nct_id": { "$ref": "#/$defs/nctId" },
        "inventory_sha256": { "$ref": "#/$defs/sha256" },
        "sidecar_sha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}

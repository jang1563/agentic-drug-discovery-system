{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jihunni/Agentic-Drug-Discovery-System/blob/main/rl_env/specs/frontier_private_calibration_preflight.schema.json",
  "title": "ADDS-Frontier private calibration automated preflight",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "preflight_id",
    "protocol_id",
    "board_id",
    "status",
    "run_on",
    "task_set_integrity_sha256",
    "oracle_set_integrity_sha256",
    "progress_integrity_sha256",
    "task_results",
    "aggregate",
    "human_review_required",
    "board_admission_unchanged",
    "baseline_model_runs_started",
    "benchmark_evidence_claimed",
    "nonclaims",
    "integrity_sha256"
  ],
  "properties": {
    "schema_version": {"const": "adds.frontier-private-calibration-preflight.v1"},
    "preflight_id": {"const": "adds-frontier-calibration-preflight-v1"},
    "protocol_id": {"const": "adds-frontier-v1"},
    "board_id": {"const": "adds-frontier-private-pilot-v1"},
    "status": {"const": "automated_preflight_complete_semantic_review_pending"},
    "run_on": {"type": "string", "format": "date"},
    "task_set_integrity_sha256": {"$ref": "#/$defs/sha256"},
    "oracle_set_integrity_sha256": {"$ref": "#/$defs/sha256"},
    "progress_integrity_sha256": {"$ref": "#/$defs/sha256"},
    "task_results": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": {"$ref": "#/$defs/taskResult"}
    },
    "aggregate": {"$ref": "#/$defs/aggregate"},
    "human_review_required": {"const": true},
    "board_admission_unchanged": {"const": true},
    "baseline_model_runs_started": {"const": false},
    "benchmark_evidence_claimed": {"const": false},
    "nonclaims": {
      "type": "array",
      "minItems": 4,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "integrity_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "componentResults": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "disposition_correct",
        "next_action_correct",
        "risk_flags_correct",
        "witness_valid",
        "blocker_certificate_valid"
      ],
      "properties": {
        "disposition_correct": {"const": true},
        "next_action_correct": {"const": true},
        "risk_flags_correct": {"const": true},
        "witness_valid": {"const": true},
        "blocker_certificate_valid": {"const": true}
      }
    },
    "stageResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stage_id", "component_results", "round_trip_passed"],
      "properties": {
        "stage_id": {"type": "string", "pattern": "^s0[1-6]$"},
        "component_results": {"$ref": "#/$defs/componentResults"},
        "round_trip_passed": {"const": true}
      }
    },
    "mutationResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mutation_id",
        "mutation_class",
        "probe_kind",
        "assessment_lane",
        "expected_contract_outcome",
        "observed_contract_outcome",
        "expected_outcome_matched",
        "validator_error_code",
        "expected_changed_components"
      ],
      "properties": {
        "mutation_id": {"type": "string", "minLength": 1},
        "mutation_class": {
          "enum": ["critical_flip", "nuisance_invariance", "evidence_ladder"]
        },
        "probe_kind": {
          "enum": [
            "source_id_rename",
            "critical_evidence_removal",
            "temporal_access_rebind",
            "bounded_evidence_reveal",
            "identity_rebind"
          ]
        },
        "assessment_lane": {
          "enum": ["machine_decidable", "semantic_review_required"]
        },
        "expected_contract_outcome": {
          "enum": [
            "valid_invariant",
            "fail_closed",
            "structurally_valid_semantic_outcome_unresolved"
          ]
        },
        "observed_contract_outcome": {
          "enum": [
            "valid_invariant",
            "fail_closed",
            "structurally_valid_semantic_outcome_unresolved"
          ]
        },
        "expected_outcome_matched": {"type": ["boolean", "null"]},
        "validator_error_code": {
          "type": ["string", "null"],
          "enum": [
            null,
            "invalid_evidence_graph_or_access",
            "post_cutoff_evidence_access"
          ]
        },
        "expected_changed_components": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "disposition",
              "next_action",
              "risk_flags",
              "witness",
              "blockers"
            ]
          }
        }
      }
    },
    "taskResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slot_id",
        "task_commitment",
        "oracle_commitment",
        "canonical_stage_results",
        "mutation_results"
      ],
      "properties": {
        "slot_id": {"type": "string", "pattern": "^slot-[a-z]+-[0-9]{2}$"},
        "task_commitment": {"$ref": "#/$defs/sha256"},
        "oracle_commitment": {"$ref": "#/$defs/sha256"},
        "canonical_stage_results": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "items": {"$ref": "#/$defs/stageResult"}
        },
        "mutation_results": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": {"$ref": "#/$defs/mutationResult"}
        }
      }
    },
    "probeKindCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id_rename",
        "critical_evidence_removal",
        "temporal_access_rebind",
        "bounded_evidence_reveal",
        "identity_rebind"
      ],
      "properties": {
        "source_id_rename": {"const": 10},
        "critical_evidence_removal": {"const": 10},
        "temporal_access_rebind": {"const": 10},
        "bounded_evidence_reveal": {"const": 10},
        "identity_rebind": {"const": 10}
      }
    },
    "aggregate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_count",
        "canonical_stage_count",
        "canonical_stage_pass_count",
        "mutation_probe_count",
        "machine_decidable_probe_count",
        "machine_expected_outcome_match_count",
        "semantic_review_required_probe_count",
        "structurally_accepted_semantic_probe_count",
        "probe_kind_counts"
      ],
      "properties": {
        "task_count": {"const": 10},
        "canonical_stage_count": {"const": 60},
        "canonical_stage_pass_count": {"const": 60},
        "mutation_probe_count": {"const": 50},
        "machine_decidable_probe_count": {"const": 30},
        "machine_expected_outcome_match_count": {"const": 30},
        "semantic_review_required_probe_count": {"const": 20},
        "structurally_accepted_semantic_probe_count": {"const": 20},
        "probe_kind_counts": {"$ref": "#/$defs/probeKindCounts"}
      }
    }
  }
}

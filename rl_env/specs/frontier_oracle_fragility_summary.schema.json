{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jihunni/Agentic-Drug-Discovery-System/blob/main/rl_env/specs/frontier_oracle_fragility_summary.schema.json",
  "title": "ADDS-Frontier payload-free oracle fragility summary",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "audit_id", "protocol_id", "board_id", "status", "compiled_on", "public_preflight_integrity_sha256", "private_report_commitment", "component_localization_rule", "support_selectivity_review_trigger", "lineage_redundancy_review_trigger", "canonical_stage_count", "planned_component_probe_count", "applicable_component_probe_count", "nonapplicable_component_probe_count", "component_localization_pass_count", "witness_saturated_stage_count", "task_wide_witness_saturation_count", "accessible_nonwitness_evidence_count", "repeated_lineage_witness_stage_count", "repeated_lineage_witness_id_count", "context_witness_stage_count", "derivative_witness_stage_count", "decision_record_witness_stage_count", "contradiction_witness_stage_count", "singleton_blocker_stage_count", "action_change_without_witness_delta_count", "witness_change_without_action_delta_count", "component_localization_ready", "support_selectivity_review_required", "lineage_redundancy_review_required", "oracle_support_ready_for_independent_challenge", "human_curation_required", "scientific_minimality_established", "independent_review_complete", "expert_solve_gate_changed", "admission_gate_changed", "board_admitted_count", "baseline_model_runs_started", "benchmark_evidence_claimed", "private_payload_published", "nonclaims", "integrity_sha256"],
  "properties": {
    "schema_version": {"const": "adds.frontier-oracle-fragility-summary.v1"},
    "audit_id": {"const": "adds-frontier-oracle-fragility-v1"},
    "protocol_id": {"const": "adds-frontier-v1"},
    "board_id": {"const": "adds-frontier-private-pilot-v1"},
    "status": {"enum": ["machine_audit_complete_support_ready", "machine_audit_complete_support_revision_required"]},
    "compiled_on": {"type": "string", "format": "date"},
    "public_preflight_integrity_sha256": {"$ref": "#/$defs/sha256"},
    "private_report_commitment": {"$ref": "#/$defs/sha256"},
    "component_localization_rule": {"const": "applicable_valid_mutation_fails_exactly_one_target_component"},
    "support_selectivity_review_trigger": {"const": "any_task_uses_all_accessible_evidence_as_witnesses_at_every_stage"},
    "lineage_redundancy_review_trigger": {"const": "any_stage_uses_multiple_witness_ids_from_the_same_lineage"},
    "canonical_stage_count": {"const": 60},
    "planned_component_probe_count": {"const": 300},
    "applicable_component_probe_count": {"type": "integer", "minimum": 0, "maximum": 300},
    "nonapplicable_component_probe_count": {"type": "integer", "minimum": 0, "maximum": 300},
    "component_localization_pass_count": {"type": "integer", "minimum": 0, "maximum": 300},
    "witness_saturated_stage_count": {"type": "integer", "minimum": 0, "maximum": 60},
    "task_wide_witness_saturation_count": {"type": "integer", "minimum": 0, "maximum": 10},
    "accessible_nonwitness_evidence_count": {"type": "integer", "minimum": 0},
    "repeated_lineage_witness_stage_count": {"type": "integer", "minimum": 0, "maximum": 60},
    "repeated_lineage_witness_id_count": {"type": "integer", "minimum": 0},
    "context_witness_stage_count": {"type": "integer", "minimum": 0, "maximum": 60},
    "derivative_witness_stage_count": {"type": "integer", "minimum": 0, "maximum": 60},
    "decision_record_witness_stage_count": {"type": "integer", "minimum": 0, "maximum": 60},
    "contradiction_witness_stage_count": {"type": "integer", "minimum": 0, "maximum": 60},
    "singleton_blocker_stage_count": {"type": "integer", "minimum": 0, "maximum": 60},
    "action_change_without_witness_delta_count": {"type": "integer", "minimum": 0, "maximum": 50},
    "witness_change_without_action_delta_count": {"type": "integer", "minimum": 0, "maximum": 50},
    "component_localization_ready": {"type": "boolean"},
    "support_selectivity_review_required": {"type": "boolean"},
    "lineage_redundancy_review_required": {"type": "boolean"},
    "oracle_support_ready_for_independent_challenge": {"type": "boolean"},
    "human_curation_required": {"type": "boolean"},
    "scientific_minimality_established": {"const": false},
    "independent_review_complete": {"const": false},
    "expert_solve_gate_changed": {"const": false},
    "admission_gate_changed": {"const": false},
    "board_admitted_count": {"const": 0},
    "baseline_model_runs_started": {"const": false},
    "benchmark_evidence_claimed": {"const": false},
    "private_payload_published": {"const": false},
    "nonclaims": {"type": "array", "minItems": 6, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "integrity_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}

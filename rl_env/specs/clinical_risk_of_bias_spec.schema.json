{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jang1563/agentic-drug-discovery-system/rl_env/specs/clinical_risk_of_bias_spec.schema.json",
  "title": "Outcome-specific clinical risk-of-bias assessment specification",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "analysis_id",
    "transport_analysis_id",
    "transport_report_integrity_sha256",
    "endpoint_family",
    "outcome_time_frame",
    "assessments",
    "review",
    "method_id"
  ],
  "properties": {
    "schema_version": {
      "const": "adds.clinical-risk-of-bias-spec.v2"
    },
    "analysis_id": {
      "type": "string",
      "minLength": 1
    },
    "transport_analysis_id": {
      "type": "string",
      "minLength": 1
    },
    "transport_report_integrity_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "endpoint_family": {
      "type": "string",
      "minLength": 1
    },
    "outcome_time_frame": {
      "type": "string",
      "minLength": 1
    },
    "assessments": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/trialAssessment"
      }
    },
    "review": {
      "$ref": "#/$defs/review"
    },
    "method_id": {
      "const": "adds.project-internal-outcome-specific-risk-of-bias.v2"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "reviewer_id",
        "reviewer_role",
        "reviewed_at",
        "independent_external_review"
      ],
      "properties": {
        "status": {
          "const": "approved_for_project_internal_risk_of_bias"
        },
        "reviewer_id": {
          "type": "string",
          "minLength": 1
        },
        "reviewer_role": {
          "type": "string",
          "minLength": 1
        },
        "reviewed_at": {
          "type": "string",
          "format": "date-time"
        },
        "independent_external_review": {
          "const": false
        }
      }
    },
    "citation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "citation_id",
        "source_role",
        "source_document_format",
        "source_locator",
        "source_content_sha256",
        "source_document_date",
        "source_field_pointer",
        "source_field_sha256",
        "source_page",
        "source_section",
        "source_excerpt"
      ],
      "properties": {
        "citation_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,127}$"
        },
        "source_role": {
          "enum": [
            "registry_results",
            "protocol_sap"
          ]
        },
        "source_document_format": {
          "enum": [
            "clinicaltrials.gov-study-v2",
            "application/pdf"
          ]
        },
        "source_locator": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "source_content_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "source_document_date": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "source_field_pointer": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_field_sha256": {
          "anyOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "source_page": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "source_section": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_excerpt": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "source_role": {
                "const": "registry_results"
              }
            }
          },
          "then": {
            "properties": {
              "source_document_format": {
                "const": "clinicaltrials.gov-study-v2"
              },
              "source_document_date": {
                "type": "null"
              },
              "source_field_pointer": {
                "type": "string",
                "pattern": "^/"
              },
              "source_field_sha256": {
                "$ref": "#/$defs/sha256"
              },
              "source_page": {
                "type": "null"
              },
              "source_section": {
                "type": "null"
              },
              "source_excerpt": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "source_role": {
                "const": "protocol_sap"
              }
            }
          },
          "then": {
            "properties": {
              "source_document_format": {
                "const": "application/pdf"
              },
              "source_document_date": {
                "type": "string",
                "format": "date"
              },
              "source_field_pointer": {
                "type": "null"
              },
              "source_field_sha256": {
                "type": "null"
              },
              "source_page": {
                "type": "integer",
                "minimum": 1
              },
              "source_section": {
                "type": "string",
                "minLength": 1
              },
              "source_excerpt": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    "domain": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "domain_id",
        "judgment",
        "rationale",
        "citation_ids"
      ],
      "properties": {
        "domain_id": {
          "enum": [
            "randomization_process",
            "deviations_from_intended_interventions",
            "missing_outcome_data",
            "measurement_of_the_outcome",
            "selection_of_the_reported_result"
          ]
        },
        "judgment": {
          "enum": [
            "low",
            "some_concerns",
            "high",
            "insufficient_information"
          ]
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "citation_ids": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "trialAssessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trial_id",
        "design_id",
        "endpoint_id",
        "outcome_source_pointer",
        "outcome_title",
        "candidate_result_group_id",
        "comparator_result_group_id",
        "candidate_flow_group_id",
        "comparator_flow_group_id",
        "candidate_flow_arm_title",
        "comparator_flow_arm_title",
        "candidate_result_arm_title",
        "comparator_result_arm_title",
        "observed_outcome_data_status",
        "analysis_plan_status",
        "citations",
        "domains",
        "overall_judgment",
        "unresolved_concerns"
      ],
      "properties": {
        "trial_id": {
          "type": "string",
          "pattern": "^NCT[0-9]{8}$"
        },
        "design_id": {
          "type": "string",
          "minLength": 1
        },
        "endpoint_id": {
          "type": "string",
          "minLength": 1
        },
        "outcome_source_pointer": {
          "type": "string",
          "pattern": "^/resultsSection/outcomeMeasuresModule/outcomeMeasures/(0|[1-9][0-9]*)$"
        },
        "outcome_title": {
          "type": "string",
          "minLength": 1
        },
        "candidate_result_group_id": {
          "type": "string",
          "minLength": 1
        },
        "comparator_result_group_id": {
          "type": "string",
          "minLength": 1
        },
        "candidate_flow_group_id": {
          "type": "string",
          "minLength": 1
        },
        "comparator_flow_group_id": {
          "type": "string",
          "minLength": 1
        },
        "candidate_flow_arm_title": {
          "type": "string",
          "minLength": 1
        },
        "comparator_flow_arm_title": {
          "type": "string",
          "minLength": 1
        },
        "candidate_result_arm_title": {
          "type": "string",
          "minLength": 1
        },
        "comparator_result_arm_title": {
          "type": "string",
          "minLength": 1
        },
        "observed_outcome_data_status": {
          "enum": [
            "complete_observed_outcome_data",
            "incomplete_observed_outcome_data",
            "observed_outcome_data_not_reported"
          ]
        },
        "analysis_plan_status": {
          "enum": [
            "final_pre_unblinding_plan_verified",
            "protocol_only_final_sap_unverified",
            "post_completion_or_unverified"
          ]
        },
        "citations": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/citation"
          }
        },
        "domains": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "uniqueItems": true,
          "prefixItems": [
            {
              "allOf": [
                {
                  "$ref": "#/$defs/domain"
                },
                {
                  "properties": {
                    "domain_id": {
                      "const": "randomization_process"
                    }
                  }
                }
              ]
            },
            {
              "allOf": [
                {
                  "$ref": "#/$defs/domain"
                },
                {
                  "properties": {
                    "domain_id": {
                      "const": "deviations_from_intended_interventions"
                    }
                  }
                }
              ]
            },
            {
              "allOf": [
                {
                  "$ref": "#/$defs/domain"
                },
                {
                  "properties": {
                    "domain_id": {
                      "const": "missing_outcome_data"
                    }
                  }
                }
              ]
            },
            {
              "allOf": [
                {
                  "$ref": "#/$defs/domain"
                },
                {
                  "properties": {
                    "domain_id": {
                      "const": "measurement_of_the_outcome"
                    }
                  }
                }
              ]
            },
            {
              "allOf": [
                {
                  "$ref": "#/$defs/domain"
                },
                {
                  "properties": {
                    "domain_id": {
                      "const": "selection_of_the_reported_result"
                    }
                  }
                }
              ]
            }
          ],
          "items": false
        },
        "overall_judgment": {
          "enum": [
            "low",
            "some_concerns",
            "high",
            "insufficient_information"
          ]
        },
        "unresolved_concerns": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}

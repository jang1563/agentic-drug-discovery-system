{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jihunni/Agentic-Drug-Discovery-System/blob/main/rl_env/specs/frontier_private_tokenizer_placebo_key_set.schema.json",
  "title": "ADDS-Frontier private tokenizer placebo key set",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "set_id", "protocol_id", "board_id", "compiled_on", "packet_set_integrity_sha256", "tokenizer_package", "tokenizer_package_version", "tokenizer_profiles", "evaluation_only_tokenizer_profiles", "keys", "arm_role_counts", "arm_role_balance_max_imbalance", "reviewer_assignment_count", "reviewer_response_count", "candidate_coupling_label_count", "placebo_invariance_label_count", "contrast_label_count", "consensus_label_count", "independent_review_complete", "integrity_sha256"],
  "properties": {
    "schema_version": {"const": "adds.frontier-private-tokenizer-placebo-key-set.v1"},
    "set_id": {"const": "adds-frontier-tokenizer-placebo-v1"},
    "protocol_id": {"const": "adds-frontier-v1"},
    "board_id": {"const": "adds-frontier-private-pilot-v1"},
    "compiled_on": {"type": "string", "format": "date"},
    "packet_set_integrity_sha256": {"$ref": "#/$defs/sha256"},
    "tokenizer_package": {"const": "tiktoken"},
    "tokenizer_package_version": {"const": "0.14.0"},
    "tokenizer_profiles": {"const": [
      {"encoding_name": "cl100k_base", "source_asset_url": "https://openaipublic.blob.core.windows.net/encodings/cl100k_base.tiktoken", "source_asset_sha256": "223921b76ee99bde995b7ff738513eef100fb51d18c93597a113bcffe865b2a7", "n_vocab": 100277, "mergeable_rank_count": 100256, "special_token_count": 5, "vocabulary_sha256": "c45339dd52b71083191b9547250f3447e45ed4d67d0560a28fe541700001acba"},
      {"encoding_name": "o200k_base", "source_asset_url": "https://openaipublic.blob.core.windows.net/encodings/o200k_base.tiktoken", "source_asset_sha256": "446a9538cb6c348e3516120d7c08b09f57c36495e2acfffe59a5bf8b0cfb1a2d", "n_vocab": 200019, "mergeable_rank_count": 199998, "special_token_count": 2, "vocabulary_sha256": "9eff60a5f9a550b06572a296a42915e5c7b9c5393ad7e5584abb614d6d95d172"}
    ]},
    "evaluation_only_tokenizer_profiles": {"const": [
      {"encoding_name": "r50k_base", "source_asset_url": "https://openaipublic.blob.core.windows.net/encodings/r50k_base.tiktoken", "source_asset_sha256": "306cd27f03c1a714eca7108e03d66b7dc042abe8c258b44c199a7ed9838dd930", "n_vocab": 50257, "mergeable_rank_count": 50256, "special_token_count": 1, "vocabulary_sha256": "fc1756df0d0abea2568bfef979a26c563381b7144f6bac10aac4a20e8f29e674"},
      {"encoding_name": "p50k_base", "source_asset_url": "https://openaipublic.blob.core.windows.net/encodings/p50k_base.tiktoken", "source_asset_sha256": "94b5ca7dff4d00767bc256fdd1b27e5b17361d7b8a5f968547f9f23eb70d2069", "n_vocab": 50281, "mergeable_rank_count": 50280, "special_token_count": 1, "vocabulary_sha256": "514697bc24623b6a2fdbba7f0ca3e170cf2530092ad251a0050b1333097ac765"}
    ]},
    "keys": {"type": "array", "minItems": 10, "maxItems": 10, "items": {"$ref": "#/$defs/key"}},
    "arm_role_counts": {"const": {
      "canonical": {"arm_a": 2, "arm_b": 2, "arm_c": 2, "arm_d": 2, "arm_e": 2},
      "candidate": {"arm_a": 2, "arm_b": 2, "arm_c": 2, "arm_d": 2, "arm_e": 2},
      "placebo_transport": {"arm_a": 2, "arm_b": 2, "arm_c": 2, "arm_d": 2, "arm_e": 2},
      "placebo_schema": {"arm_a": 2, "arm_b": 2, "arm_c": 2, "arm_d": 2, "arm_e": 2},
      "placebo_audit": {"arm_a": 2, "arm_b": 2, "arm_c": 2, "arm_d": 2, "arm_e": 2}
    }},
    "arm_role_balance_max_imbalance": {"const": 0},
    "reviewer_assignment_count": {"const": 0},
    "reviewer_response_count": {"const": 0},
    "candidate_coupling_label_count": {"const": 0},
    "placebo_invariance_label_count": {"const": 0},
    "contrast_label_count": {"const": 0},
    "consensus_label_count": {"const": 0},
    "independent_review_complete": {"const": false},
    "integrity_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "arm_id": {"enum": ["arm_a", "arm_b", "arm_c", "arm_d", "arm_e"]},
    "certificate": {
      "type": "object", "additionalProperties": false,
      "required": ["probe_kind", "changed_top_level_fields", "added_evidence_node_count", "removed_evidence_node_count", "modified_existing_evidence_node_count", "changed_stage_access_count", "non_access_stage_field_change_count", "lineage_edge_change_count", "exact_delta_passed"],
      "properties": {
        "probe_kind": {"const": "bounded_evidence_reveal"},
        "changed_top_level_fields": {"const": ["evidence_nodes", "stages"]},
        "added_evidence_node_count": {"const": 1},
        "removed_evidence_node_count": {"const": 0},
        "modified_existing_evidence_node_count": {"const": 0},
        "changed_stage_access_count": {"const": 3},
        "non_access_stage_field_change_count": {"const": 0},
        "lineage_edge_change_count": {"const": 0},
        "exact_delta_passed": {"const": true}
      }
    },
    "fingerprint": {
      "type": "object", "additionalProperties": false,
      "required": ["added_node_field_names", "added_node_available_on", "added_node_evidence_role", "added_node_lineage_independent_from_canonical", "changed_stage_ids", "access_delta_counts", "added_node_appended_at_end"],
      "properties": {
        "added_node_field_names": {"const": ["available_on", "evidence_id", "evidence_role", "evidence_summary", "lineage_id"]},
        "added_node_available_on": {"type": "string", "format": "date"},
        "added_node_evidence_role": {"const": "source"},
        "added_node_lineage_independent_from_canonical": {"const": true},
        "changed_stage_ids": {"const": ["s04", "s05", "s06"]},
        "access_delta_counts": {"const": [1, 1, 1]},
        "added_node_appended_at_end": {"const": [true, true, true]}
      }
    },
    "components": {
      "type": "array", "minItems": 2, "uniqueItems": true,
      "items": {"enum": ["disposition", "next_action", "risk_flags", "witness", "blockers"]},
      "allOf": [{"contains": {"const": "next_action"}}, {"contains": {"const": "witness"}}]
    },
    "token_counts": {
      "type": "object", "additionalProperties": false,
      "required": ["cl100k_base", "o200k_base"],
      "properties": {
        "cl100k_base": {"type": "integer", "minimum": 1},
        "o200k_base": {"type": "integer", "minimum": 1}
      }
    },
    "component_distance": {
      "type": "object", "additionalProperties": false,
      "required": ["token_byte_length_l1_distance", "token_rank_decile_l1_distance", "combined_l1_distance"],
      "properties": {
        "token_byte_length_l1_distance": {"type": "integer", "minimum": 0},
        "token_rank_decile_l1_distance": {"type": "integer", "minimum": 0},
        "combined_l1_distance": {"type": "integer", "minimum": 0}
      }
    },
    "encoding_distances": {
      "type": "object", "additionalProperties": false,
      "required": ["cl100k_base", "o200k_base"],
      "properties": {
        "cl100k_base": {"$ref": "#/$defs/component_distance"},
        "o200k_base": {"$ref": "#/$defs/component_distance"}
      }
    },
    "profile_component_distances": {
      "type": "object", "additionalProperties": false,
      "required": ["baseline", "optimized"],
      "properties": {
        "baseline": {"$ref": "#/$defs/encoding_distances"},
        "optimized": {"$ref": "#/$defs/encoding_distances"}
      }
    },
    "heldout_token_gaps": {
      "type": "object", "additionalProperties": false,
      "required": ["r50k_base", "p50k_base"],
      "properties": {
        "r50k_base": {"type": "integer", "minimum": 0},
        "p50k_base": {"type": "integer", "minimum": 0}
      }
    },
    "heldout_token_gap_sets": {
      "type": "object", "additionalProperties": false,
      "required": ["baseline", "optimized"],
      "properties": {
        "baseline": {"$ref": "#/$defs/heldout_token_gaps"},
        "optimized": {"$ref": "#/$defs/heldout_token_gaps"}
      }
    },
    "heldout_encoding_distances": {
      "type": "object", "additionalProperties": false,
      "required": ["r50k_base", "p50k_base"],
      "properties": {
        "r50k_base": {"$ref": "#/$defs/component_distance"},
        "p50k_base": {"$ref": "#/$defs/component_distance"}
      }
    },
    "heldout_profile_component_distances": {
      "type": "object", "additionalProperties": false,
      "required": ["baseline", "optimized"],
      "properties": {
        "baseline": {"$ref": "#/$defs/heldout_encoding_distances"},
        "optimized": {"$ref": "#/$defs/heldout_encoding_distances"}
      }
    },
    "placebo": {
      "type": "object", "additionalProperties": false,
      "required": ["family_id", "placebo_task_commitment", "placebo_intended_changed_components", "placebo_structural_delta_certificate", "placebo_structural_fingerprint", "candidate_placebo_structural_match_passed", "whitespace_token_count_matched", "candidate_token_counts", "placebo_token_counts", "exact_token_count_match_count", "token_byte_length_histogram_match_count", "token_rank_decile_histogram_match_count", "baseline_profile_l1_distance", "optimized_profile_l1_distance", "profile_l1_distance_reduction", "profile_component_distances", "profile_component_comparison_count", "profile_component_nonregression_count", "profile_component_strict_improvement_count", "profile_encoding_comparison_count", "profile_encoding_nonregression_count", "strict_profile_improvement_passed", "distribution_optimization_acceptance_passed", "heldout_trial_zero_summary_commitment", "heldout_token_count_absolute_gaps", "heldout_exact_token_count_match_count_baseline", "heldout_exact_token_count_match_count_optimized", "heldout_token_byte_length_histogram_match_count_baseline", "heldout_token_byte_length_histogram_match_count_optimized", "heldout_token_rank_decile_histogram_match_count_baseline", "heldout_token_rank_decile_histogram_match_count_optimized", "heldout_profile_l1_distance_baseline", "heldout_profile_l1_distance_optimized", "heldout_profile_l1_distance_reduction", "heldout_profile_component_distances", "heldout_profile_encoding_comparison_count", "heldout_profile_encoding_nonregression_count", "heldout_profile_encoding_strict_improvement_count", "heldout_profile_component_comparison_count", "heldout_profile_component_nonregression_count", "heldout_profile_component_strict_improvement_count", "heldout_token_count_gap_comparison_count", "heldout_token_count_gap_nonregression_count", "heldout_token_count_gap_strict_improvement_count", "heldout_all_profile_nonregression_passed", "heldout_all_profile_strict_improvement_passed", "profile_search_trials", "vocabulary_family_policy_passed", "tokenizer_count_match_established", "tokenizer_distribution_match_established", "placebo_scientific_invariance_established"],
      "properties": {
        "family_id": {"enum": ["placebo_transport", "placebo_schema", "placebo_audit"]},
        "placebo_task_commitment": {"$ref": "#/$defs/sha256"},
        "placebo_intended_changed_components": {"const": []},
        "placebo_structural_delta_certificate": {"$ref": "#/$defs/certificate"},
        "placebo_structural_fingerprint": {"$ref": "#/$defs/fingerprint"},
        "candidate_placebo_structural_match_passed": {"const": true},
        "whitespace_token_count_matched": {"const": true},
        "candidate_token_counts": {"$ref": "#/$defs/token_counts"},
        "placebo_token_counts": {"$ref": "#/$defs/token_counts"},
        "exact_token_count_match_count": {"const": 2},
        "token_byte_length_histogram_match_count": {"const": 0},
        "token_rank_decile_histogram_match_count": {"const": 0},
        "baseline_profile_l1_distance": {"type": "integer", "minimum": 1},
        "optimized_profile_l1_distance": {"type": "integer", "minimum": 0},
        "profile_l1_distance_reduction": {"type": "integer", "minimum": 1},
        "profile_component_distances": {"$ref": "#/$defs/profile_component_distances"},
        "profile_component_comparison_count": {"const": 4},
        "profile_component_nonregression_count": {"const": 4},
        "profile_component_strict_improvement_count": {"type": "integer", "minimum": 1, "maximum": 4},
        "profile_encoding_comparison_count": {"const": 2},
        "profile_encoding_nonregression_count": {"const": 2},
        "strict_profile_improvement_passed": {"const": true},
        "distribution_optimization_acceptance_passed": {"const": true},
        "heldout_trial_zero_summary_commitment": {"$ref": "#/$defs/sha256"},
        "heldout_token_count_absolute_gaps": {"$ref": "#/$defs/heldout_token_gap_sets"},
        "heldout_exact_token_count_match_count_baseline": {"type": "integer", "minimum": 0, "maximum": 2},
        "heldout_exact_token_count_match_count_optimized": {"type": "integer", "minimum": 0, "maximum": 2},
        "heldout_token_byte_length_histogram_match_count_baseline": {"type": "integer", "minimum": 0, "maximum": 2},
        "heldout_token_byte_length_histogram_match_count_optimized": {"type": "integer", "minimum": 0, "maximum": 2},
        "heldout_token_rank_decile_histogram_match_count_baseline": {"type": "integer", "minimum": 0, "maximum": 2},
        "heldout_token_rank_decile_histogram_match_count_optimized": {"type": "integer", "minimum": 0, "maximum": 2},
        "heldout_profile_l1_distance_baseline": {"type": "integer", "minimum": 0},
        "heldout_profile_l1_distance_optimized": {"type": "integer", "minimum": 0},
        "heldout_profile_l1_distance_reduction": {"type": "integer"},
        "heldout_profile_component_distances": {"$ref": "#/$defs/heldout_profile_component_distances"},
        "heldout_profile_encoding_comparison_count": {"const": 2},
        "heldout_profile_encoding_nonregression_count": {"type": "integer", "minimum": 0, "maximum": 2},
        "heldout_profile_encoding_strict_improvement_count": {"type": "integer", "minimum": 0, "maximum": 2},
        "heldout_profile_component_comparison_count": {"const": 4},
        "heldout_profile_component_nonregression_count": {"type": "integer", "minimum": 0, "maximum": 4},
        "heldout_profile_component_strict_improvement_count": {"type": "integer", "minimum": 0, "maximum": 4},
        "heldout_token_count_gap_comparison_count": {"const": 2},
        "heldout_token_count_gap_nonregression_count": {"type": "integer", "minimum": 0, "maximum": 2},
        "heldout_token_count_gap_strict_improvement_count": {"type": "integer", "minimum": 0, "maximum": 2},
        "heldout_all_profile_nonregression_passed": {"type": "boolean"},
        "heldout_all_profile_strict_improvement_passed": {"type": "boolean"},
        "profile_search_trials": {"const": 512},
        "vocabulary_family_policy_passed": {"const": true},
        "tokenizer_count_match_established": {"const": true},
        "tokenizer_distribution_match_established": {"const": false},
        "placebo_scientific_invariance_established": {"const": false}
      }
    },
    "key": {
      "type": "object", "additionalProperties": false,
      "required": ["packet_id", "slot_id", "source_coupled_placebo_packet_id", "canonical_arm", "candidate_arm", "placebo_transport_arm", "placebo_schema_arm", "placebo_audit_arm", "canonical_task_commitment", "candidate_task_commitment", "candidate_expected_changed_components", "candidate_structural_delta_certificate", "candidate_structural_fingerprint", "placebos", "candidate_scientific_coupling_established", "contrast_identifiability_established"],
      "properties": {
        "packet_id": {"type": "string", "pattern": "^tokenizer-placebo-[0-9a-f]{20}$"},
        "slot_id": {"type": "string", "pattern": "^slot-[a-z]+-[0-9]{2}$"},
        "source_coupled_placebo_packet_id": {"type": "string", "pattern": "^placebo-[0-9a-f]{20}$"},
        "canonical_arm": {"$ref": "#/$defs/arm_id"},
        "candidate_arm": {"$ref": "#/$defs/arm_id"},
        "placebo_transport_arm": {"$ref": "#/$defs/arm_id"},
        "placebo_schema_arm": {"$ref": "#/$defs/arm_id"},
        "placebo_audit_arm": {"$ref": "#/$defs/arm_id"},
        "canonical_task_commitment": {"$ref": "#/$defs/sha256"},
        "candidate_task_commitment": {"$ref": "#/$defs/sha256"},
        "candidate_expected_changed_components": {"$ref": "#/$defs/components"},
        "candidate_structural_delta_certificate": {"$ref": "#/$defs/certificate"},
        "candidate_structural_fingerprint": {"$ref": "#/$defs/fingerprint"},
        "placebos": {
          "type": "array", "minItems": 3, "maxItems": 3,
          "items": {"$ref": "#/$defs/placebo"},
          "allOf": [
            {"contains": {"type": "object", "required": ["family_id"], "properties": {"family_id": {"const": "placebo_transport"}}}},
            {"contains": {"type": "object", "required": ["family_id"], "properties": {"family_id": {"const": "placebo_schema"}}}},
            {"contains": {"type": "object", "required": ["family_id"], "properties": {"family_id": {"const": "placebo_audit"}}}}
          ]
        },
        "candidate_scientific_coupling_established": {"const": false},
        "contrast_identifiability_established": {"const": false}
      }
    }
  }
}

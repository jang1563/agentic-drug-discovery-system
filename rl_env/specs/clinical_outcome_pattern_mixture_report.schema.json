{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jang1563/agentic-drug-discovery-system/rl_env/specs/clinical_outcome_pattern_mixture_report.schema.json",
  "title": "Clinical Outcome Pattern-Mixture Report",
  "description": "Aggregate deterministic recovery and identification diagnostics for a preregistered prediction-stratified binary log-IMOR grid.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "integrity_sha256", "report"],
  "properties": {
    "schema_version": {
      "const": "adds.clinical-outcome-pattern-mixture-report.v1"
    },
    "integrity_sha256": {"$ref": "#/$defs/sha256"},
    "report": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol_id",
        "protocol_fingerprint",
        "stress_protocol_id",
        "stress_protocol_fingerprint",
        "stress_report_fingerprint",
        "method_id",
        "rng_method_id",
        "replicates",
        "log_imor_grid",
        "monte_carlo_confidence_level",
        "minimum_analyzable_rate",
        "maximum_mean_identification_width",
        "maximum_absolute_bias",
        "scenario_results",
        "aggregate_simulation_only",
        "replicate_level_records_included",
        "unit_level_records_included",
        "real_clinical_outcomes_included",
        "automatic_missingness_correction_included",
        "sampling_uncertainty_intervals_included",
        "latent_truth_recovery_diagnostic_included",
        "operational_estimate_uses_latent_truth",
        "limitations"
      ],
      "properties": {
        "protocol_id": {"type": "string", "minLength": 1},
        "protocol_fingerprint": {"$ref": "#/$defs/sha256"},
        "stress_protocol_id": {"type": "string", "minLength": 1},
        "stress_protocol_fingerprint": {"$ref": "#/$defs/sha256"},
        "stress_report_fingerprint": {"$ref": "#/$defs/sha256"},
        "method_id": {
          "const": "adds.pattern-mixture.binary-log-imor-prediction-stratified.v1"
        },
        "rng_method_id": {
          "const": "adds.mt19937-block-polya-urn-informative-evaluability.v1"
        },
        "replicates": {"type": "integer", "minimum": 1, "maximum": 100000},
        "log_imor_grid": {"$ref": "#/$defs/logImorGrid"},
        "monte_carlo_confidence_level": {
          "type": "number",
          "exclusiveMinimum": 0.5,
          "exclusiveMaximum": 1.0
        },
        "minimum_analyzable_rate": {
          "type": "number",
          "exclusiveMinimum": 0.0,
          "maximum": 1.0
        },
        "maximum_mean_identification_width": {
          "type": "number",
          "exclusiveMinimum": 0.0,
          "maximum": 2.0
        },
        "maximum_absolute_bias": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 2.0
        },
        "scenario_results": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "items": {"$ref": "#/$defs/scenarioResult"}
        },
        "aggregate_simulation_only": {"const": true},
        "replicate_level_records_included": {"const": false},
        "unit_level_records_included": {"const": false},
        "real_clinical_outcomes_included": {"const": false},
        "automatic_missingness_correction_included": {"const": false},
        "sampling_uncertainty_intervals_included": {"const": false},
        "latent_truth_recovery_diagnostic_included": {"const": true},
        "operational_estimate_uses_latent_truth": {"const": false},
        "limitations": {
          "type": "array",
          "minItems": 10,
          "maxItems": 10,
          "items": {"type": "string", "minLength": 1}
        }
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "nullableMetric": {
      "anyOf": [
        {"type": "number", "minimum": -2.0, "maximum": 2.0},
        {"type": "null"}
      ]
    },
    "nullableNonNegativeMetric": {
      "anyOf": [
        {"type": "number", "minimum": 0.0, "maximum": 2.0},
        {"type": "null"}
      ]
    },
    "logImorGrid": {
      "type": "array",
      "minItems": 3,
      "maxItems": 33,
      "uniqueItems": true,
      "items": {"type": "number", "minimum": -8.0, "maximum": 8.0}
    },
    "rate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_count",
        "total_count",
        "rate",
        "lower",
        "upper",
        "confidence_level"
      ],
      "properties": {
        "event_count": {"type": "integer", "minimum": 0},
        "total_count": {"type": "integer", "minimum": 0},
        "rate": {
          "anyOf": [
            {"type": "number", "minimum": 0.0, "maximum": 1.0},
            {"type": "null"}
          ]
        },
        "lower": {
          "anyOf": [
            {"type": "number", "minimum": 0.0, "maximum": 1.0},
            {"type": "null"}
          ]
        },
        "upper": {
          "anyOf": [
            {"type": "number", "minimum": 0.0, "maximum": 1.0},
            {"type": "null"}
          ]
        },
        "confidence_level": {
          "type": "number",
          "exclusiveMinimum": 0.5,
          "exclusiveMaximum": 1.0
        }
      }
    },
    "stage": {
      "enum": [
        "disease_context",
        "target_nomination",
        "modality_selection",
        "candidate_generation",
        "lead_optimization",
        "preclinical_validation",
        "clinical_strategy",
        "regulatory_postmarket"
      ]
    },
    "metric": {
      "enum": [
        "observed_favorable_rate",
        "policy_a_brier_score",
        "policy_b_brier_score",
        "policy_a_calibration_in_the_large",
        "policy_b_calibration_in_the_large",
        "policy_a_classification_accuracy",
        "policy_b_classification_accuracy",
        "brier_difference_b_minus_a"
      ]
    },
    "statusCounts": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "prefixItems": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "count"],
          "properties": {
            "status": {"const": "computed"},
            "count": {"type": "integer", "minimum": 0}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "count"],
          "properties": {
            "status": {"const": "empty_reference_stratum"},
            "count": {"type": "integer", "minimum": 0}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "count"],
          "properties": {
            "status": {"const": "degenerate_reference_stratum"},
            "count": {"type": "integer", "minimum": 0}
          }
        }
      ],
      "items": false
    },
    "gridPerformance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "log_imor",
        "informative_missingness_odds_ratio",
        "population_true_value",
        "estimate_count",
        "mean_estimate",
        "population_bias",
        "population_root_mean_squared_error"
      ],
      "properties": {
        "log_imor": {"type": "number", "minimum": -8.0, "maximum": 8.0},
        "informative_missingness_odds_ratio": {
          "type": "number",
          "exclusiveMinimum": 0.0
        },
        "population_true_value": {
          "type": "number",
          "minimum": -1.0,
          "maximum": 1.0
        },
        "estimate_count": {"type": "integer", "minimum": 0},
        "mean_estimate": {"$ref": "#/$defs/nullableMetric"},
        "population_bias": {"$ref": "#/$defs/nullableMetric"},
        "population_root_mean_squared_error": {
          "$ref": "#/$defs/nullableNonNegativeMetric"
        }
      }
    },
    "metricPerformance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metric",
        "replicate_count",
        "analyzable_replicates",
        "population_true_value",
        "evaluable_true_value",
        "naive_mean_estimate",
        "naive_population_bias",
        "naive_population_root_mean_squared_error",
        "naive_evaluable_bias",
        "naive_evaluable_root_mean_squared_error",
        "truth_aligned_mean_estimate",
        "truth_aligned_population_bias",
        "truth_aligned_population_root_mean_squared_error",
        "sensitivity_envelope_inclusion",
        "mean_sensitivity_envelope_lower",
        "mean_sensitivity_envelope_upper",
        "mean_sensitivity_envelope_width",
        "population_truth_distance_to_mean_envelope",
        "maximum_absolute_bias",
        "maximum_mean_identification_width",
        "evaluable_calibration_met",
        "truth_aligned_recovery_met",
        "population_truth_recovered_by_mean_envelope",
        "identification_target_met",
        "grid_performance"
      ],
      "properties": {
        "metric": {"$ref": "#/$defs/metric"},
        "replicate_count": {"type": "integer", "minimum": 1},
        "analyzable_replicates": {"type": "integer", "minimum": 0},
        "population_true_value": {
          "type": "number",
          "minimum": -1.0,
          "maximum": 1.0
        },
        "evaluable_true_value": {
          "type": "number",
          "minimum": -1.0,
          "maximum": 1.0
        },
        "naive_mean_estimate": {"$ref": "#/$defs/nullableMetric"},
        "naive_population_bias": {"$ref": "#/$defs/nullableMetric"},
        "naive_population_root_mean_squared_error": {
          "$ref": "#/$defs/nullableNonNegativeMetric"
        },
        "naive_evaluable_bias": {"$ref": "#/$defs/nullableMetric"},
        "naive_evaluable_root_mean_squared_error": {
          "$ref": "#/$defs/nullableNonNegativeMetric"
        },
        "truth_aligned_mean_estimate": {"$ref": "#/$defs/nullableMetric"},
        "truth_aligned_population_bias": {"$ref": "#/$defs/nullableMetric"},
        "truth_aligned_population_root_mean_squared_error": {
          "$ref": "#/$defs/nullableNonNegativeMetric"
        },
        "sensitivity_envelope_inclusion": {"$ref": "#/$defs/rate"},
        "mean_sensitivity_envelope_lower": {"$ref": "#/$defs/nullableMetric"},
        "mean_sensitivity_envelope_upper": {"$ref": "#/$defs/nullableMetric"},
        "mean_sensitivity_envelope_width": {
          "$ref": "#/$defs/nullableNonNegativeMetric"
        },
        "population_truth_distance_to_mean_envelope": {
          "$ref": "#/$defs/nullableNonNegativeMetric"
        },
        "maximum_absolute_bias": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 2.0
        },
        "maximum_mean_identification_width": {
          "type": "number",
          "exclusiveMinimum": 0.0,
          "maximum": 2.0
        },
        "evaluable_calibration_met": {"type": "boolean"},
        "truth_aligned_recovery_met": {"type": "boolean"},
        "population_truth_recovered_by_mean_envelope": {"type": "boolean"},
        "identification_target_met": {"type": "boolean"},
        "grid_performance": {
          "type": "array",
          "minItems": 3,
          "maxItems": 33,
          "items": {"$ref": "#/$defs/gridPerformance"}
        }
      }
    },
    "scenarioResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scenario_id",
        "stage",
        "endpoint_family",
        "population_favorable_prevalence",
        "evaluable_favorable_prevalence",
        "expected_evaluable_probability",
        "true_log_imor",
        "true_informative_missingness_odds_ratio",
        "grid_brackets_true_log_imor",
        "replicate_count",
        "status_counts",
        "analyzable_rate",
        "metric_performance",
        "analyzable_target_met",
        "all_evaluable_calibration_targets_met",
        "all_truth_aligned_recovery_targets_met",
        "all_identification_targets_met",
        "research_target_met",
        "rng_stream_sha256",
        "outcome_rng_stream_sha256",
        "evaluability_rng_stream_sha256"
      ],
      "properties": {
        "scenario_id": {"type": "string", "minLength": 1},
        "stage": {"$ref": "#/$defs/stage"},
        "endpoint_family": {"type": "string", "minLength": 1},
        "population_favorable_prevalence": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "evaluable_favorable_prevalence": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "expected_evaluable_probability": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "true_log_imor": {
          "type": "number",
          "minimum": -8.0,
          "maximum": 8.0
        },
        "true_informative_missingness_odds_ratio": {
          "type": "number",
          "exclusiveMinimum": 0.0
        },
        "grid_brackets_true_log_imor": {"type": "boolean"},
        "replicate_count": {"type": "integer", "minimum": 1},
        "status_counts": {"$ref": "#/$defs/statusCounts"},
        "analyzable_rate": {"$ref": "#/$defs/rate"},
        "metric_performance": {
          "type": "array",
          "minItems": 8,
          "maxItems": 8,
          "items": {"$ref": "#/$defs/metricPerformance"}
        },
        "analyzable_target_met": {"type": "boolean"},
        "all_evaluable_calibration_targets_met": {"type": "boolean"},
        "all_truth_aligned_recovery_targets_met": {"type": "boolean"},
        "all_identification_targets_met": {"type": "boolean"},
        "research_target_met": {"type": "boolean"},
        "rng_stream_sha256": {"$ref": "#/$defs/sha256"},
        "outcome_rng_stream_sha256": {"$ref": "#/$defs/sha256"},
        "evaluability_rng_stream_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}

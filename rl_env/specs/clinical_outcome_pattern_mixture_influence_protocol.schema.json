{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jang1563/agentic-drug-discovery-system/rl_env/specs/clinical_outcome_pattern_mixture_influence_protocol.schema.json",
  "title": "Clinical Outcome Pattern-Mixture Influence Calibration Protocol",
  "description": "Preregistered unequal-cluster interval calibration protocol bound to exact synthetic stress and pattern-mixture artifacts.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "integrity_sha256", "protocol"],
  "properties": {
    "schema_version": {
      "const": "adds.clinical-outcome-pattern-mixture-influence-calibration-protocol.v1"
    },
    "integrity_sha256": {"$ref": "#/$defs/sha256"},
    "protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol_id",
        "version",
        "registered_on",
        "stress_protocol_fingerprint",
        "pattern_mixture_protocol_fingerprint",
        "pattern_mixture_report_fingerprint",
        "methods",
        "confidence_level",
        "monte_carlo_confidence_level",
        "coverage_tolerance",
        "minimum_interval_yield",
        "minimum_production_clusters",
        "maximum_production_cluster_unit_fraction",
        "maximum_standard_error_calibration_deviation",
        "multiplier_draws",
        "multiplier_seed",
        "primary_metric",
        "method_id",
        "metadata"
      ],
      "properties": {
        "protocol_id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "registered_on": {"type": "string", "format": "date"},
        "stress_protocol_fingerprint": {"$ref": "#/$defs/sha256"},
        "pattern_mixture_protocol_fingerprint": {"$ref": "#/$defs/sha256"},
        "pattern_mixture_report_fingerprint": {"$ref": "#/$defs/sha256"},
        "methods": {"$ref": "#/$defs/methodOrder"},
        "confidence_level": {
          "type": "number",
          "exclusiveMinimum": 0.5,
          "exclusiveMaximum": 1.0
        },
        "monte_carlo_confidence_level": {
          "type": "number",
          "exclusiveMinimum": 0.5,
          "exclusiveMaximum": 1.0
        },
        "coverage_tolerance": {
          "type": "number",
          "minimum": 0.0,
          "exclusiveMaximum": 1.0
        },
        "minimum_interval_yield": {
          "type": "number",
          "exclusiveMinimum": 0.0,
          "maximum": 1.0
        },
        "minimum_production_clusters": {"type": "integer", "minimum": 3},
        "maximum_production_cluster_unit_fraction": {
          "type": "number",
          "exclusiveMinimum": 0.0,
          "exclusiveMaximum": 1.0
        },
        "maximum_standard_error_calibration_deviation": {
          "type": "number",
          "exclusiveMinimum": 0.0,
          "maximum": 1.0
        },
        "multiplier_draws": {
          "type": "integer",
          "minimum": 99,
          "maximum": 9999,
          "not": {"multipleOf": 2}
        },
        "multiplier_seed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "primary_metric": {"$ref": "#/$defs/metric"},
        "method_id": {
          "const": "adds.pattern-mixture.unequal-cluster-influence-calibration.v1"
        },
        "metadata": {"type": "object"}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "methodOrder": {
      "const": [
        "delete_one_normal",
        "delete_one_student_t",
        "delete_mj_student_t",
        "delete_mj_webb_multiplier"
      ]
    },
    "metric": {
      "enum": [
        "observed_favorable_rate",
        "policy_a_brier_score",
        "policy_b_brier_score",
        "policy_a_calibration_in_the_large",
        "policy_b_calibration_in_the_large",
        "policy_a_classification_accuracy",
        "policy_b_classification_accuracy",
        "brier_difference_b_minus_a"
      ]
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jang1563/agentic-drug-discovery-system/rl_env/specs/clinical_outcome_stress_simulation_summary.schema.json",
  "title": "Clinical Outcome Stress Simulation Summary",
  "description": "Compact human- and machine-readable estimand-shift and dependence-closure comparison.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "integrity_sha256",
    "protocol_id",
    "protocol_fingerprint",
    "simulation_method_id",
    "rng_method_id",
    "uncertainty_method_id",
    "analysis_modes",
    "estimand_targets",
    "confidence_level",
    "monte_carlo_confidence_level",
    "replicates",
    "coverage_target",
    "minimum_interval_yield",
    "scenario_count",
    "scenario_analysis_gate_count",
    "design_target_met_counts",
    "scenarios",
    "aggregate_simulation_only",
    "replicate_level_records_included",
    "unit_level_records_included",
    "real_clinical_outcomes_included",
    "automatic_gate_selection_included",
    "automatic_missingness_correction_included"
  ],
  "properties": {
    "schema_version": {
      "const": "adds.clinical-outcome-stress-simulation-summary.v1"
    },
    "integrity_sha256": {"$ref": "#/$defs/sha256"},
    "protocol_id": {"type": "string", "minLength": 1},
    "protocol_fingerprint": {"$ref": "#/$defs/sha256"},
    "simulation_method_id": {
      "const": "adds.prospective-clinical-outcome-stress.informative-evaluability-dependence.v1"
    },
    "rng_method_id": {
      "const": "adds.mt19937-block-polya-urn-informative-evaluability.v1"
    },
    "uncertainty_method_id": {
      "const": "adds.cluster-robust-clinical-outcome-uncertainty.cr1.v1"
    },
    "analysis_modes": {"$ref": "#/$defs/analysisModes"},
    "estimand_targets": {"$ref": "#/$defs/estimandTargets"},
    "confidence_level": {
      "type": "number",
      "exclusiveMinimum": 0.5,
      "exclusiveMaximum": 1.0
    },
    "monte_carlo_confidence_level": {
      "type": "number",
      "exclusiveMinimum": 0.5,
      "exclusiveMaximum": 1.0
    },
    "replicates": {"type": "integer", "minimum": 1},
    "coverage_target": {"type": "number", "minimum": 0.0, "maximum": 1.0},
    "minimum_interval_yield": {
      "type": "number",
      "exclusiveMinimum": 0.0,
      "maximum": 1.0
    },
    "scenario_count": {"type": "integer", "minimum": 1},
    "scenario_analysis_gate_count": {"type": "integer", "minimum": 2},
    "design_target_met_counts": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {"$ref": "#/$defs/targetCount"}
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {"$ref": "#/$defs/scenarioSummary"}
    },
    "aggregate_simulation_only": {"const": true},
    "replicate_level_records_included": {"const": false},
    "unit_level_records_included": {"const": false},
    "real_clinical_outcomes_included": {"const": false},
    "automatic_gate_selection_included": {"const": false},
    "automatic_missingness_correction_included": {"const": false}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "numberOrNull": {"type": ["number", "null"]},
    "probabilityOrNull": {
      "type": ["number", "null"],
      "minimum": 0.0,
      "maximum": 1.0
    },
    "analysisMode": {
      "enum": ["nominal_clusters", "dependence_closed_clusters"]
    },
    "estimandTarget": {"enum": ["population", "evaluable"]},
    "analysisModes": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "prefixItems": [
        {"const": "nominal_clusters"},
        {"const": "dependence_closed_clusters"}
      ],
      "items": false
    },
    "estimandTargets": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "prefixItems": [
        {"const": "population"},
        {"const": "evaluable"}
      ],
      "items": false
    },
    "metric": {
      "enum": [
        "observed_favorable_rate",
        "policy_a_brier_score",
        "policy_b_brier_score",
        "policy_a_calibration_in_the_large",
        "policy_b_calibration_in_the_large",
        "policy_a_classification_accuracy",
        "policy_b_classification_accuracy",
        "brier_difference_b_minus_a"
      ]
    },
    "targetCount": {
      "type": "object",
      "additionalProperties": false,
      "required": ["analysis_mode", "estimand_target", "count"],
      "properties": {
        "analysis_mode": {"$ref": "#/$defs/analysisMode"},
        "estimand_target": {"$ref": "#/$defs/estimandTarget"},
        "count": {"type": "integer", "minimum": 0}
      }
    },
    "statusCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cluster_robust_interval_computed",
        "not_estimable_no_evaluable_units",
        "not_estimable_insufficient_clusters",
        "not_estimable_dominant_cluster",
        "not_estimable_zero_cluster_variance"
      ],
      "properties": {
        "cluster_robust_interval_computed": {"type": "integer", "minimum": 0},
        "not_estimable_no_evaluable_units": {"type": "integer", "minimum": 0},
        "not_estimable_insufficient_clusters": {"type": "integer", "minimum": 0},
        "not_estimable_dominant_cluster": {"type": "integer", "minimum": 0},
        "not_estimable_zero_cluster_variance": {"type": "integer", "minimum": 0}
      }
    },
    "rateProjection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["events", "total", "rate", "lower", "upper"],
      "properties": {
        "events": {"type": "integer", "minimum": 0},
        "total": {"type": "integer", "minimum": 0},
        "rate": {"$ref": "#/$defs/probabilityOrNull"},
        "lower": {"$ref": "#/$defs/probabilityOrNull"},
        "upper": {"$ref": "#/$defs/probabilityOrNull"}
      }
    },
    "metricProjection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metric",
        "true_value",
        "coverage",
        "interval_yield",
        "mean_estimate",
        "bias",
        "root_mean_squared_error",
        "empirical_standard_deviation",
        "mean_reported_standard_error",
        "mean_interval_width",
        "mean_se_to_empirical_sd_ratio",
        "status_counts"
      ],
      "properties": {
        "metric": {"$ref": "#/$defs/metric"},
        "true_value": {"type": "number", "minimum": -1.0, "maximum": 1.0},
        "coverage": {"$ref": "#/$defs/rateProjection"},
        "interval_yield": {"$ref": "#/$defs/rateProjection"},
        "mean_estimate": {"$ref": "#/$defs/numberOrNull"},
        "bias": {"$ref": "#/$defs/numberOrNull"},
        "root_mean_squared_error": {"$ref": "#/$defs/numberOrNull"},
        "empirical_standard_deviation": {"$ref": "#/$defs/numberOrNull"},
        "mean_reported_standard_error": {"$ref": "#/$defs/numberOrNull"},
        "mean_interval_width": {"$ref": "#/$defs/numberOrNull"},
        "mean_se_to_empirical_sd_ratio": {"$ref": "#/$defs/numberOrNull"},
        "status_counts": {"$ref": "#/$defs/statusCounts"}
      }
    },
    "targetSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "estimand_target",
        "all_metric_coverage_targets_met",
        "design_target_met",
        "metrics"
      ],
      "properties": {
        "estimand_target": {"$ref": "#/$defs/estimandTarget"},
        "all_metric_coverage_targets_met": {"type": "boolean"},
        "design_target_met": {"type": "boolean"},
        "metrics": {
          "type": "array",
          "minItems": 8,
          "maxItems": 8,
          "items": {"$ref": "#/$defs/metricProjection"}
        }
      }
    },
    "gateSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gate_id",
        "minimum_evaluable_clusters",
        "maximum_evaluable_cluster_fraction",
        "diagnostic_interval_eligibility",
        "diagnostic_status_counts",
        "coverage_target",
        "minimum_interval_yield",
        "all_metric_yield_targets_met",
        "estimand_targets"
      ],
      "properties": {
        "gate_id": {"type": "string", "minLength": 1},
        "minimum_evaluable_clusters": {"type": "integer", "minimum": 2},
        "maximum_evaluable_cluster_fraction": {
          "type": "number",
          "exclusiveMinimum": 0.0,
          "exclusiveMaximum": 1.0
        },
        "diagnostic_interval_eligibility": {"$ref": "#/$defs/rateProjection"},
        "diagnostic_status_counts": {"$ref": "#/$defs/statusCounts"},
        "coverage_target": {"type": "number", "minimum": 0.0, "maximum": 1.0},
        "minimum_interval_yield": {
          "type": "number",
          "exclusiveMinimum": 0.0,
          "maximum": 1.0
        },
        "all_metric_yield_targets_met": {"type": "boolean"},
        "estimand_targets": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {"$ref": "#/$defs/targetSummary"}
        }
      }
    },
    "structure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cluster_count",
        "total_units",
        "minimum_cluster_size",
        "maximum_cluster_size",
        "mean_cluster_size",
        "cluster_size_coefficient_of_variation",
        "maximum_cluster_fraction",
        "effective_cluster_count"
      ],
      "properties": {
        "cluster_count": {"type": "integer", "minimum": 1},
        "total_units": {"type": "integer", "minimum": 1},
        "minimum_cluster_size": {"type": "integer", "minimum": 1},
        "maximum_cluster_size": {"type": "integer", "minimum": 1},
        "mean_cluster_size": {"type": "number", "minimum": 1.0},
        "cluster_size_coefficient_of_variation": {"type": "number", "minimum": 0.0},
        "maximum_cluster_fraction": {"type": "number", "minimum": 0.0, "maximum": 1.0},
        "effective_cluster_count": {"type": "number", "minimum": 1.0}
      }
    },
    "replicateDiagnostics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "replicate_count",
        "no_evaluable_replicates",
        "mean_evaluable_units",
        "minimum_evaluable_units",
        "maximum_evaluable_units",
        "mean_evaluable_cluster_count",
        "minimum_evaluable_cluster_count",
        "maximum_evaluable_cluster_count",
        "mean_largest_evaluable_cluster_fraction",
        "maximum_largest_evaluable_cluster_fraction"
      ],
      "properties": {
        "replicate_count": {"type": "integer", "minimum": 1},
        "no_evaluable_replicates": {"type": "integer", "minimum": 0},
        "mean_evaluable_units": {"type": "number", "minimum": 0.0},
        "minimum_evaluable_units": {"type": "integer", "minimum": 0},
        "maximum_evaluable_units": {"type": "integer", "minimum": 0},
        "mean_evaluable_cluster_count": {"type": "number", "minimum": 0.0},
        "minimum_evaluable_cluster_count": {"type": "integer", "minimum": 0},
        "maximum_evaluable_cluster_count": {"type": "integer", "minimum": 0},
        "mean_largest_evaluable_cluster_fraction": {"$ref": "#/$defs/probabilityOrNull"},
        "maximum_largest_evaluable_cluster_fraction": {"$ref": "#/$defs/probabilityOrNull"}
      }
    },
    "gateIdLists": {
      "type": "object",
      "additionalProperties": false,
      "required": ["population", "evaluable"],
      "properties": {
        "population": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "evaluable": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "analysisSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "analysis_mode",
        "cluster_structure",
        "replicate_diagnostics",
        "candidate_gates",
        "target_met_gate_ids",
        "evaluable_not_population_target_met_gate_ids"
      ],
      "properties": {
        "analysis_mode": {"$ref": "#/$defs/analysisMode"},
        "cluster_structure": {"$ref": "#/$defs/structure"},
        "replicate_diagnostics": {"$ref": "#/$defs/replicateDiagnostics"},
        "candidate_gates": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {"$ref": "#/$defs/gateSummary"}
        },
        "target_met_gate_ids": {"$ref": "#/$defs/gateIdLists"},
        "evaluable_not_population_target_met_gate_ids": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "metricTruth": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metric",
        "population_value",
        "evaluable_value",
        "evaluable_minus_population"
      ],
      "properties": {
        "metric": {"$ref": "#/$defs/metric"},
        "population_value": {"type": "number", "minimum": -1.0, "maximum": 1.0},
        "evaluable_value": {"type": "number", "minimum": -1.0, "maximum": 1.0},
        "evaluable_minus_population": {"type": "number", "minimum": -2.0, "maximum": 2.0}
      }
    },
    "truthSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "population_favorable_prevalence",
        "expected_evaluable_probability",
        "evaluable_favorable_prevalence",
        "metric_truths"
      ],
      "properties": {
        "population_favorable_prevalence": {"type": "number", "minimum": 0.0, "maximum": 1.0},
        "expected_evaluable_probability": {"type": "number", "exclusiveMinimum": 0.0, "maximum": 1.0},
        "evaluable_favorable_prevalence": {"type": "number", "minimum": 0.0, "maximum": 1.0},
        "metric_truths": {
          "type": "array",
          "minItems": 8,
          "maxItems": 8,
          "items": {"$ref": "#/$defs/metricTruth"}
        }
      }
    },
    "stressors": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outcome_dependent_evaluability",
        "cross_nominal_cluster_dependence",
        "nominal_cluster_count",
        "dependence_block_count",
        "favorable_evaluable_probability",
        "unfavorable_evaluable_probability",
        "dependence_block_intraclass_correlation"
      ],
      "properties": {
        "outcome_dependent_evaluability": {"type": "boolean"},
        "cross_nominal_cluster_dependence": {"type": "boolean"},
        "nominal_cluster_count": {"type": "integer", "minimum": 2},
        "dependence_block_count": {"type": "integer", "minimum": 1},
        "favorable_evaluable_probability": {"type": "number", "minimum": 0.0, "maximum": 1.0},
        "unfavorable_evaluable_probability": {"type": "number", "minimum": 0.0, "maximum": 1.0},
        "dependence_block_intraclass_correlation": {"type": "number", "minimum": 0.0, "exclusiveMaximum": 1.0}
      }
    },
    "scenarioSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scenario_id",
        "stage",
        "endpoint_family",
        "stressors",
        "truth",
        "analysis_results",
        "dependence_closure_recovery_gate_ids"
      ],
      "properties": {
        "scenario_id": {"type": "string", "minLength": 1},
        "stage": {"type": "string", "minLength": 1},
        "endpoint_family": {"type": "string", "minLength": 1},
        "stressors": {"$ref": "#/$defs/stressors"},
        "truth": {"$ref": "#/$defs/truthSummary"},
        "analysis_results": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {"$ref": "#/$defs/analysisSummary"}
        },
        "dependence_closure_recovery_gate_ids": {"$ref": "#/$defs/gateIdLists"}
      }
    }
  }
}

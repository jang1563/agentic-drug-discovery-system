{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jang1563/agentic-drug-discovery-system/rl_env/specs/clinical_outcome_design_simulation_summary.schema.json",
  "title": "Clinical Outcome Design Simulation Summary",
  "description": "Compact human- and machine-readable clustered-board design simulation and optional replay-validation status.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "integrity_sha256",
    "protocol_id",
    "protocol_fingerprint",
    "simulation_method_id",
    "rng_method_id",
    "uncertainty_method_id",
    "iid_reference_method_id",
    "confidence_level",
    "monte_carlo_confidence_level",
    "replicates",
    "coverage_target",
    "minimum_interval_yield",
    "scenario_count",
    "scenario_gate_pair_count",
    "target_met_scenario_gate_pair_count",
    "scenarios",
    "aggregate_simulation_only",
    "replicate_level_records_included",
    "unit_level_records_included",
    "real_clinical_outcomes_included",
    "automatic_gate_selection_included"
  ],
  "properties": {
    "schema_version": {"const": "adds.clinical-outcome-design-simulation-summary.v1"},
    "integrity_sha256": {"$ref": "#/$defs/sha256"},
    "protocol_id": {"type": "string", "minLength": 1},
    "protocol_fingerprint": {"$ref": "#/$defs/sha256"},
    "simulation_method_id": {"const": "adds.prospective-clinical-outcome-design.beta-binomial.v1"},
    "rng_method_id": {"const": "adds.mt19937-polya-urn.v1"},
    "uncertainty_method_id": {"const": "adds.cluster-robust-clinical-outcome-uncertainty.cr1.v1"},
    "iid_reference_method_id": {"const": "adds.iid-unit-normal-reference.v1"},
    "confidence_level": {"type": "number", "exclusiveMinimum": 0.5, "exclusiveMaximum": 1.0},
    "monte_carlo_confidence_level": {"type": "number", "exclusiveMinimum": 0.5, "exclusiveMaximum": 1.0},
    "replicates": {"type": "integer", "minimum": 100, "maximum": 100000},
    "coverage_target": {"type": "number", "minimum": 0.0, "maximum": 1.0},
    "minimum_interval_yield": {"type": "number", "exclusiveMinimum": 0.0, "maximum": 1.0},
    "scenario_count": {"type": "integer", "minimum": 1, "maximum": 128},
    "scenario_gate_pair_count": {"type": "integer", "minimum": 1, "maximum": 8192},
    "target_met_scenario_gate_pair_count": {"type": "integer", "minimum": 0, "maximum": 8192},
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {"$ref": "#/$defs/scenarioSummary"}
    },
    "aggregate_simulation_only": {"const": true},
    "replicate_level_records_included": {"const": false},
    "unit_level_records_included": {"const": false},
    "real_clinical_outcomes_included": {"const": false},
    "automatic_gate_selection_included": {"const": false},
    "validation": {"$ref": "#/$defs/validation"}
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "nullableNumber": {"type": ["number", "null"]},
    "nullableMetricNumber": {
      "anyOf": [
        {"type": "number", "minimum": -1.0, "maximum": 1.0},
        {"type": "null"}
      ]
    },
    "nullableNonNegativeNumber": {
      "anyOf": [
        {"type": "number", "minimum": 0.0},
        {"type": "null"}
      ]
    },
    "rateProjection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["events", "total", "rate", "lower", "upper"],
      "properties": {
        "events": {"type": "integer", "minimum": 0},
        "total": {"type": "integer", "minimum": 0},
        "rate": {"anyOf": [{"type": "number", "minimum": 0.0, "maximum": 1.0}, {"type": "null"}]},
        "lower": {"anyOf": [{"type": "number", "minimum": 0.0, "maximum": 1.0}, {"type": "null"}]},
        "upper": {"anyOf": [{"type": "number", "minimum": 0.0, "maximum": 1.0}, {"type": "null"}]}
      }
    },
    "statusCountMap": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cluster_robust_interval_computed",
        "not_estimable_no_evaluable_units",
        "not_estimable_insufficient_clusters",
        "not_estimable_dominant_cluster",
        "not_estimable_zero_cluster_variance"
      ],
      "properties": {
        "cluster_robust_interval_computed": {"type": "integer", "minimum": 0},
        "not_estimable_no_evaluable_units": {"type": "integer", "minimum": 0},
        "not_estimable_insufficient_clusters": {"type": "integer", "minimum": 0},
        "not_estimable_dominant_cluster": {"type": "integer", "minimum": 0},
        "not_estimable_zero_cluster_variance": {"type": "integer", "minimum": 0}
      }
    },
    "metricProjection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metric",
        "true_value",
        "coverage",
        "interval_yield",
        "mean_estimate",
        "bias",
        "root_mean_squared_error",
        "empirical_standard_deviation",
        "mean_reported_standard_error",
        "mean_interval_width",
        "mean_se_to_empirical_sd_ratio",
        "status_counts"
      ],
      "properties": {
        "metric": {
          "enum": [
            "observed_favorable_rate",
            "policy_a_brier_score",
            "policy_b_brier_score",
            "policy_a_calibration_in_the_large",
            "policy_b_calibration_in_the_large",
            "policy_a_classification_accuracy",
            "policy_b_classification_accuracy",
            "brier_difference_b_minus_a"
          ]
        },
        "true_value": {"type": "number", "minimum": -1.0, "maximum": 1.0},
        "coverage": {"$ref": "#/$defs/rateProjection"},
        "interval_yield": {"$ref": "#/$defs/rateProjection"},
        "mean_estimate": {"$ref": "#/$defs/nullableMetricNumber"},
        "bias": {"$ref": "#/$defs/nullableNumber"},
        "root_mean_squared_error": {"$ref": "#/$defs/nullableNonNegativeNumber"},
        "empirical_standard_deviation": {"$ref": "#/$defs/nullableNonNegativeNumber"},
        "mean_reported_standard_error": {"$ref": "#/$defs/nullableNonNegativeNumber"},
        "mean_interval_width": {"$ref": "#/$defs/nullableNonNegativeNumber"},
        "mean_se_to_empirical_sd_ratio": {"$ref": "#/$defs/nullableNonNegativeNumber"},
        "status_counts": {"$ref": "#/$defs/statusCountMap"}
      }
    },
    "clusterDesign": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cluster_count",
        "total_units",
        "minimum_cluster_size",
        "maximum_cluster_size",
        "mean_cluster_size",
        "cluster_size_coefficient_of_variation",
        "maximum_cluster_fraction",
        "effective_cluster_count"
      ],
      "properties": {
        "cluster_count": {"type": "integer", "minimum": 2},
        "total_units": {"type": "integer", "minimum": 2},
        "minimum_cluster_size": {"type": "integer", "minimum": 1},
        "maximum_cluster_size": {"type": "integer", "minimum": 1},
        "mean_cluster_size": {"type": "number", "minimum": 1.0},
        "cluster_size_coefficient_of_variation": {"type": "number", "minimum": 0.0},
        "maximum_cluster_fraction": {"type": "number", "exclusiveMinimum": 0.0, "maximum": 1.0},
        "effective_cluster_count": {"type": "number", "minimum": 1.0}
      }
    },
    "replicateDiagnostics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "replicate_count",
        "no_evaluable_replicates",
        "mean_evaluable_units",
        "minimum_evaluable_units",
        "maximum_evaluable_units",
        "mean_evaluable_cluster_count",
        "minimum_evaluable_cluster_count",
        "maximum_evaluable_cluster_count",
        "mean_largest_evaluable_cluster_fraction",
        "maximum_largest_evaluable_cluster_fraction"
      ],
      "properties": {
        "replicate_count": {"type": "integer", "minimum": 100},
        "no_evaluable_replicates": {"type": "integer", "minimum": 0},
        "mean_evaluable_units": {"type": "number", "minimum": 0.0},
        "minimum_evaluable_units": {"type": "integer", "minimum": 0},
        "maximum_evaluable_units": {"type": "integer", "minimum": 0},
        "mean_evaluable_cluster_count": {"type": "number", "minimum": 0.0},
        "minimum_evaluable_cluster_count": {"type": "integer", "minimum": 0},
        "maximum_evaluable_cluster_count": {"type": "integer", "minimum": 0},
        "mean_largest_evaluable_cluster_fraction": {"anyOf": [{"type": "number", "minimum": 0.0, "maximum": 1.0}, {"type": "null"}]},
        "maximum_largest_evaluable_cluster_fraction": {"anyOf": [{"type": "number", "minimum": 0.0, "maximum": 1.0}, {"type": "null"}]}
      }
    },
    "dataGeneratingParameters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "favorable_prevalence",
        "intracluster_correlation",
        "evaluable_probability",
        "classification_threshold",
        "policy_a_probability_pattern",
        "policy_b_probability_pattern"
      ],
      "properties": {
        "favorable_prevalence": {"type": "number", "exclusiveMinimum": 0.0, "exclusiveMaximum": 1.0},
        "intracluster_correlation": {"type": "number", "minimum": 0.0, "exclusiveMaximum": 1.0},
        "evaluable_probability": {"type": "number", "exclusiveMinimum": 0.0, "maximum": 1.0},
        "classification_threshold": {"type": "number", "minimum": 0.0, "maximum": 1.0},
        "policy_a_probability_pattern": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"type": "number", "minimum": 0.0, "maximum": 1.0}},
        "policy_b_probability_pattern": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"type": "number", "minimum": 0.0, "maximum": 1.0}}
      }
    },
    "iidReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method_id", "metrics"],
      "properties": {
        "method_id": {"const": "adds.iid-unit-normal-reference.v1"},
        "metrics": {"type": "array", "minItems": 8, "maxItems": 8, "items": {"$ref": "#/$defs/metricProjection"}}
      }
    },
    "candidateGate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gate_id",
        "minimum_evaluable_clusters",
        "maximum_evaluable_cluster_fraction",
        "diagnostic_interval_eligibility",
        "diagnostic_status_counts",
        "coverage_target",
        "minimum_interval_yield",
        "all_metric_coverage_targets_met",
        "all_metric_yield_targets_met",
        "design_target_met",
        "metrics"
      ],
      "properties": {
        "gate_id": {"type": "string", "minLength": 1},
        "minimum_evaluable_clusters": {"type": "integer", "minimum": 2},
        "maximum_evaluable_cluster_fraction": {"type": "number", "exclusiveMinimum": 0.0, "exclusiveMaximum": 1.0},
        "diagnostic_interval_eligibility": {"$ref": "#/$defs/rateProjection"},
        "diagnostic_status_counts": {"$ref": "#/$defs/statusCountMap"},
        "coverage_target": {"type": "number", "minimum": 0.0, "maximum": 1.0},
        "minimum_interval_yield": {"type": "number", "exclusiveMinimum": 0.0, "maximum": 1.0},
        "all_metric_coverage_targets_met": {"type": "boolean"},
        "all_metric_yield_targets_met": {"type": "boolean"},
        "design_target_met": {"type": "boolean"},
        "metrics": {"type": "array", "minItems": 8, "maxItems": 8, "items": {"$ref": "#/$defs/metricProjection"}}
      }
    },
    "scenarioSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scenario_id",
        "stage",
        "endpoint_family",
        "data_generating_parameters",
        "cluster_design",
        "replicate_diagnostics",
        "iid_reference",
        "candidate_gates",
        "target_met_gate_ids"
      ],
      "properties": {
        "scenario_id": {"type": "string", "minLength": 1},
        "stage": {
          "enum": [
            "disease_context",
            "target_nomination",
            "modality_selection",
            "candidate_generation",
            "lead_optimization",
            "preclinical_validation",
            "clinical_strategy",
            "regulatory_postmarket"
          ]
        },
        "endpoint_family": {"type": "string", "minLength": 1},
        "data_generating_parameters": {"$ref": "#/$defs/dataGeneratingParameters"},
        "cluster_design": {"$ref": "#/$defs/clusterDesign"},
        "replicate_diagnostics": {"$ref": "#/$defs/replicateDiagnostics"},
        "iid_reference": {"$ref": "#/$defs/iidReference"},
        "candidate_gates": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"$ref": "#/$defs/candidateGate"}},
        "target_met_gate_ids": {"type": "array", "maxItems": 64, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "scope", "failure_codes"],
      "properties": {
        "status": {"enum": ["valid", "invalid"]},
        "scope": {"type": "string", "minLength": 1},
        "failure_codes": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
      }
    }
  }
}

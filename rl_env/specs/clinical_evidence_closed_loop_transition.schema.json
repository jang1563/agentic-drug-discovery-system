{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jang1563/agentic-drug-discovery-system/rl_env/specs/clinical_evidence_closed_loop_transition.schema.json",
  "title": "Provenance-preserving clinical evidence closed-loop transition",
  "description": "Integrity-bound selected-action execution, compact tool receipts, bounded reviewer refresh, exact source rejoin, and policy-relative before/after decision packages. ADVANCE is not a clinical recommendation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "integrity_sha256",
    "transition"
  ],
  "properties": {
    "schema_version": {
      "const": "adds.clinical-evidence-closed-loop-transition.v1"
    },
    "integrity_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "transition": {
      "$ref": "#/$defs/transition"
    }
  },
  "$defs": {
    "text": {
      "type": "string",
      "minLength": 1
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "datetime": {
      "type": "string",
      "format": "date-time"
    },
    "nonNegativeInteger": {
      "type": "integer",
      "minimum": 0
    },
    "positiveInteger": {
      "type": "integer",
      "minimum": 1
    },
    "nonNegativeNumber": {
      "type": "number",
      "minimum": 0
    },
    "positiveNumber": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "stage": {
      "enum": [
        "disease_context",
        "target_nomination",
        "modality_selection",
        "candidate_generation",
        "lead_optimization",
        "preclinical_validation",
        "clinical_strategy",
        "regulatory_postmarket"
      ]
    },
    "acquisitionActionType": {
      "enum": [
        "retrieve_evidence",
        "query_database",
        "run_verifier"
      ]
    },
    "decision": {
      "enum": [
        "advance",
        "hold",
        "defer"
      ]
    },
    "toolStatus": {
      "enum": [
        "succeeded",
        "unavailable",
        "failed"
      ]
    },
    "executionMode": {
      "enum": [
        "live",
        "cache",
        "local",
        "replay",
        "unknown"
      ]
    },
    "gapCode": {
      "enum": [
        "insufficient_independent_trials",
        "benefit_not_demonstrated",
        "benefit_direction_conflict",
        "benefit_harm_signal",
        "imprecise_benefit_estimate",
        "higher_observed_serious_event_risk",
        "safety_direction_conflict",
        "insufficient_safety_exposure",
        "endpoint_timeframe_mismatch",
        "safety_timeframe_mismatch",
        "measurement_unit_mismatch"
      ]
    },
    "textArray": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/text"
      }
    },
    "hashArray": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/sha256"
      }
    },
    "gapCodeArray": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/gapCode"
      }
    },
    "closedLoopPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_id",
        "version",
        "registered_on",
        "max_refresh_runs",
        "max_refresh_actions",
        "max_refresh_cost",
        "require_committed_runs",
        "require_refresh_verifier_actions",
        "require_new_source_provenance_for_resolution",
        "consume_attempted_actions",
        "provider_auto_decision_prohibited",
        "terminal_decisions_prohibited",
        "workflow_scope",
        "metadata"
      ],
      "properties": {
        "policy_id": {
          "$ref": "#/$defs/text"
        },
        "version": {
          "$ref": "#/$defs/text"
        },
        "registered_on": {
          "$ref": "#/$defs/date"
        },
        "max_refresh_runs": {
          "$ref": "#/$defs/positiveInteger"
        },
        "max_refresh_actions": {
          "$ref": "#/$defs/positiveInteger"
        },
        "max_refresh_cost": {
          "$ref": "#/$defs/nonNegativeNumber"
        },
        "require_committed_runs": {
          "const": true
        },
        "require_refresh_verifier_actions": {
          "const": true
        },
        "require_new_source_provenance_for_resolution": {
          "const": true
        },
        "consume_attempted_actions": {
          "const": true
        },
        "provider_auto_decision_prohibited": {
          "const": true
        },
        "terminal_decisions_prohibited": {
          "const": true
        },
        "workflow_scope": {
          "const": "evidence_workflow_only"
        },
        "metadata": {
          "type": "object"
        }
      }
    },
    "executionCall": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rank",
        "call_id",
        "action_id",
        "action_fingerprint",
        "selection_fingerprint",
        "targeted_gap_codes",
        "targeted_gap_ids",
        "tool_id",
        "operation",
        "action_type",
        "purpose",
        "arguments",
        "max_cost"
      ],
      "properties": {
        "rank": {
          "$ref": "#/$defs/positiveInteger"
        },
        "call_id": {
          "$ref": "#/$defs/text"
        },
        "action_id": {
          "$ref": "#/$defs/text"
        },
        "action_fingerprint": {
          "$ref": "#/$defs/sha256"
        },
        "selection_fingerprint": {
          "$ref": "#/$defs/sha256"
        },
        "targeted_gap_codes": {
          "allOf": [
            {
              "$ref": "#/$defs/gapCodeArray"
            },
            {
              "minItems": 1
            }
          ]
        },
        "targeted_gap_ids": {
          "allOf": [
            {
              "$ref": "#/$defs/textArray"
            },
            {
              "minItems": 1
            }
          ]
        },
        "tool_id": {
          "$ref": "#/$defs/text"
        },
        "operation": {
          "$ref": "#/$defs/text"
        },
        "action_type": {
          "$ref": "#/$defs/acquisitionActionType"
        },
        "purpose": {
          "$ref": "#/$defs/text"
        },
        "arguments": {
          "type": "object"
        },
        "max_cost": {
          "$ref": "#/$defs/positiveNumber"
        }
      }
    },
    "executionBatch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "batch_id",
        "method_id",
        "program_id",
        "expected_state_version",
        "as_of_date",
        "stage",
        "decision_package_id",
        "decision_package_fingerprint",
        "tensor_id",
        "tensor_fingerprint",
        "plan_id",
        "plan_fingerprint",
        "decision_policy_id",
        "decision_policy_version",
        "decision_policy_fingerprint",
        "closed_loop_policy",
        "calls",
        "max_steps",
        "max_total_cost",
        "workflow_scope",
        "provider_auto_decision_issued"
      ],
      "properties": {
        "batch_id": {
          "$ref": "#/$defs/text"
        },
        "method_id": {
          "const": "adds.bounded-clinical-evidence-execution.v1"
        },
        "program_id": {
          "$ref": "#/$defs/text"
        },
        "expected_state_version": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "as_of_date": {
          "$ref": "#/$defs/date"
        },
        "stage": {
          "$ref": "#/$defs/stage"
        },
        "decision_package_id": {
          "$ref": "#/$defs/text"
        },
        "decision_package_fingerprint": {
          "$ref": "#/$defs/sha256"
        },
        "tensor_id": {
          "$ref": "#/$defs/text"
        },
        "tensor_fingerprint": {
          "$ref": "#/$defs/sha256"
        },
        "plan_id": {
          "$ref": "#/$defs/text"
        },
        "plan_fingerprint": {
          "$ref": "#/$defs/sha256"
        },
        "decision_policy_id": {
          "$ref": "#/$defs/text"
        },
        "decision_policy_version": {
          "$ref": "#/$defs/text"
        },
        "decision_policy_fingerprint": {
          "$ref": "#/$defs/sha256"
        },
        "closed_loop_policy": {
          "$ref": "#/$defs/closedLoopPolicy"
        },
        "calls": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/executionCall"
          }
        },
        "max_steps": {
          "$ref": "#/$defs/positiveInteger"
        },
        "max_total_cost": {
          "$ref": "#/$defs/positiveNumber"
        },
        "workflow_scope": {
          "const": "evidence_workflow_only"
        },
        "provider_auto_decision_issued": {
          "const": false
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "source_version",
        "locator",
        "content_hash"
      ],
      "properties": {
        "source_id": {
          "$ref": "#/$defs/text"
        },
        "source_version": {
          "$ref": "#/$defs/text"
        },
        "locator": {
          "$ref": "#/$defs/text"
        },
        "content_hash": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "toolOutcomeReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "call_id",
        "program_id",
        "request_id",
        "request_fingerprint",
        "expected_state_version",
        "stage",
        "tool_id",
        "operation",
        "action_type",
        "purpose",
        "arguments",
        "max_cost",
        "request_created_at",
        "contract_id",
        "status",
        "execution_mode",
        "payload_sha256",
        "source_mode",
        "sources",
        "cost",
        "completed_at",
        "error_code",
        "accepted_packet_id",
        "action_ledger_id",
        "evidence_ids"
      ],
      "properties": {
        "call_id": {
          "$ref": "#/$defs/text"
        },
        "program_id": {
          "$ref": "#/$defs/text"
        },
        "request_id": {
          "$ref": "#/$defs/text"
        },
        "request_fingerprint": {
          "$ref": "#/$defs/sha256"
        },
        "expected_state_version": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "stage": {
          "$ref": "#/$defs/stage"
        },
        "tool_id": {
          "$ref": "#/$defs/text"
        },
        "operation": {
          "$ref": "#/$defs/text"
        },
        "action_type": {
          "$ref": "#/$defs/acquisitionActionType"
        },
        "purpose": {
          "$ref": "#/$defs/text"
        },
        "arguments": {
          "type": "object"
        },
        "max_cost": {
          "$ref": "#/$defs/nonNegativeNumber"
        },
        "request_created_at": {
          "$ref": "#/$defs/datetime"
        },
        "contract_id": {
          "$ref": "#/$defs/text"
        },
        "status": {
          "$ref": "#/$defs/toolStatus"
        },
        "execution_mode": {
          "$ref": "#/$defs/executionMode"
        },
        "payload_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "source_mode": {
          "enum": [
            "provider_declared",
            "payload_fallback"
          ]
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/source"
          }
        },
        "cost": {
          "$ref": "#/$defs/nonNegativeNumber"
        },
        "completed_at": {
          "$ref": "#/$defs/datetime"
        },
        "error_code": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/text"
            }
          ]
        },
        "accepted_packet_id": {
          "$ref": "#/$defs/text"
        },
        "action_ledger_id": {
          "$ref": "#/$defs/text"
        },
        "evidence_ids": {
          "$ref": "#/$defs/textArray"
        }
      }
    },
    "selectedActionReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rank",
        "action_id",
        "action_fingerprint",
        "selection_fingerprint",
        "targeted_gap_codes",
        "targeted_gap_ids",
        "outcome"
      ],
      "properties": {
        "rank": {
          "$ref": "#/$defs/positiveInteger"
        },
        "action_id": {
          "$ref": "#/$defs/text"
        },
        "action_fingerprint": {
          "$ref": "#/$defs/sha256"
        },
        "selection_fingerprint": {
          "$ref": "#/$defs/sha256"
        },
        "targeted_gap_codes": {
          "allOf": [
            {
              "$ref": "#/$defs/gapCodeArray"
            },
            {
              "minItems": 1
            }
          ]
        },
        "targeted_gap_ids": {
          "allOf": [
            {
              "$ref": "#/$defs/textArray"
            },
            {
              "minItems": 1
            }
          ]
        },
        "outcome": {
          "$ref": "#/$defs/toolOutcomeReceipt"
        }
      }
    },
    "refreshRunReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id",
        "plan_id",
        "initial_state_version",
        "final_state_version",
        "stage",
        "accepted_packet_id",
        "decision",
        "outcomes",
        "promotion_codes",
        "action_cost"
      ],
      "properties": {
        "run_id": {
          "$ref": "#/$defs/text"
        },
        "plan_id": {
          "$ref": "#/$defs/text"
        },
        "initial_state_version": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "final_state_version": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "stage": {
          "$ref": "#/$defs/stage"
        },
        "accepted_packet_id": {
          "$ref": "#/$defs/text"
        },
        "decision": {
          "const": "hold"
        },
        "outcomes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "allOf": [
              {
                "$ref": "#/$defs/toolOutcomeReceipt"
              },
              {
                "properties": {
                  "action_type": {
                    "const": "run_verifier"
                  },
                  "status": {
                    "const": "succeeded"
                  }
                }
              }
            ]
          }
        },
        "promotion_codes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/text"
          }
        },
        "action_cost": {
          "$ref": "#/$defs/nonNegativeNumber"
        }
      }
    },
    "limitations": {
      "type": "array",
      "prefixItems": [
        {
          "const": "Provider outputs remain observations until explicit semantic promotion and deterministic state-transition verification succeed."
        },
        {
          "const": "Refresh runs are bounded reviewer-verifier transformations; providers cannot directly issue clinical decisions or rewrite committed artifacts."
        },
        {
          "const": "Resolved gaps are policy-relative evidence-workflow transitions, not treatment, regulatory, or clinical acceptability conclusions."
        },
        {
          "const": "Attempted catalog action identifiers are single-use in this transition; a retry requires an explicitly revised catalog action."
        },
        {
          "const": "ADVANCE remains evidence-workflow readiness only and never constitutes a terminal development or patient-care recommendation."
        }
      ],
      "items": false,
      "minItems": 5,
      "maxItems": 5
    },
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "transition_id",
        "method_id",
        "program_id",
        "as_of_date",
        "before_state_version",
        "after_state_version",
        "closed_loop_policy",
        "execution_batch",
        "before_package",
        "selected_action_receipts",
        "refresh_receipts",
        "after_package",
        "accepted_packet_ids",
        "consumed_action_ids",
        "remaining_action_ids",
        "resolved_gap_codes",
        "persisted_gap_codes",
        "new_gap_codes",
        "added_source_content_hashes",
        "removed_source_content_hashes",
        "acquisition_cost",
        "refresh_cost",
        "total_cost",
        "budget_spent_before",
        "budget_spent_after",
        "before_decision",
        "after_decision",
        "workflow_scope",
        "clinical_acceptability_inferred",
        "terminal_decision_issued",
        "limitations"
      ],
      "properties": {
        "transition_id": {
          "$ref": "#/$defs/text"
        },
        "method_id": {
          "const": "adds.provenance-preserving-clinical-closed-loop.v1"
        },
        "program_id": {
          "$ref": "#/$defs/text"
        },
        "as_of_date": {
          "$ref": "#/$defs/date"
        },
        "before_state_version": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "after_state_version": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "closed_loop_policy": {
          "$ref": "#/$defs/closedLoopPolicy"
        },
        "execution_batch": {
          "$ref": "#/$defs/executionBatch"
        },
        "before_package": {
          "$ref": "clinical_evidence_decision_package.schema.json#/$defs/package"
        },
        "selected_action_receipts": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/selectedActionReceipt"
          }
        },
        "refresh_receipts": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/refreshRunReceipt"
          }
        },
        "after_package": {
          "$ref": "clinical_evidence_decision_package.schema.json#/$defs/package"
        },
        "accepted_packet_ids": {
          "allOf": [
            {
              "$ref": "#/$defs/textArray"
            },
            {
              "minItems": 1
            }
          ]
        },
        "consumed_action_ids": {
          "allOf": [
            {
              "$ref": "#/$defs/textArray"
            },
            {
              "minItems": 1
            }
          ]
        },
        "remaining_action_ids": {
          "$ref": "#/$defs/textArray"
        },
        "resolved_gap_codes": {
          "$ref": "#/$defs/gapCodeArray"
        },
        "persisted_gap_codes": {
          "$ref": "#/$defs/gapCodeArray"
        },
        "new_gap_codes": {
          "$ref": "#/$defs/gapCodeArray"
        },
        "added_source_content_hashes": {
          "$ref": "#/$defs/hashArray"
        },
        "removed_source_content_hashes": {
          "$ref": "#/$defs/hashArray"
        },
        "acquisition_cost": {
          "$ref": "#/$defs/nonNegativeNumber"
        },
        "refresh_cost": {
          "$ref": "#/$defs/nonNegativeNumber"
        },
        "total_cost": {
          "$ref": "#/$defs/nonNegativeNumber"
        },
        "budget_spent_before": {
          "$ref": "#/$defs/nonNegativeNumber"
        },
        "budget_spent_after": {
          "$ref": "#/$defs/nonNegativeNumber"
        },
        "before_decision": {
          "$ref": "#/$defs/decision"
        },
        "after_decision": {
          "$ref": "#/$defs/decision"
        },
        "workflow_scope": {
          "const": "evidence_workflow_only"
        },
        "clinical_acceptability_inferred": {
          "const": false
        },
        "terminal_decision_issued": {
          "const": false
        },
        "limitations": {
          "$ref": "#/$defs/limitations"
        }
      }
    }
  }
}

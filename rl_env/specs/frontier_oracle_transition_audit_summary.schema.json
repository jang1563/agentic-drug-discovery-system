{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jihunni/Agentic-Drug-Discovery-System/blob/main/rl_env/specs/frontier_oracle_transition_audit_summary.schema.json",
  "title": "ADDS-Frontier payload-free oracle transition audit summary",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "audit_id", "protocol_id", "board_id", "status", "compiled_on", "public_preflight_integrity_sha256", "public_fragility_summary_integrity_sha256", "public_support_curation_summary_integrity_sha256", "private_report_commitment", "transition_classification_rule", "causal_review_trigger", "task_count", "canonical_transition_count", "action_changed_transition_count", "witness_changed_transition_count", "blocker_changed_transition_count", "accessible_evidence_changed_transition_count", "required_gate_set_changed_transition_count", "as_of_date_changed_transition_count", "new_accessible_evidence_item_count", "removed_accessible_evidence_item_count", "action_and_witness_changed_transition_count", "action_changed_without_witness_delta_count", "witness_changed_without_action_delta_count", "action_and_witness_stable_transition_count", "action_changed_with_access_delta_count", "action_changed_without_access_delta_count", "access_delta_without_action_change_count", "witness_access_delta_alignment_pass_count", "blocker_action_delta_alignment_pass_count", "disposition_changed_transition_count", "next_action_changed_transition_count", "risk_flags_changed_transition_count", "canonical_transition_coupling_coverage_ready", "evidence_action_coupling_review_required", "human_transition_review_required", "scientific_causality_established", "oracle_revision_applied", "oracle_support_ready_for_independent_challenge", "challenge_assignment_authorized", "expert_solve_gate_changed", "admission_gate_changed", "board_admitted_count", "baseline_model_runs_started", "benchmark_evidence_claimed", "private_payload_published", "nonclaims", "integrity_sha256"],
  "properties": {
    "schema_version": {"const": "adds.frontier-oracle-transition-audit-summary.v1"},
    "audit_id": {"const": "adds-frontier-oracle-transition-audit-v1"},
    "protocol_id": {"const": "adds-frontier-v1"},
    "board_id": {"const": "adds-frontier-private-pilot-v1"},
    "status": {"enum": ["machine_audit_complete_coupling_coverage_observed", "machine_audit_complete_causal_discriminability_review_required"]},
    "compiled_on": {"type": "string", "format": "date"},
    "public_preflight_integrity_sha256": {"$ref": "#/$defs/sha256"},
    "public_fragility_summary_integrity_sha256": {"$ref": "#/$defs/sha256"},
    "public_support_curation_summary_integrity_sha256": {"$ref": "#/$defs/sha256"},
    "private_report_commitment": {"$ref": "#/$defs/sha256"},
    "transition_classification_rule": {"const": "classify_exact_action_and_witness_set_deltas_between_adjacent_canonical_stages"},
    "causal_review_trigger": {"const": "action_and_access_deltas_exist_but_no_transition_contains_both"},
    "task_count": {"const": 10},
    "canonical_transition_count": {"const": 50},
    "action_changed_transition_count": {"$ref": "#/$defs/transition_count"},
    "witness_changed_transition_count": {"$ref": "#/$defs/transition_count"},
    "blocker_changed_transition_count": {"$ref": "#/$defs/transition_count"},
    "accessible_evidence_changed_transition_count": {"$ref": "#/$defs/transition_count"},
    "required_gate_set_changed_transition_count": {"$ref": "#/$defs/transition_count"},
    "as_of_date_changed_transition_count": {"$ref": "#/$defs/transition_count"},
    "new_accessible_evidence_item_count": {"type": "integer", "minimum": 0},
    "removed_accessible_evidence_item_count": {"type": "integer", "minimum": 0},
    "action_and_witness_changed_transition_count": {"$ref": "#/$defs/transition_count"},
    "action_changed_without_witness_delta_count": {"$ref": "#/$defs/transition_count"},
    "witness_changed_without_action_delta_count": {"$ref": "#/$defs/transition_count"},
    "action_and_witness_stable_transition_count": {"$ref": "#/$defs/transition_count"},
    "action_changed_with_access_delta_count": {"$ref": "#/$defs/transition_count"},
    "action_changed_without_access_delta_count": {"$ref": "#/$defs/transition_count"},
    "access_delta_without_action_change_count": {"$ref": "#/$defs/transition_count"},
    "witness_access_delta_alignment_pass_count": {"$ref": "#/$defs/transition_count"},
    "blocker_action_delta_alignment_pass_count": {"$ref": "#/$defs/transition_count"},
    "disposition_changed_transition_count": {"$ref": "#/$defs/transition_count"},
    "next_action_changed_transition_count": {"$ref": "#/$defs/transition_count"},
    "risk_flags_changed_transition_count": {"$ref": "#/$defs/transition_count"},
    "canonical_transition_coupling_coverage_ready": {"type": "boolean"},
    "evidence_action_coupling_review_required": {"type": "boolean"},
    "human_transition_review_required": {"const": true},
    "scientific_causality_established": {"const": false},
    "oracle_revision_applied": {"const": false},
    "oracle_support_ready_for_independent_challenge": {"const": false},
    "challenge_assignment_authorized": {"const": false},
    "expert_solve_gate_changed": {"const": false},
    "admission_gate_changed": {"const": false},
    "board_admitted_count": {"const": 0},
    "baseline_model_runs_started": {"const": false},
    "benchmark_evidence_claimed": {"const": false},
    "private_payload_published": {"const": false},
    "nonclaims": {"type": "array", "minItems": 6, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "integrity_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "transition_count": {"type": "integer", "minimum": 0, "maximum": 50}
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jihunni/Agentic-Drug-Discovery-System/blob/main/rl_env/specs/frontier_private_oracle_challenge_key_set.schema.json",
  "title": "ADDS-Frontier private independent-oracle challenge key set",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "set_id", "protocol_id", "board_id", "compiled_on", "packet_set_integrity_sha256", "task_set_integrity_sha256", "oracle_set_integrity_sha256", "author_oracle_reveal_rule", "keys", "integrity_sha256"],
  "properties": {
    "schema_version": {"const": "adds.frontier-private-oracle-challenge-key-set.v1"},
    "set_id": {"const": "adds-frontier-independent-oracle-challenge-v1"},
    "protocol_id": {"const": "adds-frontier-v1"},
    "board_id": {"const": "adds-frontier-private-pilot-v1"},
    "compiled_on": {"type": "string", "format": "date"},
    "packet_set_integrity_sha256": {"$ref": "#/$defs/sha256"},
    "task_set_integrity_sha256": {"$ref": "#/$defs/sha256"},
    "oracle_set_integrity_sha256": {"$ref": "#/$defs/sha256"},
    "author_oracle_reveal_rule": {"const": "open_author_oracle_only_after_two_valid_independent_responses"},
    "keys": {"type": "array", "minItems": 10, "maxItems": 10, "items": {"$ref": "#/$defs/key"}},
    "integrity_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "nonempty": {"type": "string", "minLength": 1},
    "key": {
      "type": "object",
      "additionalProperties": false,
      "required": ["packet_id", "slot_id", "task_id", "canonical_task_commitment", "author_oracle_commitment"],
      "properties": {
        "packet_id": {"type": "string", "pattern": "^oracle-challenge-[0-9a-f]{20}$"},
        "slot_id": {"type": "string", "pattern": "^slot-[a-z]+-[0-9]{2}$"},
        "task_id": {"$ref": "#/$defs/nonempty"},
        "canonical_task_commitment": {"$ref": "#/$defs/sha256"},
        "author_oracle_commitment": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}

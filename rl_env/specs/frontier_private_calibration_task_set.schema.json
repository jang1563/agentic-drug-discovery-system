{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jihunni/Agentic-Drug-Discovery-System/blob/main/rl_env/specs/frontier_private_calibration_task_set.schema.json",
  "title": "ADDS-Frontier private calibration task set",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "protocol_id",
    "board_id",
    "set_id",
    "set_role",
    "authoring_status",
    "task_selection_blinded_to_models",
    "baseline_model_runs_started",
    "benchmark_evidence_claimed",
    "tasks",
    "integrity_sha256"
  ],
  "properties": {
    "schema_version": {"const": "adds.frontier-private-calibration-task-set.v1"},
    "protocol_id": {"const": "adds-frontier-v1"},
    "board_id": {"const": "adds-frontier-private-pilot-v1"},
    "set_id": {"const": "adds-frontier-private-calibration-v1"},
    "set_role": {"const": "private_calibration_authoring"},
    "authoring_status": {"const": "authored_pending_review"},
    "task_selection_blinded_to_models": {"const": true},
    "baseline_model_runs_started": {"const": false},
    "benchmark_evidence_claimed": {"const": false},
    "tasks": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": {"$ref": "#/$defs/task"}
    },
    "integrity_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "nonempty": {"type": "string", "minLength": 1},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_path", "artifact_sha256", "source_role", "model_visible"],
      "properties": {
        "artifact_path": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*\\.\\.).+$"},
        "artifact_sha256": {"$ref": "#/$defs/sha256"},
        "source_role": {"enum": ["authoring_context", "source_index", "verification_record"]},
        "model_visible": {"const": false}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_id", "available_on", "lineage_id", "evidence_role", "evidence_summary"],
      "properties": {
        "evidence_id": {"$ref": "#/$defs/nonempty"},
        "available_on": {"type": "string", "format": "date"},
        "lineage_id": {"$ref": "#/$defs/nonempty"},
        "evidence_role": {"enum": ["source", "context", "contradiction", "derivative", "decision_record"]},
        "evidence_summary": {"$ref": "#/$defs/nonempty"}
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["parent_evidence_id", "child_evidence_id", "relationship"],
      "properties": {
        "parent_evidence_id": {"$ref": "#/$defs/nonempty"},
        "child_evidence_id": {"$ref": "#/$defs/nonempty"},
        "relationship": {"enum": ["derives_from", "corroborates", "supersedes", "conflicts_with"]}
      }
    },
    "stage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stage_id", "stage_kind", "as_of_date", "accessible_evidence_ids", "required_gates", "max_tool_calls"],
      "properties": {
        "stage_id": {"type": "string", "pattern": "^s[0-9]{2}$"},
        "stage_kind": {"enum": ["retrieve", "identity", "chronology", "lineage", "alignment", "synthesis", "action", "replay"]},
        "as_of_date": {"type": "string", "format": "date"},
        "accessible_evidence_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/nonempty"}},
        "required_gates": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "evidence_retrieval_complete",
              "identity_continuity",
              "cutoff_compliance",
              "lineage_independence",
              "endpoint_population_alignment",
              "uncertainty_handling",
              "disposition_correct",
              "next_action_correct",
              "risk_flags_correct",
              "witness_valid",
              "blocker_certificate_valid",
              "budget_compliance",
              "exact_replay"
            ]
          }
        },
        "max_tool_calls": {"type": "integer", "minimum": 1}
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slot_id",
        "task_id",
        "family_id",
        "disease_domain",
        "temporal_regime",
        "task_commitment_nonce",
        "disease_identity",
        "disease_identity_nonce",
        "program_identity",
        "program_identity_nonce",
        "prompt",
        "anchor_cutoff_date",
        "stage_budget",
        "tool_call_budget",
        "authoring_source_artifacts",
        "evidence_nodes",
        "lineage_edges",
        "stages",
        "nonclaim"
      ],
      "properties": {
        "slot_id": {"type": "string", "pattern": "^slot-[a-z]+-[0-9]{2}$"},
        "task_id": {"$ref": "#/$defs/nonempty"},
        "family_id": {"enum": ["evidence_lineage_trap", "temporal_reversal", "translational_handoff", "non_exchangeable_replication", "budgeted_evidence_resolution"]},
        "disease_domain": {"enum": ["hematology", "immune_inflammatory"]},
        "temporal_regime": {"enum": ["historical_pre_2024", "historical_2024_2025"]},
        "task_commitment_nonce": {"$ref": "#/$defs/sha256"},
        "disease_identity": {"$ref": "#/$defs/nonempty"},
        "disease_identity_nonce": {"$ref": "#/$defs/sha256"},
        "program_identity": {"$ref": "#/$defs/nonempty"},
        "program_identity_nonce": {"$ref": "#/$defs/sha256"},
        "prompt": {"$ref": "#/$defs/nonempty"},
        "anchor_cutoff_date": {"type": "string", "format": "date"},
        "stage_budget": {"type": "integer", "minimum": 6, "maximum": 12},
        "tool_call_budget": {"type": "integer", "minimum": 1},
        "authoring_source_artifacts": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"$ref": "#/$defs/source"}},
        "evidence_nodes": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/evidence"}},
        "lineage_edges": {"type": "array", "items": {"$ref": "#/$defs/edge"}},
        "stages": {"type": "array", "minItems": 6, "maxItems": 12, "items": {"$ref": "#/$defs/stage"}},
        "nonclaim": {"const": "This is an authored calibration draft pending independent review and board admission."}
      }
    }
  }
}

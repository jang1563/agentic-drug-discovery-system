{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jihunni/Agentic-Drug-Discovery-System/blob/main/rl_env/specs/frontier_private_oracle_transition_audit_report.schema.json",
  "title": "ADDS-Frontier private oracle transition audit report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "audit_id", "protocol_id", "board_id", "compiled_on", "task_set_integrity_sha256", "oracle_set_integrity_sha256", "private_preflight_integrity_sha256", "private_fragility_report_integrity_sha256", "private_support_curation_packet_set_integrity_sha256", "transition_classification_rule", "causal_review_trigger", "records", "task_count", "canonical_transition_count", "action_changed_transition_count", "witness_changed_transition_count", "blocker_changed_transition_count", "accessible_evidence_changed_transition_count", "required_gate_set_changed_transition_count", "as_of_date_changed_transition_count", "new_accessible_evidence_item_count", "removed_accessible_evidence_item_count", "action_and_witness_changed_transition_count", "action_changed_without_witness_delta_count", "witness_changed_without_action_delta_count", "action_and_witness_stable_transition_count", "action_changed_with_access_delta_count", "action_changed_without_access_delta_count", "access_delta_without_action_change_count", "witness_access_delta_alignment_pass_count", "blocker_action_delta_alignment_pass_count", "disposition_changed_transition_count", "next_action_changed_transition_count", "risk_flags_changed_transition_count", "canonical_transition_coupling_coverage_ready", "evidence_action_coupling_review_required", "scientific_causality_established", "oracle_revision_applied", "challenge_assignment_authorized", "expert_solve_gate_changed", "admission_gate_changed", "integrity_sha256"],
  "properties": {
    "schema_version": {"const": "adds.frontier-private-oracle-transition-audit-report.v1"},
    "audit_id": {"const": "adds-frontier-oracle-transition-audit-v1"},
    "protocol_id": {"const": "adds-frontier-v1"},
    "board_id": {"const": "adds-frontier-private-pilot-v1"},
    "compiled_on": {"type": "string", "format": "date"},
    "task_set_integrity_sha256": {"$ref": "#/$defs/sha256"},
    "oracle_set_integrity_sha256": {"$ref": "#/$defs/sha256"},
    "private_preflight_integrity_sha256": {"$ref": "#/$defs/sha256"},
    "private_fragility_report_integrity_sha256": {"$ref": "#/$defs/sha256"},
    "private_support_curation_packet_set_integrity_sha256": {"$ref": "#/$defs/sha256"},
    "transition_classification_rule": {"const": "classify_exact_action_and_witness_set_deltas_between_adjacent_canonical_stages"},
    "causal_review_trigger": {"const": "action_and_access_deltas_exist_but_no_transition_contains_both"},
    "records": {"type": "array", "minItems": 50, "maxItems": 50, "items": {"$ref": "#/$defs/record"}},
    "task_count": {"const": 10},
    "canonical_transition_count": {"const": 50},
    "action_changed_transition_count": {"$ref": "#/$defs/transition_count"},
    "witness_changed_transition_count": {"$ref": "#/$defs/transition_count"},
    "blocker_changed_transition_count": {"$ref": "#/$defs/transition_count"},
    "accessible_evidence_changed_transition_count": {"$ref": "#/$defs/transition_count"},
    "required_gate_set_changed_transition_count": {"$ref": "#/$defs/transition_count"},
    "as_of_date_changed_transition_count": {"$ref": "#/$defs/transition_count"},
    "new_accessible_evidence_item_count": {"type": "integer", "minimum": 0},
    "removed_accessible_evidence_item_count": {"type": "integer", "minimum": 0},
    "action_and_witness_changed_transition_count": {"$ref": "#/$defs/transition_count"},
    "action_changed_without_witness_delta_count": {"$ref": "#/$defs/transition_count"},
    "witness_changed_without_action_delta_count": {"$ref": "#/$defs/transition_count"},
    "action_and_witness_stable_transition_count": {"$ref": "#/$defs/transition_count"},
    "action_changed_with_access_delta_count": {"$ref": "#/$defs/transition_count"},
    "action_changed_without_access_delta_count": {"$ref": "#/$defs/transition_count"},
    "access_delta_without_action_change_count": {"$ref": "#/$defs/transition_count"},
    "witness_access_delta_alignment_pass_count": {"$ref": "#/$defs/transition_count"},
    "blocker_action_delta_alignment_pass_count": {"$ref": "#/$defs/transition_count"},
    "disposition_changed_transition_count": {"$ref": "#/$defs/transition_count"},
    "next_action_changed_transition_count": {"$ref": "#/$defs/transition_count"},
    "risk_flags_changed_transition_count": {"$ref": "#/$defs/transition_count"},
    "canonical_transition_coupling_coverage_ready": {"type": "boolean"},
    "evidence_action_coupling_review_required": {"type": "boolean"},
    "scientific_causality_established": {"const": false},
    "oracle_revision_applied": {"const": false},
    "challenge_assignment_authorized": {"const": false},
    "expert_solve_gate_changed": {"const": false},
    "admission_gate_changed": {"const": false},
    "integrity_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "nonempty": {"type": "string", "minLength": 1},
    "transition_count": {"type": "integer", "minimum": 0, "maximum": 50},
    "string_set": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/nonempty"}},
    "nonempty_string_set": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/nonempty"}},
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["disposition", "next_action", "risk_flags"],
      "properties": {
        "disposition": {"enum": ["advance", "hold", "terminate"]},
        "next_action": {"enum": ["retrieve", "verify", "experiment", "human_review", "none"]},
        "risk_flags": {"type": "array", "uniqueItems": true, "items": {"enum": ["safety", "contradiction", "provenance", "out_of_distribution", "temporal_leakage"]}}
      }
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slot_id", "task_id", "canonical_task_commitment", "author_oracle_commitment", "transition_id", "from_stage_id", "to_stage_id", "from_stage_kind", "to_stage_kind", "from_as_of_date", "to_as_of_date", "previous_accessible_evidence_ids", "current_accessible_evidence_ids", "accessible_evidence_ids_added", "accessible_evidence_ids_removed", "previous_required_gates", "current_required_gates", "required_gates_added", "required_gates_removed", "previous_action", "current_action", "changed_action_components", "previous_witness_evidence_ids", "current_witness_evidence_ids", "witness_evidence_ids_added", "witness_evidence_ids_removed", "previous_blocker_codes", "current_blocker_codes", "blocker_codes_added", "blocker_codes_removed", "transition_class", "action_changed", "witness_changed", "blocker_changed", "accessible_evidence_changed", "required_gate_set_changed", "as_of_date_changed", "witness_access_delta_aligned", "blocker_action_delta_aligned", "scientific_consistency_established", "causal_explanation_established", "automatic_oracle_edit_authorized"],
      "properties": {
        "slot_id": {"type": "string", "pattern": "^slot-[a-z]+-[0-9]{2}$"},
        "task_id": {"$ref": "#/$defs/nonempty"},
        "canonical_task_commitment": {"$ref": "#/$defs/sha256"},
        "author_oracle_commitment": {"$ref": "#/$defs/sha256"},
        "transition_id": {"type": "string", "pattern": "^s[0-9]{2}->s[0-9]{2}$"},
        "from_stage_id": {"type": "string", "pattern": "^s[0-9]{2}$"},
        "to_stage_id": {"type": "string", "pattern": "^s[0-9]{2}$"},
        "from_stage_kind": {"enum": ["retrieve", "identity", "chronology", "lineage", "alignment", "synthesis", "action", "replay"]},
        "to_stage_kind": {"enum": ["retrieve", "identity", "chronology", "lineage", "alignment", "synthesis", "action", "replay"]},
        "from_as_of_date": {"type": "string", "format": "date"},
        "to_as_of_date": {"type": "string", "format": "date"},
        "previous_accessible_evidence_ids": {"$ref": "#/$defs/nonempty_string_set"},
        "current_accessible_evidence_ids": {"$ref": "#/$defs/nonempty_string_set"},
        "accessible_evidence_ids_added": {"$ref": "#/$defs/string_set"},
        "accessible_evidence_ids_removed": {"$ref": "#/$defs/string_set"},
        "previous_required_gates": {"$ref": "#/$defs/nonempty_string_set"},
        "current_required_gates": {"$ref": "#/$defs/nonempty_string_set"},
        "required_gates_added": {"$ref": "#/$defs/string_set"},
        "required_gates_removed": {"$ref": "#/$defs/string_set"},
        "previous_action": {"$ref": "#/$defs/action"},
        "current_action": {"$ref": "#/$defs/action"},
        "changed_action_components": {"type": "array", "uniqueItems": true, "items": {"enum": ["disposition", "next_action", "risk_flags"]}},
        "previous_witness_evidence_ids": {"$ref": "#/$defs/nonempty_string_set"},
        "current_witness_evidence_ids": {"$ref": "#/$defs/nonempty_string_set"},
        "witness_evidence_ids_added": {"$ref": "#/$defs/string_set"},
        "witness_evidence_ids_removed": {"$ref": "#/$defs/string_set"},
        "previous_blocker_codes": {"$ref": "#/$defs/nonempty_string_set"},
        "current_blocker_codes": {"$ref": "#/$defs/nonempty_string_set"},
        "blocker_codes_added": {"$ref": "#/$defs/string_set"},
        "blocker_codes_removed": {"$ref": "#/$defs/string_set"},
        "transition_class": {"enum": ["action_and_witness_changed", "action_changed_without_witness_delta", "witness_changed_without_action_delta", "action_and_witness_stable"]},
        "action_changed": {"type": "boolean"},
        "witness_changed": {"type": "boolean"},
        "blocker_changed": {"type": "boolean"},
        "accessible_evidence_changed": {"type": "boolean"},
        "required_gate_set_changed": {"type": "boolean"},
        "as_of_date_changed": {"type": "boolean"},
        "witness_access_delta_aligned": {"type": "boolean"},
        "blocker_action_delta_aligned": {"type": "boolean"},
        "scientific_consistency_established": {"const": false},
        "causal_explanation_established": {"const": false},
        "automatic_oracle_edit_authorized": {"const": false}
      },
      "allOf": [
        {"if": {"properties": {"transition_class": {"const": "action_and_witness_changed"}}}, "then": {"properties": {"action_changed": {"const": true}, "witness_changed": {"const": true}}}},
        {"if": {"properties": {"transition_class": {"const": "action_changed_without_witness_delta"}}}, "then": {"properties": {"action_changed": {"const": true}, "witness_changed": {"const": false}}}},
        {"if": {"properties": {"transition_class": {"const": "witness_changed_without_action_delta"}}}, "then": {"properties": {"action_changed": {"const": false}, "witness_changed": {"const": true}}}},
        {"if": {"properties": {"transition_class": {"const": "action_and_witness_stable"}}}, "then": {"properties": {"action_changed": {"const": false}, "witness_changed": {"const": false}}}}
      ]
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jihunni/Agentic-Drug-Discovery-System/blob/main/rl_env/specs/frontier_private_oracle_challenge_comparison.schema.json",
  "title": "ADDS-Frontier private challenger-oracle comparison",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "packet_id", "packet_set_integrity_sha256", "response_count", "response_commitments", "route", "challenger_disagreement_components", "author_oracle_disagreement_components", "component_match_count", "component_total", "author_oracle_opened", "opened_key_set_integrity_sha256", "opened_author_oracle_commitment", "oracle_convergence_candidate_commitment", "human_adjudication_required", "human_admission_review_required", "scientific_correctness_established", "shared_expert_error_excluded", "expert_solve_gate_changed", "admission_gate_changed", "board_gate_changed", "integrity_sha256"],
  "properties": {
    "schema_version": {"const": "adds.frontier-private-oracle-challenge-comparison.v1"},
    "packet_id": {"type": "string", "pattern": "^oracle-challenge-[0-9a-f]{20}$"},
    "packet_set_integrity_sha256": {"$ref": "#/$defs/sha256"},
    "response_count": {"type": "integer", "minimum": 0, "maximum": 2},
    "response_commitments": {"type": "array", "maxItems": 2, "uniqueItems": true, "items": {"$ref": "#/$defs/sha256"}},
    "route": {"enum": ["awaiting_challengers", "adjudication_required_challenger_abstention", "adjudication_required_challenger_disagreement", "adjudication_required_author_oracle_disagreement", "oracle_convergence_candidate"]},
    "challenger_disagreement_components": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^s[0-9]{2}\\.(disposition|next_action|risk_flags|witness|blockers|abstained)$"}},
    "author_oracle_disagreement_components": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^s[0-9]{2}\\.(disposition|next_action|risk_flags|witness|blockers)$"}},
    "component_match_count": {"type": ["integer", "null"], "minimum": 0, "maximum": 30},
    "component_total": {"enum": [30, null]},
    "author_oracle_opened": {"type": "boolean"},
    "opened_key_set_integrity_sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
    "opened_author_oracle_commitment": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
    "oracle_convergence_candidate_commitment": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
    "human_adjudication_required": {"type": "boolean"},
    "human_admission_review_required": {"const": true},
    "scientific_correctness_established": {"const": false},
    "shared_expert_error_excluded": {"const": false},
    "expert_solve_gate_changed": {"const": false},
    "admission_gate_changed": {"const": false},
    "board_gate_changed": {"const": false},
    "integrity_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}

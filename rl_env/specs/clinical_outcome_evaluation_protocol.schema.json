{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jang1563/agentic-drug-discovery-system/rl_env/specs/clinical_outcome_evaluation_protocol.schema.json",
  "title": "Preregistered clinical outcome evaluation protocol envelope",
  "description": "Public, integrity-bound protocol fixing cohort, cutoff, outcome, harmonization, curation, and metric semantics before outcome access.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "integrity_sha256", "protocol"],
  "properties": {
    "schema_version": {"const": "adds.clinical-outcome-evaluation-protocol.v1"},
    "integrity_sha256": {"$ref": "#/$defs/sha256"},
    "protocol": {"$ref": "#/$defs/protocol"}
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "date": {"type": "string", "format": "date"},
    "probability": {"type": "number", "minimum": 0, "maximum": 1},
    "protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol_id",
        "version",
        "registered_on",
        "cohort_id",
        "cohort_specification_sha256",
        "cohort_report_fingerprint",
        "prediction_deadline",
        "outcome_window_start",
        "outcome_window_end",
        "endpoint_harmonization_policy_sha256",
        "safety_harmonization_policy_sha256",
        "outcome_definition_sha256",
        "label_guidance_sha256",
        "exclusion_rules_sha256",
        "curator_roster_commitment",
        "minimum_independent_curators",
        "minimum_evaluable_units",
        "classification_threshold",
        "calibration_bin_edges",
        "confidence_level",
        "prediction_target",
        "composite_rule_id",
        "interval_method",
        "policy_blinding_required",
        "conflict_free_required",
        "adjudicator_independence_required",
        "metadata"
      ],
      "properties": {
        "protocol_id": {"$ref": "#/$defs/text"},
        "version": {"$ref": "#/$defs/text"},
        "registered_on": {"$ref": "#/$defs/date"},
        "cohort_id": {"$ref": "#/$defs/text"},
        "cohort_specification_sha256": {"$ref": "#/$defs/sha256"},
        "cohort_report_fingerprint": {"$ref": "#/$defs/sha256"},
        "prediction_deadline": {"$ref": "#/$defs/date"},
        "outcome_window_start": {"$ref": "#/$defs/date"},
        "outcome_window_end": {"$ref": "#/$defs/date"},
        "endpoint_harmonization_policy_sha256": {"$ref": "#/$defs/sha256"},
        "safety_harmonization_policy_sha256": {"$ref": "#/$defs/sha256"},
        "outcome_definition_sha256": {"$ref": "#/$defs/sha256"},
        "label_guidance_sha256": {"$ref": "#/$defs/sha256"},
        "exclusion_rules_sha256": {"$ref": "#/$defs/sha256"},
        "curator_roster_commitment": {"$ref": "#/$defs/sha256"},
        "minimum_independent_curators": {"type": "integer", "minimum": 2},
        "minimum_evaluable_units": {"type": "integer", "minimum": 1},
        "classification_threshold": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1},
        "calibration_bin_edges": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/probability"}
        },
        "confidence_level": {"type": "number", "exclusiveMinimum": 0.5, "exclusiveMaximum": 1},
        "prediction_target": {"const": "probability_of_favorable_composite_benefit_risk_outcome"},
        "composite_rule_id": {"const": "unfavorable_if_either_domain_unfavorable_otherwise_both_favorable.v1"},
        "interval_method": {"const": "wilson_score"},
        "policy_blinding_required": {"const": true},
        "conflict_free_required": {"const": true},
        "adjudicator_independence_required": {"const": true},
        "metadata": {"type": "object"}
      }
    }
  }
}

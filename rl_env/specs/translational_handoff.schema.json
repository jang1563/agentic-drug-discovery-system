{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schemas/adds/translational_handoff.schema.json",
  "title": "Translational Perturbation Handoff",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "handoff_id",
    "payload_class",
    "handoff_status",
    "created_on",
    "program",
    "perturbation",
    "biological_context",
    "sources",
    "observations",
    "review",
    "decision_boundary",
    "integrity_sha256"
  ],
  "properties": {
    "schema_version": {"const": "adds.translational-handoff.v1"},
    "handoff_id": {"$ref": "#/$defs/safeId"},
    "payload_class": {"enum": ["synthetic_fixture", "approved_nonsensitive"]},
    "handoff_status": {"const": "reviewed_contextual_input"},
    "created_on": {"type": "string", "format": "date"},
    "program": {"$ref": "#/$defs/program"},
    "perturbation": {"$ref": "#/$defs/perturbation"},
    "biological_context": {"$ref": "#/$defs/biologicalContext"},
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/source"}
    },
    "observations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {"$ref": "#/$defs/observation"}
    },
    "review": {"$ref": "#/$defs/review"},
    "decision_boundary": {"$ref": "#/$defs/decisionBoundary"},
    "integrity_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "safeId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,191}$"
    },
    "nonemptyText": {
      "type": "string",
      "minLength": 1,
      "pattern": "^\\S(?:.*\\S)?$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "uniqueTextArray": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/nonemptyText"}
    },
    "program": {
      "type": "object",
      "additionalProperties": false,
      "required": ["program_id", "hypothesis_id", "disease_id", "disease_name", "target_id", "target_name"],
      "properties": {
        "program_id": {"$ref": "#/$defs/safeId"},
        "hypothesis_id": {"$ref": "#/$defs/safeId"},
        "disease_id": {"$ref": "#/$defs/safeId"},
        "disease_name": {"$ref": "#/$defs/nonemptyText"},
        "target_id": {"$ref": "#/$defs/safeId"},
        "target_name": {"$ref": "#/$defs/nonemptyText"}
      }
    },
    "quantity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "unit"],
      "properties": {
        "value": {"type": ["number", "null"], "minimum": 0},
        "unit": {"anyOf": [{"$ref": "#/$defs/nonemptyText"}, {"type": "null"}]}
      }
    },
    "perturbation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["perturbation_id", "perturbation_type", "entity_id", "entity_namespace", "entity_name", "direction", "modality", "dose", "duration"],
      "properties": {
        "perturbation_id": {"$ref": "#/$defs/safeId"},
        "perturbation_type": {"enum": ["genetic", "chemical", "biologic", "physical", "other"]},
        "entity_id": {"$ref": "#/$defs/safeId"},
        "entity_namespace": {"$ref": "#/$defs/nonemptyText"},
        "entity_name": {"$ref": "#/$defs/nonemptyText"},
        "direction": {"enum": ["activate", "increase", "inhibit", "decrease", "knockout", "knockdown", "replace", "other"]},
        "modality": {"$ref": "#/$defs/nonemptyText"},
        "dose": {"$ref": "#/$defs/quantity"},
        "duration": {"$ref": "#/$defs/quantity"}
      }
    },
    "biologicalContext": {
      "type": "object",
      "additionalProperties": false,
      "required": ["species_taxon_id", "species_name", "disease_context_id", "tissue_id", "tissue_name", "cell_type_id", "cell_type_name", "model_system_id", "model_system_name", "model_system_type"],
      "properties": {
        "species_taxon_id": {"type": "string", "pattern": "^[1-9][0-9]*$"},
        "species_name": {"$ref": "#/$defs/nonemptyText"},
        "disease_context_id": {"$ref": "#/$defs/safeId"},
        "tissue_id": {"$ref": "#/$defs/safeId"},
        "tissue_name": {"$ref": "#/$defs/nonemptyText"},
        "cell_type_id": {"$ref": "#/$defs/safeId"},
        "cell_type_name": {"$ref": "#/$defs/nonemptyText"},
        "model_system_id": {"$ref": "#/$defs/safeId"},
        "model_system_name": {"$ref": "#/$defs/nonemptyText"},
        "model_system_type": {"$ref": "#/$defs/nonemptyText"}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "source_version", "locator", "content_sha256", "observed_on", "available_on", "lineage_ids"],
      "properties": {
        "source_id": {"$ref": "#/$defs/safeId"},
        "source_version": {"$ref": "#/$defs/nonemptyText"},
        "locator": {"type": "string", "pattern": "^(https://|doi:|hf://).+"},
        "content_sha256": {"$ref": "#/$defs/sha256"},
        "observed_on": {"type": "string", "format": "date"},
        "available_on": {"type": "string", "format": "date"},
        "lineage_ids": {"allOf": [{"$ref": "#/$defs/uniqueTextArray"}, {"minItems": 1}]}
      }
    },
    "assay": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assay_id", "assay_name", "assay_type", "platform", "endpoint_id", "endpoint_name", "endpoint_unit"],
      "properties": {
        "assay_id": {"$ref": "#/$defs/safeId"},
        "assay_name": {"$ref": "#/$defs/nonemptyText"},
        "assay_type": {"$ref": "#/$defs/nonemptyText"},
        "platform": {"$ref": "#/$defs/nonemptyText"},
        "endpoint_id": {"$ref": "#/$defs/safeId"},
        "endpoint_name": {"$ref": "#/$defs/nonemptyText"},
        "endpoint_unit": {"$ref": "#/$defs/nonemptyText"}
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["effect_scale", "estimate", "lower_bound", "upper_bound", "confidence_level", "p_value", "effect_direction"],
      "properties": {
        "effect_scale": {"enum": ["difference", "standardized_difference", "log2_fold_change", "fold_change", "odds_ratio", "hazard_ratio", "correlation", "other"]},
        "estimate": {"type": "number"},
        "lower_bound": {"type": "number"},
        "upper_bound": {"type": "number"},
        "confidence_level": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1},
        "p_value": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "effect_direction": {"enum": ["increase", "decrease", "no_change", "uncertain"]}
      }
    },
    "sampling": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observation_count", "biological_replicates", "technical_replicates", "donor_count"],
      "properties": {
        "observation_count": {"type": "integer", "minimum": 1},
        "biological_replicates": {"type": "integer", "minimum": 1},
        "technical_replicates": {"type": "integer", "minimum": 1},
        "donor_count": {"type": ["integer", "null"], "minimum": 1}
      }
    },
    "qualityControl": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "checks", "limitations"],
      "properties": {
        "status": {"enum": ["pass", "partial", "fail", "not_assessed"]},
        "checks": {"allOf": [{"$ref": "#/$defs/uniqueTextArray"}, {"minItems": 1}]},
        "limitations": {"$ref": "#/$defs/uniqueTextArray"}
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observation_id", "source_id", "assay", "comparator", "result", "sampling", "quality_control", "interpretation_confidence"],
      "properties": {
        "observation_id": {"$ref": "#/$defs/safeId"},
        "source_id": {"$ref": "#/$defs/safeId"},
        "assay": {"$ref": "#/$defs/assay"},
        "comparator": {
          "type": "object",
          "additionalProperties": false,
          "required": ["comparator_id", "description"],
          "properties": {
            "comparator_id": {"$ref": "#/$defs/safeId"},
            "description": {"$ref": "#/$defs/nonemptyText"}
          }
        },
        "result": {"$ref": "#/$defs/result"},
        "sampling": {"$ref": "#/$defs/sampling"},
        "quality_control": {"$ref": "#/$defs/qualityControl"},
        "interpretation_confidence": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["review_status", "reviewed_on", "reviewer_role", "interpretation", "uncertainty_statement", "limitations", "conflicts", "independent_replication_source_ids"],
      "properties": {
        "review_status": {"const": "approved_contextual_use"},
        "reviewed_on": {"type": "string", "format": "date"},
        "reviewer_role": {"$ref": "#/$defs/nonemptyText"},
        "interpretation": {"$ref": "#/$defs/nonemptyText"},
        "uncertainty_statement": {"$ref": "#/$defs/nonemptyText"},
        "limitations": {"allOf": [{"$ref": "#/$defs/uniqueTextArray"}, {"minItems": 1}]},
        "conflicts": {"$ref": "#/$defs/uniqueTextArray"},
        "independent_replication_source_ids": {"$ref": "#/$defs/uniqueTextArray"}
      }
    },
    "decisionBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed_use", "requires_human_review_before_scientific_gate", "no_autonomous_wet_lab_execution", "no_treatment_recommendation", "no_affiliation_or_integration_claim", "prohibited_inferences"],
      "properties": {
        "allowed_use": {"const": "contextual_evidence_only"},
        "requires_human_review_before_scientific_gate": {"const": true},
        "no_autonomous_wet_lab_execution": {"const": true},
        "no_treatment_recommendation": {"const": true},
        "no_affiliation_or_integration_claim": {"const": true},
        "prohibited_inferences": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "uniqueItems": true,
          "items": {"enum": ["clinical_readiness", "mechanism_established", "safety_established", "therapeutic_efficacy", "treatment_recommendation"]}
        }
      }
    }
  }
}

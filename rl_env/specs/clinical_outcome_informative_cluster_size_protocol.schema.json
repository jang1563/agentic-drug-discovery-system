{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jang1563/agentic-drug-discovery-system/rl_env/specs/clinical_outcome_informative_cluster_size_protocol.schema.json",
  "title": "Clinical Outcome Informative Cluster Size Protocol",
  "description": "Preregistered known-truth comparison of unit-weighted and cluster-balanced pattern-mixture functionals.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "integrity_sha256", "protocol"],
  "properties": {
    "schema_version": {
      "const": "adds.clinical-outcome-informative-cluster-size-protocol.v1"
    },
    "integrity_sha256": {"$ref": "#/$defs/sha256"},
    "protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol_id",
        "version",
        "registered_on",
        "stress_protocol_fingerprint",
        "profiles",
        "methods",
        "log_imor_grid",
        "reference_log_imor",
        "confidence_level",
        "monte_carlo_confidence_level",
        "coverage_tolerance",
        "minimum_interval_yield",
        "maximum_absolute_bias",
        "minimum_production_clusters",
        "maximum_production_cluster_unit_fraction",
        "maximum_standard_error_calibration_deviation",
        "primary_metric",
        "direction_threshold",
        "method_id",
        "metadata"
      ],
      "properties": {
        "protocol_id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "registered_on": {"type": "string", "format": "date"},
        "stress_protocol_fingerprint": {"$ref": "#/$defs/sha256"},
        "profiles": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "items": {"$ref": "#/$defs/profile"}
        },
        "methods": {"$ref": "#/$defs/methodOrder"},
        "log_imor_grid": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "number", "minimum": -8.0, "maximum": 8.0}
        },
        "reference_log_imor": {
          "type": "number",
          "minimum": -8.0,
          "maximum": 8.0
        },
        "confidence_level": {"$ref": "#/$defs/confidence"},
        "monte_carlo_confidence_level": {"$ref": "#/$defs/confidence"},
        "coverage_tolerance": {
          "type": "number",
          "minimum": 0.0,
          "exclusiveMaximum": 1.0
        },
        "minimum_interval_yield": {
          "type": "number",
          "exclusiveMinimum": 0.0,
          "maximum": 1.0
        },
        "maximum_absolute_bias": {
          "type": "number",
          "exclusiveMinimum": 0.0,
          "maximum": 1.0
        },
        "minimum_production_clusters": {"type": "integer", "minimum": 3},
        "maximum_production_cluster_unit_fraction": {
          "type": "number",
          "exclusiveMinimum": 0.0,
          "exclusiveMaximum": 1.0
        },
        "maximum_standard_error_calibration_deviation": {
          "type": "number",
          "exclusiveMinimum": 0.0,
          "maximum": 1.0
        },
        "primary_metric": {"const": "observed_favorable_rate"},
        "direction_threshold": {"$ref": "#/$defs/probability"},
        "method_id": {
          "const": "adds.pattern-mixture.informative-cluster-size-estimands.v1"
        },
        "metadata": {"type": "object"}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "probability": {"type": "number", "minimum": 0.0, "maximum": 1.0},
    "confidence": {
      "type": "number",
      "exclusiveMinimum": 0.5,
      "exclusiveMaximum": 1.0
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scenario_id", "block_favorable_prevalences"],
      "properties": {
        "scenario_id": {"type": "string", "minLength": 1},
        "block_favorable_prevalences": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "number",
            "exclusiveMinimum": 0.0,
            "exclusiveMaximum": 1.0
          }
        }
      }
    },
    "methodOrder": {
      "const": [
        "unit_weighted_delete_one_student_t",
        "unit_weighted_delete_mj_student_t",
        "cluster_balanced_delete_one_student_t"
      ]
    }
  }
}

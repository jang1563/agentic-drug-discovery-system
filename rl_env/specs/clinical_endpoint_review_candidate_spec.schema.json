{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/adds/clinical_endpoint_review_candidate_spec.schema.json",
  "title": "ADDS Clinical Endpoint Review Candidate Spec",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "packet_id",
    "candidate_id",
    "intervention_id",
    "disease_id",
    "design_ids",
    "policy_id"
  ],
  "properties": {
    "schema_version": {
      "const": "adds.clinical-endpoint-review-candidate-spec.v1"
    },
    "packet_id": { "$ref": "#/$defs/text" },
    "candidate_id": { "$ref": "#/$defs/text" },
    "intervention_id": { "$ref": "#/$defs/text" },
    "disease_id": { "$ref": "#/$defs/text" },
    "design_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/text" }
    },
    "policy_id": {
      "const": "adds.provenance-bound-endpoint-review-candidates.v1"
    }
  },
  "$defs": {
    "text": {
      "type": "string",
      "minLength": 1,
      "pattern": ".*\\S.*"
    }
  }
}
